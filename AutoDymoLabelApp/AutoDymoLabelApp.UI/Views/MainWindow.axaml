<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoDymoLabelApp.UI.ViewModels"
        x:Class="AutoDymoLabelApp.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AutoDymoLabel"
        Width="720" Height="820"
        MinWidth="560" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="BorderOnly">

    <!-- Auto resize: MinWidth/MinHeight keep it usable on small screens; content-driven
         height (no fixed rows) means the window always fits its contents. -->

    <Panel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid RowDefinitions="Auto,*" Margin="16,40,16,16">
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,14" IsHitTestVisible="False">
                <TextBlock Text="AutoDymoLabel" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="© WaTh.dev — steek een toestel in en het label verschijnt vanzelf"
                           FontSize="13" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">

                    <!-- Status card: the one thing a noob needs -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="18" BoxShadow="0 3 10 0 #22000000">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Status}" FontSize="16" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8"
                                         CornerRadius="4" Background="{DynamicResource TrackBrush}"
                                         Foreground="{DynamicResource AccentBrush}"/>
                            <Grid ColumnDefinitions="*,*,*" Margin="0">
                                <Button Grid.Column="0" Classes="accent" Command="{Binding StartCommand}"
                                        Content="Start handmatig" ToolTip.Tip="Start het label-proces voor het geselecteerde toestel"/>
                                <Button Grid.Column="1" Command="{Binding RefreshDevicesCommand}" Content="Verversen"
                                        ToolTip.Tip="Zoek opnieuw naar verbonden toestellen"/>
                                <Button Grid.Column="2" Command="{Binding OpenLabelCommand}" Content="Open label"
                                        ToolTip.Tip="Open het laatst gegenereerde label in Dymo Label"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Device card -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Toestel" FontSize="15" FontWeight="Bold"/>
                            <ComboBox ItemsSource="{Binding Devices}"
                                       SelectedItem="{Binding SelectedDevice}"
                                       HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock IsVisible="{Binding HasIssues}" Text="Gevonden problemen" FontWeight="Bold" Margin="0,6,0,0"/>
                            <ItemsControl IsVisible="{Binding HasIssues}" ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardDeepBrush}" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                                            Background="{DynamicResource WarnBrush}"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" FontSize="12" FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Settings card -->
                    <Expander Header="Instellingen" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="18,10" IsExpanded="False">
                        <StackPanel Spacing="12" Margin="0,10,0,0">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                                <TextBlock Text="Thema" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"/>
                            </Grid>
                            <CheckBox Content="Start automatisch bij insteken" IsChecked="{Binding AutoDetectOnPlug}"
                                      ToolTip.Tip="Zodra een iPhone/iPad gedetecteerd wordt, draait het hele proces vanzelf"/>
                            <CheckBox Content="Activeer toestel automatisch (bypass)" IsChecked="{Binding AutoActivate}"/>
                            <CheckBox Content="Diagnostiek: panic-logs &amp; sensoren" IsChecked="{Binding RunDiagnostics}"
                                      ToolTip.Tip="Haalt crash-logs op en vertaalt fouten naar leesbare reparatie-tips"/>
                            <CheckBox Content="Batterijchecker: X op label bij &lt; 85%" IsChecked="{Binding Enable85PercentChecker}"/>
                            <CheckBox Content="Open editor vóór het label" IsChecked="{Binding OpenEditorBeforePrint}"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="0">
                                <TextBlock Text="Standaard kwaliteit" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding DefaultQuality}"/>
                                <TextBlock Grid.Column="2" Text="Standaard betaling" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="3" ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding DefaultPaymentMethod}"/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ScrollViewer>

    <!-- Quality popup: shown only when no default is configured -->
    <Panel IsVisible="{Binding IsQualityPopupVisible}" ZIndex="10">
        <Rectangle Fill="#80000000"/>
        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Width="340" Padding="24"
                VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 40 0 #66000000">
            <StackPanel Spacing="14">
                <TextBlock Text="Kies de kwaliteit van het toestel" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                <Button Classes="accent" Content="A — Zo goed als nieuw" Command="{Binding SetQualityCommand}" CommandParameter="A" Background="{DynamicResource SuccessBrush}" Height="46"/>
                <Button Classes="accent" Content="B — Licht gebruik" Command="{Binding SetQualityCommand}" CommandParameter="B" Background="{DynamicResource WarnBrush}" Height="46"/>
                <Button Classes="accent" Content="C — Zichtbare schade" Command="{Binding SetQualityCommand}" CommandParameter="C" Background="{DynamicResource DangerBrush}" Height="46"/>
            </StackPanel>
        </Border>
    </Panel>

    <!-- Payment popup: shown only when no default is configured -->
    <Panel IsVisible="{Binding IsPaymentPopupVisible}" ZIndex="10">
        <Rectangle Fill="#80000000"/>
        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Width="380" Padding="24"
                VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 40 0 #66000000">
            <StackPanel Spacing="14">
                <TextBlock Text="Betaalmethode op het label" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                <Button Classes="accent" Content="Marge (cash/kaart)" Command="{Binding SetPaymentMethodCommand}" CommandParameter="Marge" Height="46"/>
                <Button Classes="accent" Content="BTW (order/factuur)" Command="{Binding SetPaymentMethodCommand}" CommandParameter="BTW" Height="46"/>
            </StackPanel>
        </Border>
    </Panel>
    </Panel>
</Window>
