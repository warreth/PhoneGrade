<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoDymoLabelApp.UI.ViewModels"
        x:Class="AutoDymoLabelApp.UI.Views.DataEditorWindow"
        x:DataType="vm:DataEditorViewModel"
        Title="Gegevens bewerken"
        Width="560" MinWidth="480" MaxWidth="900"
        Height="720" MinHeight="560"
        SizeToContent="Height"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="BorderOnly">

    <!-- Scroll wheel fix: plain ScrollViewer with no nested layout that eats mouse
         wheel events, and controls that don't mark wheel input as handled. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Border Margin="16,40,16,16" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="24">
            <StackPanel Spacing="14">
                <TextBlock Text="Toestelgegevens" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="Identifier (IMEI/Serienummer)"/>
                    <TextBox Text="{Binding DeviceData.Identifier}"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Model"/>
                    <TextBox Text="{Binding DeviceData.Model}"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Kleur"/>
                    <TextBox Text="{Binding DeviceData.Color}"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Opslag"/>
                    <TextBox Text="{Binding DeviceData.Storage}"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Batterij"/>
                    <TextBox Text="{Binding DeviceData.BatteryHealth}"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Kwaliteit"/>
                    <TextBox Text="{Binding DeviceData.Quality}"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Betaalmethode"/>
                    <TextBox Text="{Binding DeviceData.PayMethod}"/>
                </StackPanel>

                <Button Classes="accent" Content="Opslaan &amp; label openen"
                        Command="{Binding SaveAndOpenLabelCommand}"
                        HorizontalAlignment="Stretch" Margin="0,10,0,0" Height="44"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
