<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoDymoLabelApp.UI.ViewModels"
        x:Class="AutoDymoLabelApp.UI.Views.DataEditorWindow"
        x:DataType="vm:DataEditorViewModel"
        Title="Gegevens bewerken"
        Width="580" Height="700"
        MinWidth="480" MinHeight="540"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Native chrome (close/min/max + resize work everywhere incl. Wayland). -->
    <!-- Scroll wheel fix: single flat ScrollViewer, no nested scroll containers. -->

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Border Classes="card" Margin="20" Padding="26">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4" Margin="0,0,0,6">
                    <TextBlock Text="Toestelgegevens" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Classes="dim" Text="Controleer en pas aan — dit gaat zo op het label" FontSize="12"/>
                </StackPanel>

                <!-- Field blocks reuse one implicit style: label above, input below -->
                <StackPanel Spacing="7">
                    <TextBlock Classes="dim" Text="Identifier (IMEI / serienummer)" FontSize="12" FontWeight="Medium"/>
                    <TextBox Text="{Binding DeviceData.Identifier}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="dim" Text="Model" FontSize="12" FontWeight="Medium"/>
                    <TextBox Text="{Binding DeviceData.Model}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="dim" Text="Kleur" FontSize="12" FontWeight="Medium"/>
                    <TextBox Text="{Binding DeviceData.Color}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="dim" Text="Opslag" FontSize="12" FontWeight="Medium"/>
                    <TextBox Text="{Binding DeviceData.Storage}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="dim" Text="Batterij" FontSize="12" FontWeight="Medium"/>
                    <TextBox Text="{Binding DeviceData.BatteryHealth}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="dim" Text="Kwaliteit" FontSize="12" FontWeight="Medium"/>
                    <TextBox Text="{Binding DeviceData.Quality}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="dim" Text="Betaalmethode" FontSize="12" FontWeight="Medium"/>
                    <TextBox Text="{Binding DeviceData.PayMethod}"/>
                </StackPanel>

                <Button Classes="cta" Content="Opslaan &amp; label openen"
                        Command="{Binding SaveAndOpenLabelCommand}"
                        HorizontalAlignment="Stretch" Margin="0,10,0,0" Height="46"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
