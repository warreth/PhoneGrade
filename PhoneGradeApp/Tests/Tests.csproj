<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- ProjectReference to a WinExe suppresses transitive package copy;
         force it so testhost can resolve Avalonia from this bin dir. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <!-- ScreenshotRunner.Main is the single entry point; the xUnit test classes
         run via the VSTest adapter without needing Main. -->
    <StartupObject>ScreenshotRunner</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PhoneGrade.Core/PhoneGrade.Core.csproj" />
    <ProjectReference Include="../PhoneGrade.UI/PhoneGrade.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.2.3" />
    <!-- Rasterises the label PDF so the tests can ask what is printed rather than
         what was written: the label once printed blank with every word still in
         the file, which no test on the bytes could see. Pinned to the 4.x line
         because Avalonia 11.2 binds SkiaSharp 2.88: a 5.x PDFtoImage raises the
         managed SkiaSharp to 3 while Avalonia keeps shipping the 2.88 native
         library, and the two halves then disagree on Linux and macOS. -->
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.TestPlatform.TestHost" Version="17.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
  </ItemGroup>

</Project>
