    <!-- What a failed export, a note on a written one, or a print says. Read at the
         moment something went wrong, so it comes from here rather than from the
         code that detected it. -->
    <x:String x:Key="Status_TemplateMissing">标签模板 {0} 不存在。请在设置中选择其他模板，或清空该设置以使用应用自带的模板。</x:String>
    <x:String x:Key="Status_TemplateUnreadable">无法读取位于 {0} 的标签模板：{1}</x:String>
    <x:String x:Key="Status_NoTemplateFound">未找到标签模板（{0}）。已查找以下位置：{1}</x:String>
    <x:String x:Key="Status_TemplateHasNoFields">标签模板中不包含本应用要填写的任何字段，因此所有标签都会输出相同内容。请重新打开应用自带的模板。</x:String>
    <x:String x:Key="Status_WriteFailed">写入 {0} 文件失败：{1}</x:String>
