    <!-- IMEI Check Labels (per check price) -->
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmiPrice">$0.360</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimplePrice">$0.200</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumPrice">$0.420</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxPrice">$0.600</x:String>

    <!-- IMEI check names and descriptions -->
    <x:String x:Key="Settings_SecImeiApi">IMEI API 配置</x:String>
    <x:String x:Key="Settings_ImeiInfoApiKeyWatermark">在此粘贴你的 API 密钥（例如 e0d7c26f-5cc7-5644-863c-8992083dfeac）</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmi">APPLE: Carrier &amp; Lock Status &amp; FMI</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmiDesc">$0.360 - 返回 Apple 设备的运营商名称、SIM 卡锁状态和 Find My iPhone（FMI）状态。</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimple">BLACKLIST: Simple Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimpleDesc">$0.200 - 仅返回黑名单基础状态（正常或已被列入黑名单）。</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremium">BLACKLIST: Premium Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumDesc">$0.420 - 返回详细信息：IMEI、型号名称、制造商、型号编号、列入黑名单的操作方、列入日期、列入原因、黑名单状态、列入黑名单的国家、通用名单状态。</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnox">GENERIC: Samsung Info Check &amp; Knox Info</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxDesc">$0.600 - 返回 Samsung 设备信息，包括型号、序列号、保修状态和 Knox 保修位状态。</x:String>

    <!-- Introduction screen: IMEI checks (BYOK) -->
    <x:String x:Key="Intro_ImeiTitle">IMEI 检测（自带密钥）</x:String>
    <x:String x:Key="Intro_ImeiBody">PhoneGrade 通过 imei.info 检测网络锁、FMI、黑名单和 Knox 状态。本功能采用自带密钥（BYOK）方式：在 imei.info 创建账号、充值，然后把自己的 API 密钥粘贴到设置中。每项检测单独计费（0.200 至 0.600 美元），你可以选择哪些检测自动执行。</x:String>
    <x:String x:Key="Intro_ImeiConfigureButton">在设置中配置 IMEI API</x:String>
    <x:String x:Key="Settings_ImeiInfoWatermarkDefault">10</x:String>

