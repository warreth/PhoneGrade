<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Window Title -->
    <x:String x:Key="WindowTitle">PhoneGrade</x:String>
    
    <!-- Tab Headers -->
    <x:String x:Key="Tab_Dashboard">概览</x:String>
    <x:String x:Key="Tab_InteractiveTests">交互式检测</x:String>
    <x:String x:Key="Tab_Label">标签</x:String>
    <x:String x:Key="Tab_Settings">设置</x:String>
    <x:String x:Key="Tab_Logs">日志</x:String>
    <x:String x:Key="Tab_Troubleshoot">故障排查</x:String>
    
    <!-- Dashboard Card Titles -->
    <x:String x:Key="Card_Status">状态</x:String>
    <x:String x:Key="Card_Device">设备</x:String>
    <x:String x:Key="Card_ComponentAudit">OEM 部件审核</x:String>
    <x:String x:Key="Card_DiagnosticIssues">诊断问题</x:String>
    <x:String x:Key="Card_WebRunner">网页检测</x:String>
    
    <!-- Buttons -->
    <x:String x:Key="Btn_StartManual">手动开始</x:String>
    <x:String x:Key="Btn_Refresh">刷新</x:String>
    <x:String x:Key="Btn_OpenLabel">打开标签</x:String>
    <x:String x:Key="Btn_StartWebRunner">启动网页检测</x:String>
    <x:String x:Key="Btn_StopWebRunner">停止网页检测</x:String>
    <x:String x:Key="Btn_RunDiagnostics">运行诊断</x:String>
    <x:String x:Key="Btn_CopyReport">复制报告</x:String>
    <x:String x:Key="Btn_ExportReport">导出报告</x:String>
    <x:String x:Key="Btn_FixAll">修复全部问题</x:String>
    <x:String x:Key="Btn_Fix">修复</x:String>
    <x:String x:Key="Btn_Clear">清除</x:String>
    <x:String x:Key="Btn_Copy">复制</x:String>
    <x:String x:Key="Btn_Export">导出</x:String>
    <x:String x:Key="Btn_OpenFolder">打开文件夹</x:String>
    
    <!-- Status Messages -->
    <x:String x:Key="Status_Ready">请插入 iPhone 或 iPad 开始……</x:String>
    <x:String x:Key="Status_NoDevice">未找到设备。请更换线缆或接口，或解锁设备后点按“信任”。</x:String>
    <x:String x:Key="Status_ToolsMissing">无USB工具，诊断</x:String>
    
    <!-- Settings -->
    <x:String x:Key="Settings_Title">设置</x:String>
    <x:String x:Key="Settings_Theme">主题</x:String>
    <x:String x:Key="Settings_ThemeDesc">深色、浅色或跟随系统</x:String>
    <x:String x:Key="Settings_Language">语言</x:String>
    <x:String x:Key="Settings_LanguageDesc">界面语言</x:String>
    <x:String x:Key="Settings_AutoDetect">插入时自动检测</x:String>
    <x:String x:Key="Settings_AutoDetectDesc">检测到设备时自动开始流程</x:String>
    <x:String x:Key="Settings_UsbEventMonitoring">USB 事件监控</x:String>
    <x:String x:Key="Settings_UsbEventMonitoringDesc">使用系统原生的 USB 事件即时检测设备（Windows WMI、macOS IOKit、Linux udev）</x:String>
    
    <!-- Troubleshoot -->
    <x:String x:Key="Troubleshoot_Title">设备检测与驱动助手</x:String>
    <x:String x:Key="Troubleshoot_Desc">如果设备无法识别，请扫描系统，诊断缺失的驱动、权限或守护进程。</x:String>
    <x:String x:Key="Troubleshoot_Scanning">正在运行诊断，请稍候……</x:String>
    <x:String x:Key="Troubleshoot_ClickToScan">点按“运行诊断”，扫描系统中的 USB 工具、驱动和已连接设备。</x:String>
    
    <!-- Logs -->
    <x:String x:Key="Logs_SearchPlaceholder">搜索日志……</x:String>
    <x:String x:Key="Logs_FilterDebug">调试</x:String>
    <x:String x:Key="Logs_FilterInfo">信息</x:String>
    <x:String x:Key="Logs_FilterWarning">警告</x:String>
    <x:String x:Key="Logs_FilterError">错误</x:String>
    
    <!-- Component Status -->
    <x:String x:Key="Component_Read">已读取</x:String>
    <x:String x:Key="Component_Original">原装</x:String>
    <x:String x:Key="Component_Mismatch">已更换</x:String>
    <x:String x:Key="Component_Untrusted">非原装</x:String>
    <x:String x:Key="Component_Status">状态</x:String>

    <!-- Words for a value the phone never reported -->
    <x:String x:Key="Value_Unknown">未知</x:String>
    <x:String x:Key="Value_UnknownDevice">未知设备</x:String>
    <x:String x:Key="Value_BatteryLevel">电量 {0}%</x:String>
    <x:String x:Key="Value_Checking">检查中……</x:String>
    <x:String x:Key="Value_NotSet">未设置</x:String>
    <x:String x:Key="Value_NotGraded">未定级</x:String>
    <x:String x:Key="BatteryStatus_Unknown">电池状态未知</x:String>
    <x:String x:Key="BatteryStatus_Good">正常</x:String>
    <x:String x:Key="BatteryStatus_Overheated">过热</x:String>
    <x:String x:Key="BatteryStatus_Defective">故障</x:String>
    <x:String x:Key="BatteryStatus_Overvoltage">过压</x:String>
    <x:String x:Key="BatteryStatus_StorageFault">存储故障</x:String>
    <x:String x:Key="BatteryStatus_TooCold">温度过低</x:String>
    <x:String x:Key="ActivationLock_On">开启（已锁定）</x:String>
    <x:String x:Key="ActivationLock_Off">关闭（已解锁）</x:String>
    
    <x:String x:Key="Settings_DailyOptions">日常选项</x:String>
    <x:String x:Key="Settings_GroupOnArrival">设备到店时</x:String>
    <x:String x:Key="Settings_GroupInteractiveTest">交互式检测</x:String>
    <x:String x:Key="Settings_GroupAfterwards">检测结束后</x:String>
    <x:String x:Key="Settings_Quality">默认等级</x:String>
    <x:String x:Key="Settings_Payment">默认结算方式</x:String>
    <x:String x:Key="Settings_AutoStartWebTest">自动启动交互式网页检测</x:String>
    <x:String x:Key="Settings_RequirePwaTest">完成前必须执行 PWA 检测</x:String>
    <x:String x:Key="Settings_AutoFinishAfterTest">检测后自动完成</x:String>
    <x:String x:Key="Settings_ShowSummary">打印标签前显示报告</x:String>
    <x:String x:Key="Settings_Advanced">高级自动化</x:String>
    <x:String x:Key="Settings_AutoActivate">自动激活（绕过）</x:String>
    <x:String x:Key="Settings_RunDiagnostics">运行硬件诊断（panic 日志）</x:String>
    <x:String x:Key="Settings_Enable85Checker">85% 电池检测（标签上标 100%-X）</x:String>
    <x:String x:Key="Settings_OpenEditor">打印前打开标签编辑器</x:String>
    <x:String x:Key="Settings_Connection">手机如何打开页面</x:String>
    <x:String x:Key="Settings_SecureOrigin">通过 USB 线缆（http://localhost）</x:String>
    <x:String x:Key="Settings_SecureOriginDesc">手机直接在这台电脑上打开检测页面。浏览器信任该地址，因此摄像头、麦克风、运动传感器和定位都能正常使用。这是两种方式中更快的一种，无需联网，插入线缆即可使用，也是系统优先尝试的路线。</x:String>
    <x:String x:Key="Settings_PublicTunnel">通过互联网（https，安全）</x:String>
    <x:String x:Key="Settings_PublicTunnelDesc">电脑通过 Cloudflare 打开一个安全的 https 地址，并转发到检测页面。当没有 USB 通道时将使用此方式作为备用，iPhone 始终属于这种情况。两种方式可以同时开启：优先尝试 USB，网络连接作为备用。电脑和手机都需要联网；否则一切都在本地网络内进行，摄像头、麦克风、运动传感器和定位将无法使用。</x:String>

    <!-- Licensing &amp; Subscription -->
    <x:String x:Key="Settings_LicensingCardTitle">许可与订阅</x:String>
    <x:String x:Key="Settings_LicenseKey">许可密钥</x:String>
    <x:String x:Key="Settings_LicenseKeyWatermark">请输入你的 Lemon Squeezy 许可密钥</x:String>
    <x:String x:Key="Settings_ValidateActivate">验证并激活</x:String>
    <x:String x:Key="Settings_ManageLicense">管理许可</x:String>
    <x:String x:Key="Settings_FreeTierStatus">免费版（已用 {0}/10 次）</x:String>
    <x:String x:Key="Settings_ProTierStatus">专业版（已激活）</x:String>
    <x:String x:Key="Settings_ActivationSuccess">许可已激活。现在可以无限次扫描。</x:String>
    <x:String x:Key="Settings_ActivationFailed">激活失败：{0}</x:String>
    <x:String x:Key="Settings_ActivationInvalid">许可密钥无效。</x:String>
    <x:String x:Key="Settings_ActivationExpired">此许可已过期。</x:String>
    <x:String x:Key="Settings_ActivationDeactivated">此许可已被停用。</x:String>
    <x:String x:Key="Settings_ActivationError">网络错误。请稍后重试。</x:String>
    <x:String x:Key="Settings_ActivationLimitReached">此密钥允许使用的电脑数量有限，且已全部占用。请在其他工位释放一台电脑，或购买数量更多的套餐。</x:String>

    <!-- Licensing: introduction screen and the status pill in the title bar -->
    <x:String x:Key="Intro_Title">欢迎使用 PhoneGrade</x:String>
    <x:String x:Key="Intro_Subtitle">从免费版开始：10 次扫描，无需注册账号。需要更多时可升级专业版，取消次数限制。</x:String>
    <x:String x:Key="Intro_FreeTierTitle">免费版</x:String>
    <x:String x:Key="Intro_FreeTierBody">10 次扫描。标题栏中的状态始终显示剩余次数。</x:String>
    <x:String x:Key="Intro_ProTierTitle">专业版</x:String>
    <x:String x:Key="Intro_ProTierBody">连接的每台设备都可无限次扫描。</x:String>
    <x:String x:Key="Intro_ProBadge">无限次</x:String>
    <x:String x:Key="Intro_StartFree">免费开始</x:String>
    <x:String x:Key="Intro_PageWelcome">语言与外观</x:String>
    <x:String x:Key="Intro_WelcomeLead">这些只需设置一次。两者都可以稍后在设置中更改。</x:String>
    <x:String x:Key="Intro_PagePlan">免费版包含的内容</x:String>
    <x:String x:Key="Intro_PageWorkflow">检测流程</x:String>
    <x:String x:Key="Intro_WorkflowLead">四个步骤，每次都相同。其中只有交互式检测需要手机。</x:String>
    <x:String x:Key="Intro_StepPlug">通过 USB 插入手机并解锁</x:String>
    <x:String x:Key="Intro_StepRead">PhoneGrade 自行读取硬件，并将读取结果显示在屏幕上</x:String>
    <x:String x:Key="Intro_StepTest">用手机扫描二维码，运行摄像头、屏幕、传感器和音频检测</x:String>
    <x:String x:Key="Intro_StepFinish">选定等级，打印标签，把手机交还客户</x:String>
    <x:String x:Key="Intro_PageImei">网络锁与黑名单检测</x:String>
    <x:String x:Key="Intro_Next">下一步</x:String>
    <x:String x:Key="Intro_Back">上一步</x:String>
    <x:String x:Key="Intro_Skip">跳过</x:String>
    <x:String x:Key="Intro_SeePricing">查看价格</x:String>
    <x:String x:Key="Intro_HaveLicense">我已有许可</x:String>
    <x:String x:Key="Intro_ActivationTitle">激活你的许可</x:String>
    <x:String x:Key="Licensing_TierFree">剩余 {0} 次扫描</x:String>
    <x:String x:Key="Licensing_TierPro">专业版 - 已激活</x:String>
    <x:String x:Key="Licensing_PanelHint">许可与扫描次数</x:String>
    <x:String x:Key="Licensing_PanelTitle">许可</x:String>
    <x:String x:Key="Licensing_PanelScansLeft">剩余扫描次数</x:String>
    <x:String x:Key="Licensing_PanelClose">关闭</x:String>
    <x:String x:Key="Licensing_PanelSeatsUsed">已使用 {1} 台电脑中的 {0} 台</x:String>
    <x:String x:Key="Licensing_PanelSeatThis">此电脑（{0}）</x:String>
    <x:String x:Key="Licensing_PanelSeatsLabel">电脑</x:String>
    <x:String x:Key="Licensing_PanelNoMachineId">无法识别这台电脑，因此无法在此激活许可。免费扫描仍然可用。</x:String>
    <x:String x:Key="Licensing_PanelRelease">释放此电脑</x:String>
    <x:String x:Key="Licensing_PanelReleaseConfirm">确认释放？</x:String>
    <x:String x:Key="Licensing_PanelReleaseCancel">保留</x:String>
    <x:String x:Key="Licensing_PanelReleaseHint">释放此电脑后，另一台电脑即可使用同一密钥。之后你可以再次激活该密钥。</x:String>
    <x:String x:Key="Licensing_PanelReleaseDone">此电脑已释放。在你再次激活该密钥之前，将使用免费版。</x:String>
    <x:String x:Key="Licensing_PanelReleaseDoneAlready">此电脑已不在该密钥的注册列表中。你正在使用免费版。</x:String>

    <x:String x:Key="Btn_Troubleshoot">USB 与驱动诊断</x:String>
    <x:String x:Key="Btn_Logs">查看系统日志</x:String>
    
    <!-- Summary / Inspection Report -->
    <x:String x:Key="Summary_Title">检测报告</x:String>
    <x:String x:Key="Summary_AuditTitle">3UTOOLS 硬件部件审核</x:String>
    <x:String x:Key="Summary_AuditSubtitle">出厂值与读取值对比</x:String>
    <x:String x:Key="Summary_ColComponent">部件</x:String>
    <x:String x:Key="Summary_ColPart">零件</x:String>
    <x:String x:Key="Summary_ColFactory">出厂值</x:String>
    <x:String x:Key="Summary_ColRead">读取值</x:String>
    <!-- The audit rows are far narrower than the report, so the two columns get
         their own short labels; the full ones would be cut in the middle. -->
    <x:String x:Key="Active_ColFactory">出厂值</x:String>
    <x:String x:Key="Active_ColRead">读取值</x:String>
    <x:String x:Key="Summary_ColStatus">状态</x:String>
    <x:String x:Key="Summary_BtnPrint">打印 DYMO 标签</x:String>
    <x:String x:Key="Summary_BtnRetest">重新检测</x:String>
    <x:String x:Key="Summary_BtnNext">下一台设备（完成）</x:String>
    <x:String x:Key="Summary_SimLockFree">已解锁（无 SIM 卡锁）</x:String>
    <x:String x:Key="Summary_SimLocked">SIM 卡已锁定</x:String>

    <!-- ============ Export and printing ============ -->
    <!-- The panel an operator reaches from the inspection report. It is the only
         place that knows about labels, reports and the raw numbers, so the summary
         screen's button opens it and nothing else writes a file. -->
    <x:String x:Key="Export_Title">导出与打印</x:String>
    <x:String x:Key="Export_Lead">保存标签、报告和原始数据，或直接打印标签。</x:String>
    <x:String x:Key="Export_PreviewTitle">标签预览</x:String>
    <x:String x:Key="Export_PreviewNote">与文件使用相同的数值绘制。缺失的内容显示为占位符。</x:String>
    <x:String x:Key="Export_PreviewScaled">为适配此处显示，绘制比例小于实际标签。形状正确，尺寸不同。</x:String>
    <x:String x:Key="Export_Stock">标签规格</x:String>
    <x:String x:Key="Export_StockNote">打印机中的标签卷，按订购时的料号区分。</x:String>
    <x:String x:Key="Export_StockPart">料号 {0}</x:String>
    <x:String x:Key="LabelStock_1982991">地址标签 89 x 28 毫米</x:String>
    <x:String x:Key="LabelStock_1983172">大号地址标签 89 x 36 毫米</x:String>
    <x:String x:Key="LabelStock_30334">多用途 57 x 32 毫米</x:String>
    <x:String x:Key="LabelStock_30336">小号多用途 54 x 25 毫米</x:String>
    <x:String x:Key="LabelStock_30256">大号运费标签 102 x 59 毫米</x:String>
    <x:String x:Key="LabelStock_1933081">货架标签 89 x 25 毫米</x:String>
    <x:String x:Key="Export_BarcodeTitle">条形码</x:String>
    <x:String x:Key="Export_BarcodeNote">条形码所携带的信息。两个编码需要标签上的两条区域，留给文字的空间会更少。</x:String>
    <x:String x:Key="Export_BarcodeIdentifier">仅识别码</x:String>
    <x:String x:Key="Export_BarcodeIdentifierNote">一个编码，仅包含序列号。标签看起来像价签，收银系统识别的是这种。</x:String>
    <x:String x:Key="Export_BarcodeSplit">两个编码</x:String>
    <x:String x:Key="Export_BarcodeSplitNote">一个编码放序列号，另一个放存储空间、等级和电池信息，两者都印在标签上。</x:String>
    <x:String x:Key="Export_BarcodeCombined">一个编码，包含两者</x:String>
    <x:String x:Key="Export_BarcodeCombinedNote">一个编码同时包含序列号和规格信息。</x:String>
    <x:String x:Key="Export_BarcodeNone">无条形码</x:String>
    <x:String x:Key="Export_BarcodeNoneNote">适用于扫描枪无法识别条形码的门店。标签只印文字，不含其他内容。</x:String>
    <x:String x:Key="Export_BarcodeUnavailable">&#22312;&#26412;&#22238;&#26800;&#19978;&#22810;&#23485;&#20197;&#36807;&#36824;&#24050;&#21487;&#20854;&#20026;&#26465;&#30721;&#21360;&#21040;&#12290;&#35831;&#36873;&#25321;&#26356;&#23485;&#30340;&#22238;&#26800;&#65292;&#25110;&#32773;&#31245;&#21516;&#20026;&#23453;&#23433;&#20026;&#20854;&#37324;&#30340;&#30721;&#29392;&#12290;</x:String>
    <x:String x:Key="Export_SymbologyTitle">次码类型</x:String>
    <x:String x:Key="Export_Symbology39">Code 39</x:String>
    <x:String x:Key="Export_Symbology39Note">手机店里的收银机和扫码枪都已经能读这种条码。它能表示大写字母和少量符号，所以型号名称会以短横线的形式写进条码里。</x:String>
    <x:String x:Key="Export_Symbology128">Code 128</x:String>
    <x:String x:Key="Export_Symbology128Note">信息密度更高，因此一个条码可以同时写入序列号和规格，而 Code 39 做不到这一点。您的扫码枪需要设置为可读这种条码。</x:String>


 
 
 
 
 
    <x:String x:Key="Export_LabelShowTitle">标签内容</x:String>
    <x:String x:Key="Export_LabelShowCycles">充电次数</x:String>
    <x:String x:Key="Export_LabelShowCyclesNote">电池已充电的次数，百分比无法反映这一信息。</x:String>
    <x:String x:Key="Export_LabelShowFaults">故障项</x:String>
    <x:String x:Key="Export_LabelShowFaultsNote">以数量形式列出存在的问题，例如 2 个非 OEM 屏幕。</x:String>
    <x:String x:Key="Export_LabelShowLocks">FRP 与激活锁</x:String>
    <x:String x:Key="Export_LabelShowLocksNote">任意一项开启时以更大字号打印。关闭此项会隐藏用于阻止锁定手机售出的提示行。</x:String>
    <x:String x:Key="Export_LabelPreviewTitle">标签</x:String>
    <x:String x:Key="Export_LabelPreviewNote">按上方标签卷的尺寸绘制，使用与文件相同的数值。</x:String>
    <x:String x:Key="Export_LabelTooNarrow">序列号过长，无法在这种标签上生成条形码，因此以文字形式打印。</x:String>
    <x:String x:Key="Export_LabelNoBarcode">此标签上没有条形码。</x:String>
    <x:String x:Key="Export_FormatsTitle">导出内容</x:String>
    <x:String x:Key="Export_FormatsNote">所有勾选项会一次性写入，每一项单独报告结果。</x:String>
    <x:String x:Key="Export_Printer">打印机</x:String>
    <x:String x:Key="Export_PrintDialog">系统打印对话框</x:String>
    <x:String x:Key="Export_PrinterReady">就绪</x:String>
    <x:String x:Key="Export_PrinterBusy">忙碌</x:String>
    <x:String x:Key="Export_NoPrinters">未找到打印机。请使用系统打印对话框。</x:String>
    <x:String x:Key="Export_ScanPrinters">查找打印机</x:String>
    <x:String x:Key="Export_Copies">份数</x:String>
    <x:String x:Key="Export_BtnWrite">写入所选项</x:String>
    <x:String x:Key="Export_BtnPrintLabel">打印标签</x:String>
    <x:String x:Key="Export_BtnOpenFolder">打开文件夹</x:String>
    <x:String x:Key="Export_FolderLabel">保存到</x:String>
    <x:String x:Key="Export_ResultsTitle">写入结果</x:String>
    <x:String x:Key="Export_BtnOpen">打开</x:String>
    <x:String x:Key="Export_BtnPrintOne">打印</x:String>
    <x:String x:Key="Export_Close">关闭</x:String>
