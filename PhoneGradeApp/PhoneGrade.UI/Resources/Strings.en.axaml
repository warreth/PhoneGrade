    <x:String x:Key="Settings_SecLabel">Label</x:String>
    <x:String x:Key="Settings_LabelLead">This is what every label looks like, for every inspection.</x:String>
    <x:String x:Key="Settings_LabelVariant">Label layout</x:String>
    <x:String x:Key="Settings_LabelVariantDesc">Choose the layout that suits the shop; the preview follows.</x:String>
    <x:String x:Key="Settings_LabelVariantClean">As before (cleaned up)</x:String>
    <x:String x:Key="Settings_LabelVariantCleanNote">One line with every value, as the label always was.</x:String>
    <x:String x:Key="Settings_LabelVariantStructured">Structured</x:String>
    <x:String x:Key="Settings_LabelVariantStructuredNote">Model and storage apart, the values together, faults and locks below.</x:String>
    <x:String x:Key="Settings_LabelVariantGradeBlock">Grade block</x:String>
    <x:String x:Key="Settings_LabelVariantGradeBlockNote">The grade as a large block; the rest beside it.</x:String>
    <x:String x:Key="Settings_LabelBarcodeTitle">Barcode</x:String>
    <x:String x:Key="Settings_LabelBarcode">Barcode with serial number</x:String>
    <x:String x:Key="Settings_LabelBarcodeDesc">One Code 39 code with the serial number. Every till reads it.</x:String>
    <x:String x:Key="Settings_LabelBarcodeNote">Turn off for a shop whose scanner cannot read one; the label then carries only its words.</x:String>
    <x:String x:Key="Settings_LabelBarcodeAdvanced">Advanced for own scanners</x:String>
    <x:String x:Key="Settings_LabelCyclesNote">How often the battery was charged; below the threshold from Quality the label leaves it off.</x:String>
    <x:String x:Key="Settings_LabelPreview">Preview</x:String>
    <x:String x:Key="Settings_LabelPreviewNote">Drawn from the same values as the file, at the size of the roll.</x:String>
    <x:String x:Key="Settings_LabelFiles">Files</x:String>
    <x:String x:Key="Settings_LabelFilesNote">What every finish writes by default.</x:String>
    <x:String x:Key="Settings_LabelFolder">Folder grouping</x:String>
    <x:String x:Key="Settings_LabelFolderDesc">How the exports are grouped.</x:String>
    <x:String x:Key="Settings_FolderDay">Per day</x:String>
    <x:String x:Key="Settings_FolderDayNote">One folder per day, named by the date.</x:String>
    <x:String x:Key="Settings_FolderWeek">Per week</x:String>
    <x:String x:Key="Settings_FolderWeekNote">One folder per ISO week, the default.</x:String>
    <x:String x:Key="Settings_FolderMonth">Per month</x:String>
    <x:String x:Key="Settings_FolderMonthNote">One folder per month.</x:String>
    <x:String x:Key="Settings_FolderInspection">Per device</x:String>
    <x:String x:Key="Settings_FolderInspectionNote">One folder per serial number.</x:String>
    <x:String x:Key="Settings_SecQuality">Quality</x:String>
    <x:String x:Key="Settings_QualityLead">When a value is marked on the label and counted as a deviation in the report.</x:String>
    <x:String x:Key="Settings_QualityBatteryThreshold">Mark battery under</x:String>
    <x:String x:Key="Settings_QualityBatteryThresholdDesc">A battery under this limit gets an [X] on the label.</x:String>
    <x:String x:Key="Settings_QualityBatteryExample">This phone: {0}.</x:String>
    <x:String x:Key="Settings_QualityBatteryUnknown">no battery value read</x:String>
    <x:String x:Key="Settings_QualityCyclesThreshold">Show charge cycles from</x:String>
    <x:String x:Key="Settings_QualityCyclesThresholdDesc">Below this limit the number says nothing and the label leaves it off. The report always carries the value.</x:String>
    <x:String x:Key="Settings_QualityCyclesShown">This phone has {0} cycles and that goes on the label.</x:String>
    <x:String x:Key="Settings_QualityCyclesHidden">This phone has {0} cycles and that stays off the label.</x:String>
