    <x:String x:Key="Component_Untrusted">Non-original</x:String>
    <x:String x:Key="Component_Status">Status</x:String>

    <!-- Words for a value the phone never reported -->
    <x:String x:Key="Value_Unknown">Unknown</x:String>
    <x:String x:Key="Value_UnknownDevice">Unknown device</x:String>
    <x:String x:Key="Value_BatteryLevel">Charge {0}%</x:String>
    <x:String x:Key="Value_Checking">Checking...</x:String>
    <x:String x:Key="Value_NotSet">Not set</x:String>
    <x:String x:Key="Value_NotGraded">Not graded</x:String>
    <x:String x:Key="BatteryStatus_Unknown">Battery status unknown</x:String>
    <x:String x:Key="BatteryStatus_Good">Good</x:String>
    <x:String x:Key="BatteryStatus_Overheated">Overheated</x:String>
    <x:String x:Key="BatteryStatus_Defective">Defective</x:String>
    <x:String x:Key="BatteryStatus_Overvoltage">Overvoltage</x:String>
    <x:String x:Key="BatteryStatus_StorageFault">Storage fault</x:String>
    <x:String x:Key="BatteryStatus_TooCold">Too cold</x:String>
    <x:String x:Key="ActivationLock_On">ON (locked)</x:String>
    <x:String x:Key="ActivationLock_Off">OFF (unlocked)</x:String>
    
    <x:String x:Key="Settings_DailyOptions">DAILY OPTIONS</x:String>
    <x:String x:Key="Settings_GroupOnArrival">When a device arrives</x:String>
    <x:String x:Key="Settings_GroupInteractiveTest">The interactive test</x:String>
    <x:String x:Key="Settings_GroupAfterwards">After the inspection</x:String>
    <x:String x:Key="Settings_Quality">Default Quality</x:String>
    <x:String x:Key="Settings_Payment">Default Payment Method</x:String>
    <x:String x:Key="Settings_AutoStartWebTest">Automatically start interactive web test</x:String>
    <x:String x:Key="Settings_RequirePwaTest">Require PWA Test before finishing</x:String>
    <x:String x:Key="Settings_AutoFinishAfterTest">Automatically finish after test</x:String>
    <x:String x:Key="Settings_ShowSummary">Show summary before printing label</x:String>
    <x:String x:Key="Settings_Advanced">Advanced automation</x:String>
    <x:String x:Key="Settings_AutoActivate">Auto-activate (bypass)</x:String>
    <x:String x:Key="Settings_RunDiagnostics">Run hardware diagnostics (panic logs)</x:String>
    <x:String x:Key="Settings_Enable85Checker">85% Battery check (100%-X label)</x:String>
    <x:String x:Key="Settings_OpenEditor">Open label editor before printing</x:String>
    <x:String x:Key="Settings_Connection">HOW THE PHONE OPENS THE PAGE</x:String>
    <x:String x:Key="Settings_SecureOrigin">Over the USB cable (http://localhost)</x:String>
    <x:String x:Key="Settings_SecureOriginDesc">The phone opens the test page on the pc itself. A browser trusts that address, so camera, microphone, motion sensors and location all work there. This is the faster of the two, needs no internet, and works as soon as the cable is in. It is the route that is tried first.</x:String>
    <x:String x:Key="Settings_PublicTunnel">Over the internet (https, secure)</x:String>
    <x:String x:Key="Settings_PublicTunnelDesc">The pc opens a secure https address that forwards to the test page, through Cloudflare. This is the fallback when there is no usb tunnel, which is always the case for an iPhone. Both may be on at once: usb is tried first and the internet connection is the fallback. Needs internet on the pc and on the phone; without it everything stays on the local network and camera, microphone, motion sensors and location stop working.</x:String>

    <!-- Licensing &amp; Subscription -->
    <x:String x:Key="Settings_LicensingCardTitle">Licensing &amp; Subscription</x:String>
    <x:String x:Key="Settings_LicenseKey">License Key</x:String>
    <x:String x:Key="Settings_LicenseKeyWatermark">Enter your Lemon Squeezy license key</x:String>
    <x:String x:Key="Settings_ValidateActivate">Validate &amp; Activate</x:String>
    <x:String x:Key="Settings_ManageLicense">Manage license</x:String>
    <x:String x:Key="Settings_FreeTierStatus">Free Tier ({0}/10 Scans Used)</x:String>
    <x:String x:Key="Settings_ProTierStatus">Pro Tier (Active)</x:String>
    <x:String x:Key="Settings_ActivationSuccess">License activated. Unlimited scanning is now available.</x:String>
    <x:String x:Key="Settings_ActivationFailed">Activation failed: {0}</x:String>
    <x:String x:Key="Settings_ActivationInvalid">Invalid license key.</x:String>
    <x:String x:Key="Settings_ActivationExpired">This license has expired.</x:String>
    <x:String x:Key="Settings_ActivationDeactivated">This license has been deactivated.</x:String>
    <x:String x:Key="Settings_ActivationError">Network error. Please try again later.</x:String>
    <x:String x:Key="Settings_ActivationLimitReached">This key allows a limited number of computers, and they are all in use. Release a computer on another bench, or buy a plan with more.</x:String>

    <!-- Licensing: introduction screen and the status pill in the title bar -->
    <x:String x:Key="Intro_Title">Welcome to PhoneGrade</x:String>
    <x:String x:Key="Intro_Subtitle">Start on the free plan: 10 scans, no account needed. Pro removes the limit whenever you need more.</x:String>
    <x:String x:Key="Intro_FreeTierTitle">Free</x:String>
    <x:String x:Key="Intro_FreeTierBody">10 scans. The status in the title bar always shows how many you have left.</x:String>
    <x:String x:Key="Intro_ProTierTitle">Pro</x:String>
    <x:String x:Key="Intro_ProTierBody">Unlimited scans on every device you connect.</x:String>
    <x:String x:Key="Intro_ProBadge">Unlimited</x:String>
    <x:String x:Key="Intro_StartFree">Start free</x:String>
    <x:String x:Key="Intro_PageWelcome">Language and look</x:String>
    <x:String x:Key="Intro_WelcomeLead">Set these once. Both can be changed later in Settings.</x:String>
    <x:String x:Key="Intro_PagePlan">What the free plan gives you</x:String>
    <x:String x:Key="Intro_PageWorkflow">How an inspection runs</x:String>
    <x:String x:Key="Intro_WorkflowLead">Four steps, the same every time. The interactive test is the one that needs the phone.</x:String>
    <x:String x:Key="Intro_StepPlug">Plug the phone in over USB and unlock it</x:String>
    <x:String x:Key="Intro_StepRead">PhoneGrade reads the hardware itself and writes what it found on screen</x:String>
    <x:String x:Key="Intro_StepTest">Scan the QR code with the phone to run the camera, screen, sensor and audio tests</x:String>
    <x:String x:Key="Intro_StepFinish">Pick the grade, print the label, and hand the phone back</x:String>
    <x:String x:Key="Intro_PageImei">Carrier lock and blacklist checks</x:String>
    <x:String x:Key="Intro_Next">Next</x:String>
    <x:String x:Key="Intro_Back">Back</x:String>
    <x:String x:Key="Intro_Skip">Skip</x:String>
    <x:String x:Key="Intro_SeePricing">See pricing</x:String>
    <x:String x:Key="Intro_HaveLicense">I already have a license</x:String>
    <x:String x:Key="Intro_ActivationTitle">Activate your license</x:String>
    <x:String x:Key="Licensing_TierFree">{0} scans left</x:String>
    <x:String x:Key="Licensing_TierPro">Pro - Active</x:String>
    <x:String x:Key="Licensing_PanelHint">License and scans</x:String>
    <x:String x:Key="Licensing_PanelTitle">License</x:String>
    <x:String x:Key="Licensing_PanelScansLeft">Scans remaining</x:String>
    <x:String x:Key="Licensing_PanelClose">Close</x:String>
    <x:String x:Key="Licensing_PanelSeatsUsed">{0} of {1} computers in use</x:String>
    <x:String x:Key="Licensing_PanelSeatThis">This computer ({0})</x:String>
    <x:String x:Key="Licensing_PanelSeatsLabel">Computers</x:String>
    <x:String x:Key="Licensing_PanelNoMachineId">This computer cannot be identified, so a license cannot be activated here. The free scans still work.</x:String>
    <x:String x:Key="Licensing_PanelRelease">Release this computer</x:String>
    <x:String x:Key="Licensing_PanelReleaseConfirm">Really release it?</x:String>
    <x:String x:Key="Licensing_PanelReleaseCancel">Keep it</x:String>
    <x:String x:Key="Licensing_PanelReleaseHint">Frees this computer so another one can use the same key. You can activate the key again afterwards.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDone">This computer was released. You are on the free tier until you activate the key again.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDoneAlready">This computer was no longer registered with the key. You are on the free tier.</x:String>

    <x:String x:Key="Btn_Troubleshoot">USB and Driver Diagnostics</x:String>
    <x:String x:Key="Btn_Logs">View System Logs</x:String>
    
    <!-- Summary / Inspection Report -->
    <x:String x:Key="Summary_Title">INSPECTION REPORT</x:String>
    <x:String x:Key="Summary_AuditTitle">3UTOOLS HARDWARE COMPONENT AUDIT</x:String>
    <x:String x:Key="Summary_AuditSubtitle">Comparison Ex-Factory vs Read Value</x:String>
    <x:String x:Key="Summary_ColComponent">Component</x:String>
    <x:String x:Key="Summary_ColPart">Part</x:String>
    <x:String x:Key="Summary_ColFactory">Ex-Factory Value</x:String>
    <x:String x:Key="Summary_ColRead">Read Value</x:String>
    <!-- The audit rows are far narrower than the report, so the two columns get
         their own short labels; the full ones would be cut in the middle. -->
    <x:String x:Key="Active_ColFactory">Factory value</x:String>
    <x:String x:Key="Active_ColRead">Read value</x:String>
    <x:String x:Key="Summary_ColStatus">Status</x:String>
    <x:String x:Key="Summary_BtnPrint">Finish</x:String>
    <x:String x:Key="Summary_BtnRetest">Retest</x:String>
    <x:String x:Key="Summary_BtnNext">Next Device (Done)</x:String>
    <x:String x:Key="Summary_SimLockFree">Unlocked (SIM-free)</x:String>
    <x:String x:Key="Summary_SimLocked">SIM Locked</x:String>

    <!-- ============ Export and printing ============ -->
    <!-- The panel an operator reaches from the inspection report. It is the only
         place that knows about labels, reports and the raw numbers, so the summary
         screen's button opens it and nothing else writes a file. -->
    <x:String x:Key="Export_Title">Finish</x:String>
    <x:String x:Key="Export_Lead">Check the label. Printing and saving happen in one go.</x:String>
    <x:String x:Key="Export_PreviewTitle">Label preview</x:String>
    <x:String x:Key="Export_PreviewNote">Drawn from the same values as the file, at the size of the roll.</x:String>
    <x:String x:Key="Export_PreviewScaled">Drawn smaller than the label so it fits here. The shape is right; the size is not.</x:String>
    <x:String x:Key="Export_Stock">Label stock</x:String>
    <x:String x:Key="Export_StockNote">The roll in the printer, by the part number it is ordered under.</x:String>
    <x:String x:Key="Export_StockPart">Part {0}</x:String>
    <x:String x:Key="LabelStock_1982991">Address label 89 x 28 mm</x:String>
    <x:String x:Key="LabelStock_1983172">Large address label 89 x 36 mm</x:String>
    <x:String x:Key="LabelStock_30334">Multi-purpose 57 x 32 mm</x:String>
    <x:String x:Key="LabelStock_30336">Small multi-purpose 54 x 25 mm</x:String>
    <x:String x:Key="LabelStock_30256">Large shipping 102 x 59 mm</x:String>
    <x:String x:Key="LabelStock_1933081">Durable shelving 89 x 25 mm</x:String>
    <x:String x:Key="Export_BarcodeTitle">Barcode</x:String>
    <x:String x:Key="Export_BarcodeNote">What the barcode carries. Two codes need two bands of the label, which leaves the words less room.</x:String>
    <x:String x:Key="Export_BarcodeIdentifier">Identifier only</x:String>
    <x:String x:Key="Export_BarcodeIdentifierNote">One code with the serial number. The label reads as a price tag, and this is what a till looks for.</x:String>
    <x:String x:Key="Export_BarcodeSplit">Two codes</x:String>
    <x:String x:Key="Export_BarcodeSplitNote">The serial number on one code and the storage, grade and battery on another, both on the label.</x:String>
    <x:String x:Key="Export_BarcodeCombined">One code, both</x:String>
    <x:String x:Key="Export_BarcodeCombinedNote">One code carrying the serial number and the specification together.</x:String>
    <x:String x:Key="Export_BarcodeNone">No barcode</x:String>
    <x:String x:Key="Export_BarcodeNoneNote">For a shop whose scanner cannot read one. The label carries its words and nothing else.</x:String>
    <x:String x:Key="Export_BarcodeUnavailable">Too wide to print as bars on this roll. Choose a wider roll, or a barcode type that fits it.</x:String>
    <x:String x:Key="Export_SymbologyTitle">Barcode type</x:String>
    <x:String x:Key="Export_Symbology39">Code 39</x:String>
    <x:String x:Key="Export_Symbology39Note">What every till and scanner in a phone shop already reads. Carries capitals and a handful of symbols, so a model name goes on the code as dashes.</x:String>
    <x:String x:Key="Export_Symbology128">Code 128</x:String>
    <x:String x:Key="Export_Symbology128Note">Denser, so one code can carry the identifier and the specification together where Code39 cannot. Your scanner has to be set to read it.</x:String>
    <x:String x:Key="Export_LabelShowCycles">Charge count</x:String>
    <x:String x:Key="Export_LabelPreviewTitle">The label</x:String>
    <x:String x:Key="Export_LabelPreviewNote">Drawn to the size of the roll above, from the same values as the file.</x:String>
    <x:String x:Key="Export_LabelTooNarrow">The serial number is too long for a barcode on this stock, so it is printed as text.</x:String>
    <x:String x:Key="Export_LabelNoBarcode">No barcode on this label.</x:String>
    <x:String x:Key="Export_FormatsTitle">What to write</x:String>
    <x:String x:Key="Export_FormatsNote">Everything ticked is written in one go, and each one is reported on its own.</x:String>
    <x:String x:Key="Export_Printer">Printer</x:String>
    <x:String x:Key="Export_PrintDialog">System print dialog</x:String>
    <x:String x:Key="Export_PrinterReady">ready</x:String>
    <x:String x:Key="Export_PrinterBusy">busy</x:String>
    <x:String x:Key="Export_NoPrinters">No printer found. Use the system print dialog.</x:String>
    <x:String x:Key="Export_ScanPrinters">Find printers</x:String>
    <x:String x:Key="Export_Copies">Copies</x:String>
    <x:String x:Key="Export_BtnWrite">Write selected</x:String>
    <x:String x:Key="Export_BtnPrintLabel">Print label</x:String>
    <x:String x:Key="Export_BtnOpenFolder">Open folder</x:String>
    <x:String x:Key="Export_FolderLabel">Into</x:String>
    <x:String x:Key="Export_ResultsTitle">Written</x:String>
    <x:String x:Key="Export_BtnOpen">Open</x:String>
    <x:String x:Key="Export_BtnPrintOne">Print</x:String>
    <x:String x:Key="Export_Close">Close</x:String>
    <x:String x:Key="Export_Busy">Working...</x:String>

    <!-- The formats, named and described. The note is what stops somebody
         picking by extension: a JSON file and a CSV file are both "the numbers". -->
    <x:String x:Key="Export_FormatDymo">DYMO label</x:String>
    <x:String x:Key="Export_FormatDymoNote">.dymo for DYMO Label and for printing straight to a DYMO.</x:String>
    <x:String x:Key="Export_FormatLabelPdf">Label as PDF</x:String>
    <x:String x:Key="Export_FormatLabelPdfNote">The same label as a PDF, for any printer on any of the three systems.</x:String>
    <x:String x:Key="Export_FormatReportPdf">Full report as PDF</x:String>
    <x:String x:Key="Export_FormatReportPdfNote">Every value that was read, with the verdict at the top. To file or to show a customer.</x:String>
    <x:String x:Key="Export_FormatJson">Raw numbers as JSON</x:String>
    <x:String x:Key="Export_FormatJsonNote">Everything the phone reported, versioned. For your own system.</x:String>
    <x:String x:Key="Export_FormatCsv">Raw numbers as CSV</x:String>
    <x:String x:Key="Export_FormatCsvNote">The same numbers, one row per field, for a spreadsheet.</x:String>
    <x:String x:Key="Export_NameOf">Format</x:String>
    <x:String x:Key="Export_PrintFailed">The label could not be written, so nothing was printed.</x:String>
    <x:String x:Key="Status_Exporting">Writing the files...</x:String>
    <x:String x:Key="Status_ExportDone">{0} file(s) written to {1}</x:String>
    <x:String x:Key="Status_ExportPartly">{0} of {1} written to {3}. {2} could not be written: see the row above.</x:String>
    <x:String x:Key="Status_DymoSent">Label sent to DYMO. DYMO reports the job as accepted, not as printed.</x:String>
    <x:String x:Key="Status_DymoRefused">DYMO did not take the label: {0}</x:String>

    <!-- What a failed export, a note on a written one, or a print says. Read at the
         moment something went wrong, so it comes from here rather than from the
         code that detected it. -->
    <x:String x:Key="Status_TemplateMissing">The label template {0} is not there. Pick another one in Settings, or clear the setting to use the template that came with the app.</x:String>
    <x:String x:Key="Status_TemplateUnreadable">The label template at {0} could not be read: {1}</x:String>
    <x:String x:Key="Status_NoTemplateFound">No label template ({0}) was found. Looked in: {1}</x:String>
    <x:String x:Key="Status_TemplateHasNoFields">The label template carries none of the fields this app fills, so every label would come out the same. Open the template that came with the app again.</x:String>
    <x:String x:Key="Status_WriteFailed">Writing the {0} file failed: {1}</x:String>
    <x:String x:Key="Status_UnfilledFields">The template also asks for {0}, which nothing fills.</x:String>
    <x:String x:Key="Status_BarcodeReplaced">Characters the barcode cannot carry were replaced with a dash, and the text is printed beside it.</x:String>
    <x:String x:Key="Status_BarcodeWrapped">Asterisks were added so the barcode can be read back.</x:String>
    <x:String x:Key="Status_NoFileAt">There is no file at {0}.</x:String>
    <x:String x:Key="Status_NoFolderAt">There is no folder at {0}.</x:String>
    <x:String x:Key="Status_NoPrinterChosen">No printer was chosen.</x:String>
    <x:String x:Key="Status_PrintDialogOpened">Sent to the print dialog.</x:String>
    <x:String x:Key="Status_PrintNoHandler">No print handler is installed, so the file was opened instead. Print it from there.</x:String>
    <x:String x:Key="Status_PrintPreviewOpened">Opened in Preview. Print it from there.</x:String>
    <x:String x:Key="Status_PrintDefaultApp">Opened in the default application. Print it from there.</x:String>
    <x:String x:Key="Status_PrintNotStarted">Printing could not be started: {0}</x:String>
    <x:String x:Key="Status_PrintQueueNeedsDialog">Choosing a printer by name needs a print dialog on Windows. Use Print instead.</x:String>
    <x:String x:Key="Status_PrintSentToQueue">Sent to {0}.</x:String>
    <x:String x:Key="Status_PrintToQueueFailed">Printing to {0} failed: {1}</x:String>
    <x:String x:Key="Status_FolderOpened">Opened the folder.</x:String>
    <x:String x:Key="Status_FolderNotOpened">The folder could not be opened: {0}</x:String>
    <x:String x:Key="Status_FileOpened">Opened.</x:String>
    <x:String x:Key="Status_FileNotOpened">The file could not be opened: {0}</x:String>

    <!-- The wording inside the report PDFs. A report is a document somebody keeps,
         so it is written in the language of the shop rather than of the code. -->
    <x:String x:Key="Export_ReportTitle">Inspection report</x:String>
    <x:String x:Key="Export_ReportGenerated">Generated</x:String>
    <x:String x:Key="Export_Confidential">Confidential</x:String>
    <x:String x:Key="Export_Verdict">Verdict</x:String>
    <x:String x:Key="Export_VerdictClean">No faults found</x:String>
    <x:String x:Key="Export_SectionDevice">Device</x:String>
    <x:String x:Key="Export_SectionBattery">Battery</x:String>
    <x:String x:Key="Export_SectionNetwork">Network</x:String>
    <x:String x:Key="Export_SectionSecurity">Locks and security</x:String>
    <x:String x:Key="Export_SectionComponents">Component originals</x:String>
    <x:String x:Key="Export_SectionTests">Interactive tests</x:String>
