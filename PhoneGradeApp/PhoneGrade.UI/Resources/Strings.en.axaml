    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmiDesc">$0.360 - Returns carrier name, SIM lock status, and Find My iPhone (FMI) status for Apple devices.</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimple">BLACKLIST: Simple Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimpleDesc">$0.200 - Returns basic blacklist status (clean or blacklisted) only.</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremium">BLACKLIST: Premium Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumDesc">$0.420 - Returns detailed info: IMEI, Model Name, Manufacturer, Model Number, Blacklisted By, Blacklisted On, Blacklist Reason, Blacklist Status, Blacklisted Country, General List Status.</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnox">GENERIC: Samsung Info Check &amp; Knox Info</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxDesc">$0.600 - Returns Samsung device info including model, serial, warranty, and Knox warranty bit status.</x:String>

    <!-- Introduction screen: IMEI checks (BYOK) -->
    <x:String x:Key="Intro_ImeiTitle">IMEI checks (BYOK)</x:String>
    <x:String x:Key="Intro_ImeiBody">PhoneGrade checks carrier lock, FMI, blacklist and Knox status through imei.info. This is a Bring Your Own Key system: create an account at imei.info, add credits, and paste your own API key in Settings. Every check has its own price (from $0.200 to $0.600), and you choose which checks run automatically.</x:String>
    <x:String x:Key="Intro_ImeiConfigureButton">Configure IMEI API in Settings</x:String>
    <x:String x:Key="Settings_ImeiInfoWatermarkDefault">10</x:String>

