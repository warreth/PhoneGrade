    <x:String x:Key="Settings_ImeiCheck_BlacklistSimplePrice">$0.200</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumPrice">$0.420</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxPrice">$0.600</x:String>

    <!-- IMEI check names and descriptions -->
    <x:String x:Key="Settings_SecImeiApi">IMEI API-Konfiguration</x:String>
    <x:String x:Key="Settings_ImeiInfoApiKeyWatermark">Fügen Sie hier Ihren API-Schlüssel ein (z. B. e0d7c26f-5cc7-5644-863c-8992083dfeac)</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmi">APPLE: Carrier &amp; Lock Status &amp; FMI</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmiDesc">$0.360 - Liefert Netzbetreibernamen, SIM-Sperrstatus und Find My iPhone (FMI)-Status für Apple-Geräte.</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimple">BLACKLIST: Einfache Prüfung</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimpleDesc">$0.200 - Liefert nur den grundlegenden Blacklist-Status (sauber oder gelistet).</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremium">BLACKLIST: Premium Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumDesc">$0.420 - Liefert detaillierte Angaben: IMEI, Modellname, Hersteller, Modellnummer, Gelistet von, Gelistet am, Blacklist-Grund, Blacklist-Status, Gelistetes Land, Allgemeiner Listenstatus.</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnox">GENERIC: Samsung Info Check &amp; Knox Info</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxDesc">$0.600 - Liefert Geräteinformationen zu Samsung einschließlich Modell, Seriennummer, Garantie und Knox-Garantiebit-Status.</x:String>

    <!-- Introduction screen: IMEI checks (BYOK) -->
    <x:String x:Key="Intro_ImeiTitle">IMEI-Prüfungen (BYOK)</x:String>
    <x:String x:Key="Intro_ImeiBody">PhoneGrade prüft Netzbetreiber-Sperre, FMI, Blacklist und Knox-Status über imei.info. Dies ist ein Bring Your Own Key-System: erstellen Sie ein Konto bei imei.info, fügen Sie Guthaben hinzu und tragen Sie Ihren eigenen API-Schlüssel in den Einstellungen ein. Jede Prüfung hat ihren eigenen Preis (von $0.200 bis $0.600), und Sie wählen, welche Prüfungen automatisch laufen.</x:String>
    <x:String x:Key="Intro_ImeiConfigureButton">IMEI API in den Einstellungen konfigurieren</x:String>
    <x:String x:Key="Settings_ImeiInfoWatermarkDefault">10</x:String>

