    <!-- What a failed export, a note on a written one, or a print says. Read at the
         moment something went wrong, so it comes from here rather than from the
         code that detected it. -->
    <x:String x:Key="Status_TemplateMissing">Die Etikettvorlage {0} ist nicht vorhanden. Wählen Sie in den Einstellungen eine andere oder leeren Sie die Einstellung, um die mitgelieferte Vorlage zu verwenden.</x:String>
    <x:String x:Key="Status_TemplateUnreadable">Die Etikettvorlage unter {0} konnte nicht gelesen werden: {1}</x:String>
    <x:String x:Key="Status_NoTemplateFound">Es wurde keine Etikettvorlage ({0}) gefunden. Gesucht in: {1}</x:String>
    <x:String x:Key="Status_TemplateHasNoFields">Die Etikettvorlage enthält keines der Felder, die diese App füllt, deshalb käme jedes Etikett gleich heraus. Öffnen Sie erneut die mitgelieferte Vorlage.</x:String>
    <x:String x:Key="Status_WriteFailed">Das Schreiben der Datei {0} ist fehlgeschlagen: {1}</x:String>
    <x:String x:Key="Status_UnfilledFields">Die Vorlage fragt außerdem nach {0}, und das füllt nichts.</x:String>
    <x:String x:Key="Status_BarcodeReplaced">Zeichen, die der Barcode nicht tragen kann, wurden durch einen Bindestrich ersetzt, und der Text wird daneben gedruckt.</x:String>
    <x:String x:Key="Status_BarcodeWrapped">Sternchen wurden hinzugefügt, damit der Barcode zurückgelesen werden kann.</x:String>
    <x:String x:Key="Status_NoFileAt">Unter {0} ist keine Datei vorhanden.</x:String>
    <x:String x:Key="Status_NoFolderAt">Unter {0} ist kein Ordner vorhanden.</x:String>
    <x:String x:Key="Status_NoPrinterChosen">Es wurde kein Drucker ausgewählt.</x:String>
    <x:String x:Key="Status_PrintDialogOpened">An den Druckdialog gesendet.</x:String>
    <x:String x:Key="Status_PrintNoHandler">Es ist kein Druckhandler installiert, deshalb wurde die Datei stattdessen geöffnet. Drucken Sie sie von dort.</x:String>
    <x:String x:Key="Status_PrintPreviewOpened">In der Vorschau geöffnet. Drucken Sie sie von dort.</x:String>
    <x:String x:Key="Status_PrintDefaultApp">In der Standardanwendung geöffnet. Drucken Sie sie von dort.</x:String>
    <x:String x:Key="Status_PrintNotStarted">Der Druck konnte nicht gestartet werden: {0}</x:String>
    <x:String x:Key="Status_PrintQueueNeedsDialog">Einen Drucker nach Namen auszuwählen erfordert unter Windows einen Druckdialog. Verwenden Sie stattdessen Drucken.</x:String>
    <x:String x:Key="Status_PrintSentToQueue">An {0} gesendet.</x:String>
    <x:String x:Key="Status_PrintToQueueFailed">Drucken nach {0} ist fehlgeschlagen: {1}</x:String>
