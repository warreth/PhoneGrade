<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Window Title -->
    <x:String x:Key="WindowTitle">PhoneGrade</x:String>
    
    <!-- Tab Headers -->
    <x:String x:Key="Tab_Dashboard">Dashboard</x:String>
    <x:String x:Key="Tab_InteractiveTests">Interaktive Tests</x:String>
    <x:String x:Key="Tab_Label">Label</x:String>
    <x:String x:Key="Tab_Settings">Einstellungen</x:String>
    <x:String x:Key="Tab_Logs">Logs</x:String>
    <x:String x:Key="Tab_Troubleshoot">Troubleshoot</x:String>
    
    <!-- Dashboard Card Titles -->
    <x:String x:Key="Card_Status">STATUS</x:String>
    <x:String x:Key="Card_Device">GERÄT</x:String>
    <x:String x:Key="Card_ComponentAudit">OEM KOMPONENTENPRÜFUNG</x:String>
    <x:String x:Key="Card_DiagnosticIssues">DIAGNOSTISCHE PROBLEME</x:String>
    <x:String x:Key="Card_WebRunner">WEB TEST RUNNER</x:String>
    
    <!-- Buttons -->
    <x:String x:Key="Btn_StartManual">Manuell starten</x:String>
    <x:String x:Key="Btn_Refresh">Aktualisieren</x:String>
    <x:String x:Key="Btn_OpenLabel">Etikett öffnen</x:String>
    <x:String x:Key="Btn_StartWebRunner">Web Runner starten</x:String>
    <x:String x:Key="Btn_StopWebRunner">Web Runner stoppen</x:String>
    <x:String x:Key="Btn_RunDiagnostics">Diagnose ausführen</x:String>
    <x:String x:Key="Btn_CopyReport">Bericht kopieren</x:String>
    <x:String x:Key="Btn_ExportReport">Bericht exportieren</x:String>
    <x:String x:Key="Btn_FixAll">Alle Probleme beheben</x:String>
    <x:String x:Key="Btn_Fix">Beheben</x:String>
    <x:String x:Key="Btn_Clear">Löschen</x:String>
    <x:String x:Key="Btn_Copy">Kopieren</x:String>
    <x:String x:Key="Btn_Export">Exportieren</x:String>
    <x:String x:Key="Btn_OpenFolder">Ordner öffnen</x:String>
    
    <!-- Status Messages -->
    <x:String x:Key="Status_Ready">Stecken Sie ein iPhone/iPad ein, um zu starten...</x:String>
    <x:String x:Key="Status_NoDevice">Kein Gerät gefunden. Prüfen Sie Kabel/Port oder entsperren Sie das Gerät und tippen Sie auf "Vertrauen".</x:String>
    <x:String x:Key="Status_ToolsMissing">Keine USB-Tools: Diagnose</x:String>
    
    <!-- Settings -->
    <x:String x:Key="Settings_Title">EINSTELLUNGEN</x:String>
    <x:String x:Key="Settings_Theme">Design</x:String>
    <x:String x:Key="Settings_ThemeDesc">Dunkel, hell oder Systemvorgabe</x:String>
    <x:String x:Key="Settings_Language">Sprache</x:String>
    <x:String x:Key="Settings_LanguageDesc">Sprache der Oberfläche</x:String>
    <x:String x:Key="Settings_AutoDetect">Automatisch beim Einstecken erkennen</x:String>
    <x:String x:Key="Settings_AutoDetectDesc">Ablauf automatisch starten, sobald ein Gerät erkannt wird</x:String>
    <x:String x:Key="Settings_UsbEventMonitoring">USB-Ereignisüberwachung</x:String>
    <x:String x:Key="Settings_UsbEventMonitoringDesc">Native USB-Ereignisse des Betriebssystems für sofortige Geräteerkennung nutzen (Windows WMI, macOS IOKit, Linux udev)</x:String>
    
    <!-- Troubleshoot -->
    <x:String x:Key="Troubleshoot_Title">GERÄTEERKENNUNG &amp; TREIBER-ASSISTENT</x:String>
    <x:String x:Key="Troubleshoot_Desc">Wenn ein Gerät nicht erkannt wird, durchsuchen Sie das System, um fehlende Treiber, Berechtigungen oder Dienste zu diagnostizieren.</x:String>
    <x:String x:Key="Troubleshoot_Scanning">Diagnose läuft, bitte warten...</x:String>
    <x:String x:Key="Troubleshoot_ClickToScan">Klicken Sie auf "Diagnose ausführen", um das System nach USB-Tools, Treibern und angeschlossenen Geräten zu durchsuchen.</x:String>
    
    <!-- Logs -->
    <x:String x:Key="Logs_SearchPlaceholder">Logs durchsuchen...</x:String>
    <x:String x:Key="Logs_FilterDebug">Debug</x:String>
    <x:String x:Key="Logs_FilterInfo">Info</x:String>
    <x:String x:Key="Logs_FilterWarning">Warnung</x:String>
    <x:String x:Key="Logs_FilterError">Fehler</x:String>
    
    <!-- Component Status -->
    <x:String x:Key="Component_Read">Gelesen</x:String>
    <x:String x:Key="Component_Original">Original</x:String>
    <x:String x:Key="Component_Mismatch">Ersetzt</x:String>
    <x:String x:Key="Component_Untrusted">Nicht original</x:String>
    <x:String x:Key="Component_Status">Status</x:String>

    <!-- Words for a value the phone never reported -->
    <x:String x:Key="Value_Unknown">Unbekannt</x:String>
    <x:String x:Key="Value_UnknownDevice">Unbekanntes Gerät</x:String>
    <x:String x:Key="Value_BatteryLevel">Ladung {0}%</x:String>
    <x:String x:Key="Value_Checking">Prüfen...</x:String>
    <x:String x:Key="Value_NotSet">Nicht gesetzt</x:String>
    <x:String x:Key="Value_NotGraded">Nicht bewertet</x:String>
    <x:String x:Key="BatteryStatus_Unknown">Batteriestatus unbekannt</x:String>
    <x:String x:Key="BatteryStatus_Good">Gut</x:String>
    <x:String x:Key="BatteryStatus_Overheated">Überhitzt</x:String>
    <x:String x:Key="BatteryStatus_Defective">Defekt</x:String>
    <x:String x:Key="BatteryStatus_Overvoltage">Überspannung</x:String>
    <x:String x:Key="BatteryStatus_StorageFault">Speicherfehler</x:String>
    <x:String x:Key="BatteryStatus_TooCold">Zu kalt</x:String>
    <x:String x:Key="ActivationLock_On">AN (gesperrt)</x:String>
    <x:String x:Key="ActivationLock_Off">AUS (entsperrt)</x:String>
    
    <x:String x:Key="Settings_DailyOptions">TÄGLICHE OPTIONEN</x:String>
    <x:String x:Key="Settings_GroupOnArrival">Wenn ein Gerät eintrifft</x:String>
    <x:String x:Key="Settings_GroupInteractiveTest">Der interaktive Test</x:String>
    <x:String x:Key="Settings_GroupAfterwards">Nach der Prüfung</x:String>
    <x:String x:Key="Settings_Quality">Standardqualität</x:String>
    <x:String x:Key="Settings_Payment">Standardabrechnungsmethode</x:String>
    <x:String x:Key="Settings_AutoStartWebTest">Interaktiven Webtest automatisch starten</x:String>
    <x:String x:Key="Settings_RequirePwaTest">PWA-Test vor dem Abschluss erforderlich</x:String>
    <x:String x:Key="Settings_AutoFinishAfterTest">Nach dem Test automatisch abschließen</x:String>
    <x:String x:Key="Settings_ShowSummary">Zusammenfassung vor dem Etikettendruck anzeigen</x:String>
    <x:String x:Key="Settings_Advanced">Erweiterte Automatisierung</x:String>
    <x:String x:Key="Settings_AutoActivate">Automatisch aktivieren (Bypass)</x:String>
    <x:String x:Key="Settings_RunDiagnostics">Hardwarediagnose ausführen (Panic-Logs)</x:String>
    <x:String x:Key="Settings_Enable85Checker">85-Prozent-Batterieprüfung (100-Prozent-X-Etikett)</x:String>
    <x:String x:Key="Settings_OpenEditor">Etiketteneditor vor dem Druck öffnen</x:String>
    <x:String x:Key="Settings_Connection">WIE DAS TELEFON DIE SEITE ÖFFNET</x:String>
    <x:String x:Key="Settings_SecureOrigin">Über das USB-Kabel (http://localhost)</x:String>
    <x:String x:Key="Settings_SecureOriginDesc">Das Telefon öffnet die Testseite direkt auf dem PC. Diese Adresse vertraut ein Browser, deshalb funktionieren dort Kamera, Mikrofon, Bewegungssensoren und Standort. Das ist der schnellere der beiden Wege, braucht kein Internet und funktioniert sofort, sobald das Kabel steckt. Dieser Weg wird zuerst versucht.</x:String>
    <x:String x:Key="Settings_PublicTunnel">Über das Internet (https, sicher)</x:String>
    <x:String x:Key="Settings_PublicTunnelDesc">Der PC öffnet eine sichere https-Adresse, die über Cloudflare zur Testseite weiterleitet. Das ist der Ersatzweg, wenn es keinen USB-Tunnel gibt, was bei einem iPhone immer der Fall ist. Beide dürfen gleichzeitig aktiv sein: USB wird zuerst versucht, das Internet ist der Ersatz. Braucht Internet auf dem PC und auf dem Telefon; ohne Internet bleibt alles im lokalen Netzwerk und Kamera, Mikrofon, Bewegungssensoren und Standort funktionieren nicht.</x:String>

    <!-- Licensing &amp; Subscription -->
    <x:String x:Key="Settings_LicensingCardTitle">Lizenz &amp; Abonnement</x:String>
    <x:String x:Key="Settings_LicenseKey">Lizenzschlüssel</x:String>
    <x:String x:Key="Settings_LicenseKeyWatermark">Geben Sie Ihren Lemon Squeezy Lizenzschlüssel ein</x:String>
    <x:String x:Key="Settings_ValidateActivate">Prüfen &amp; aktivieren</x:String>
    <x:String x:Key="Settings_ManageLicense">Lizenz verwalten</x:String>
    <x:String x:Key="Settings_FreeTierStatus">Kostenlos ({0}/10 Scans verwendet)</x:String>
    <x:String x:Key="Settings_ProTierStatus">Pro (aktiv)</x:String>
    <x:String x:Key="Settings_ActivationSuccess">Lizenz aktiviert. Unbegrenztes Scannen ist jetzt verfügbar.</x:String>
    <x:String x:Key="Settings_ActivationFailed">Aktivierung fehlgeschlagen: {0}</x:String>
    <x:String x:Key="Settings_ActivationInvalid">Ungültiger Lizenzschlüssel.</x:String>
    <x:String x:Key="Settings_ActivationExpired">Diese Lizenz ist abgelaufen.</x:String>
    <x:String x:Key="Settings_ActivationDeactivated">Diese Lizenz wurde deaktiviert.</x:String>
    <x:String x:Key="Settings_ActivationError">Netzwerkfehler. Bitte versuchen Sie es später erneut.</x:String>
    <x:String x:Key="Settings_ActivationLimitReached">Dieser Schlüssel erlaubt nur eine begrenzte Anzahl an Computern, und alle sind belegt. Geben Sie einen Computer an einer anderen Arbeitsstation frei oder buchen Sie einen Tarif mit mehr Plätzen.</x:String>

    <!-- Licensing: introduction screen and the status pill in the title bar -->
    <x:String x:Key="Intro_Title">Willkommen bei PhoneGrade</x:String>
    <x:String x:Key="Intro_Subtitle">Starten Sie mit dem kostenlosen Tarif: 10 Scans, kein Konto nötig. Pro hebt das Limit auf, sobald Sie mehr brauchen.</x:String>
    <x:String x:Key="Intro_FreeTierTitle">Kostenlos</x:String>
    <x:String x:Key="Intro_FreeTierBody">10 Scans. Der Status in der Titelleiste zeigt immer, wie viele übrig sind.</x:String>
    <x:String x:Key="Intro_ProTierTitle">Pro</x:String>
    <x:String x:Key="Intro_ProTierBody">Unbegrenztes Scannen an jedem Gerät, das Sie anschließen.</x:String>
    <x:String x:Key="Intro_ProBadge">Unbegrenzt</x:String>
    <x:String x:Key="Intro_StartFree">Kostenlos starten</x:String>
    <x:String x:Key="Intro_PageWelcome">Sprache und Darstellung</x:String>
    <x:String x:Key="Intro_WelcomeLead">Stellen Sie das einmal ein. Beides lässt sich später in den Einstellungen ändern.</x:String>
    <x:String x:Key="Intro_PagePlan">Was der kostenlose Tarif Ihnen bietet</x:String>
    <x:String x:Key="Intro_PageWorkflow">Wie eine Prüfung abläuft</x:String>
    <x:String x:Key="Intro_WorkflowLead">Vier Schritte, jedes Mal dieselben. Nur der interaktive Test braucht das Telefon.</x:String>
    <x:String x:Key="Intro_StepPlug">Schließen Sie das Telefon über USB an und entsperren Sie es</x:String>
    <x:String x:Key="Intro_StepRead">PhoneGrade liest die Hardware selbst aus und zeigt das Ergebnis auf dem Bildschirm</x:String>
    <x:String x:Key="Intro_StepTest">Scannen Sie den QR-Code mit dem Telefon, um Kamera-, Bildschirm-, Sensor- und Audiotests auszuführen</x:String>
    <x:String x:Key="Intro_StepFinish">Wählen Sie die Qualität, drucken Sie das Etikett und geben Sie das Telefon zurück</x:String>
    <x:String x:Key="Intro_PageImei">Prüfungen auf Netzbetreiber-Sperre und Blacklist</x:String>
    <x:String x:Key="Intro_Next">Weiter</x:String>
    <x:String x:Key="Intro_Back">Zurück</x:String>
    <x:String x:Key="Intro_Skip">Überspringen</x:String>
    <x:String x:Key="Intro_SeePricing">Preise ansehen</x:String>
    <x:String x:Key="Intro_HaveLicense">Ich habe bereits eine Lizenz</x:String>
    <x:String x:Key="Intro_ActivationTitle">Aktivieren Sie Ihre Lizenz</x:String>
    <x:String x:Key="Licensing_TierFree">Noch {0} Scans</x:String>
    <x:String x:Key="Licensing_TierPro">Pro - Aktiv</x:String>
    <x:String x:Key="Licensing_PanelHint">Lizenz und Scans</x:String>
    <x:String x:Key="Licensing_PanelTitle">Lizenz</x:String>
    <x:String x:Key="Licensing_PanelScansLeft">Verbleibende Scans</x:String>
    <x:String x:Key="Licensing_PanelClose">Schließen</x:String>
    <x:String x:Key="Licensing_PanelSeatsUsed">{0} von {1} Computern belegt</x:String>
    <x:String x:Key="Licensing_PanelSeatThis">Dieser Computer ({0})</x:String>
    <x:String x:Key="Licensing_PanelSeatsLabel">Computer</x:String>
    <x:String x:Key="Licensing_PanelNoMachineId">Dieser Computer kann nicht identifiziert werden, deshalb kann hier keine Lizenz aktiviert werden. Die kostenlosen Scans funktionieren weiterhin.</x:String>
    <x:String x:Key="Licensing_PanelRelease">Diesen Computer freigeben</x:String>
    <x:String x:Key="Licensing_PanelReleaseConfirm">Wirklich freigeben?</x:String>
    <x:String x:Key="Licensing_PanelReleaseCancel">Behalten</x:String>
    <x:String x:Key="Licensing_PanelReleaseHint">Gibt diesen Computer frei, damit ein anderer denselben Schlüssel nutzen kann. Sie können den Schlüssel danach erneut aktivieren.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDone">Dieser Computer wurde freigegeben. Sie bleiben im kostenlosen Tarif, bis Sie den Schlüssel erneut aktivieren.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDoneAlready">Dieser Computer war nicht mehr mit dem Schlüssel registriert. Sie sind im kostenlosen Tarif.</x:String>

    <x:String x:Key="Btn_Troubleshoot">USB- und Treiberdiagnose</x:String>
    <x:String x:Key="Btn_Logs">Systemprotokolle ansehen</x:String>
    
    <!-- Summary / Inspection Report -->
    <x:String x:Key="Summary_Title">PRÜFBERICHT</x:String>
    <x:String x:Key="Summary_AuditTitle">3UTOOLS HARDWARE-KOMPONENTENPRÜFUNG</x:String>
    <x:String x:Key="Summary_AuditSubtitle">Vergleich Werkswert gegen gelesenen Wert</x:String>
    <x:String x:Key="Summary_ColComponent">Komponente</x:String>
    <x:String x:Key="Summary_ColPart">Bauteil</x:String>
    <x:String x:Key="Summary_ColFactory">Werkswert</x:String>
    <x:String x:Key="Summary_ColRead">Gelesener Wert</x:String>
    <!-- The audit rows are far narrower than the report, so the two columns get
         their own short labels; the full ones would be cut in the middle. -->
    <x:String x:Key="Active_ColFactory">Werkswert</x:String>
    <x:String x:Key="Active_ColRead">Gelesener Wert</x:String>
    <x:String x:Key="Summary_ColStatus">Status</x:String>
    <x:String x:Key="Summary_BtnPrint">DYMO-ETIKETT DRUCKEN</x:String>
    <x:String x:Key="Summary_BtnRetest">Erneut testen</x:String>
    <x:String x:Key="Summary_BtnNext">Nächstes Gerät (Fertig)</x:String>
    <x:String x:Key="Summary_SimLockFree">Entsperrt (SIM-frei)</x:String>
    <x:String x:Key="Summary_SimLocked">SIM gesperrt</x:String>

    <!-- ============ Export and printing ============ -->
    <!-- The panel an operator reaches from the inspection report. It is the only
         place that knows about labels, reports and the raw numbers, so the summary
         screen's button opens it and nothing else writes a file. -->
    <x:String x:Key="Export_Title">Exportieren und drucken</x:String>
    <x:String x:Key="Export_Lead">Speichern Sie Etikett, Bericht und Zahlen oder drucken Sie das Etikett sofort.</x:String>
    <x:String x:Key="Export_PreviewTitle">Etikettvorschau</x:String>
    <x:String x:Key="Export_PreviewNote">Gezeichnet aus denselben Werten wie die Datei. Was fehlt, erscheint als Platzhalter.</x:String>
    <x:String x:Key="Export_PreviewScaled">Kleiner gezeichnet als das Etikett, damit es hier passt. Das Seitenverhältnis stimmt, die Größe nicht.</x:String>
    <x:String x:Key="Export_Stock">Etikettenmaterial</x:String>
    <x:String x:Key="Export_StockNote">Die Rolle im Drucker, nach der Artikelnummer, unter der sie bestellt wird.</x:String>
    <x:String x:Key="Export_StockPart">Teil {0}</x:String>
    <x:String x:Key="LabelStock_1982991">Adressetikett 89 x 28 mm</x:String>
    <x:String x:Key="LabelStock_1983172">Großes Adressetikett 89 x 36 mm</x:String>
    <x:String x:Key="LabelStock_30334">Mehrzweck 57 x 32 mm</x:String>
    <x:String x:Key="LabelStock_30336">Kleines Mehrzwecketikett 54 x 25 mm</x:String>
    <x:String x:Key="LabelStock_30256">Großes Versandetikett 102 x 59 mm</x:String>
    <x:String x:Key="LabelStock_1933081">Robustes Regaletikett 89 x 25 mm</x:String>
    <x:String x:Key="Export_BarcodeTitle">Barcode</x:String>
    <x:String x:Key="Export_BarcodeNote">Was der Barcode enthält. Zwei Codes brauchen zwei Streifen des Etiketts, dadurch bleibt weniger Platz für den Text.</x:String>
    <x:String x:Key="Export_BarcodeIdentifier">Nur Kennung</x:String>
    <x:String x:Key="Export_BarcodeIdentifierNote">Ein Code mit der Seriennummer. Das Etikett wirkt wie ein Preisschild, und danach sucht eine Kasse.</x:String>
    <x:String x:Key="Export_BarcodeSplit">Zwei Codes</x:String>
    <x:String x:Key="Export_BarcodeSplitNote">Die Seriennummer auf einem Code und Speicher, Qualität und Akku auf einem anderen, beide auf dem Etikett.</x:String>
    <x:String x:Key="Export_BarcodeCombined">Ein Code, beides</x:String>
    <x:String x:Key="Export_BarcodeCombinedNote">Ein Code mit Seriennummer und Spezifikation zusammen.</x:String>
    <x:String x:Key="Export_BarcodeNone">Kein Barcode</x:String>
    <x:String x:Key="Export_BarcodeNoneNote">Für einen Shop, dessen Scanner keinen Barcode lesen kann. Das Etikett trägt nur seinen Text.</x:String>
    <x:String x:Key="Export_BarcodeUnavailable">Zu breit, um es auf dieser Rolle als Balken zu drucken. W&#228;hlen Sie eine breitere Rolle oder ein Strichcodeformat, das darauf passt.</x:String>
    <x:String x:Key="Export_SymbologyTitle">Strichcodeformat</x:String>
    <x:String x:Key="Export_Symbology39">Code 39</x:String>
    <x:String x:Key="Export_Symbology39Note">Was jede Kasse und jeder Scanner in einem Telefonladen bereits liest. Tr&#228;gt Gro&#223;buchstaben und einige Zeichen, ein Modellname steht deshalb als Striche auf dem Code.</x:String>
    <x:String x:Key="Export_Symbology128">Code 128</x:String>
    <x:String x:Key="Export_Symbology128Note">Dichter, damit ein Code Kennung und Spezifikation gemeinsam tr&#228;gt, wo Code39 das nicht kann. Ihr Scanner muss darauf eingestellt sein.</x:String>


 
 
 
 
 
    <x:String x:Key="Export_LabelShowTitle">Auf dem Etikett</x:String>
    <x:String x:Key="Export_LabelShowCycles">Ladezyklen</x:String>
    <x:String x:Key="Export_LabelShowCyclesNote">Wie oft der Akku geladen wurde, was ein Prozentwert nicht verraten kann.</x:String>
    <x:String x:Key="Export_LabelShowFaults">Fehler</x:String>
    <x:String x:Key="Export_LabelShowFaultsNote">Eine gezählte Liste der Mängel, zum Beispiel 2x kein OEM-Display.</x:String>
    <x:String x:Key="Export_LabelShowLocks">FRP und Aktivierungssperre</x:String>
    <x:String x:Key="Export_LabelShowLocksNote">Wird in größerer Schrift gedruckt, wenn eines von beiden aktiv ist. Ausschalten entfernt die Zeile, die den Verkauf eines gesperrten Telefons verhindert.</x:String>
    <x:String x:Key="Export_LabelPreviewTitle">Das Etikett</x:String>
    <x:String x:Key="Export_LabelPreviewNote">Gezeichnet in der Größe der Rolle oben, aus denselben Werten wie die Datei.</x:String>
    <x:String x:Key="Export_LabelTooNarrow">Die Seriennummer ist für einen Barcode auf diesem Material zu lang, deshalb wird sie als Text gedruckt.</x:String>
    <x:String x:Key="Export_LabelNoBarcode">Kein Barcode auf diesem Etikett.</x:String>
    <x:String x:Key="Export_FormatsTitle">Was geschrieben wird</x:String>
    <x:String x:Key="Export_FormatsNote">Alles Aktivierte wird in einem Durchgang geschrieben, und jede Datei wird einzeln gemeldet.</x:String>
    <x:String x:Key="Export_Printer">Drucker</x:String>
    <x:String x:Key="Export_PrintDialog">System-Druckdialog</x:String>
    <x:String x:Key="Export_PrinterReady">bereit</x:String>
    <x:String x:Key="Export_PrinterBusy">beschäftigt</x:String>
    <x:String x:Key="Export_NoPrinters">Kein Drucker gefunden. Verwenden Sie den System-Druckdialog.</x:String>
    <x:String x:Key="Export_ScanPrinters">Drucker suchen</x:String>
    <x:String x:Key="Export_Copies">Exemplare</x:String>
    <x:String x:Key="Export_BtnWrite">Auswahl schreiben</x:String>
    <x:String x:Key="Export_BtnPrintLabel">Etikett drucken</x:String>
    <x:String x:Key="Export_BtnOpenFolder">Ordner öffnen</x:String>
    <x:String x:Key="Export_FolderLabel">Nach</x:String>
    <x:String x:Key="Export_ResultsTitle">Geschrieben</x:String>
    <x:String x:Key="Export_BtnOpen">Öffnen</x:String>
    <x:String x:Key="Export_BtnPrintOne">Drucken</x:String>
    <x:String x:Key="Export_Close">Schließen</x:String>
    <x:String x:Key="Export_Busy">In Arbeit...</x:String>

    <!-- The formats, named and described. The note is what stops somebody
         picking by extension: a JSON file and a CSV file are both "the numbers". -->
    <x:String x:Key="Export_FormatDymo">DYMO-Etikett</x:String>
    <x:String x:Key="Export_FormatDymoNote">.dymo für DYMO Label und für den direkten Druck auf einen DYMO.</x:String>
    <x:String x:Key="Export_FormatLabelPdf">Etikett als PDF</x:String>
    <x:String x:Key="Export_FormatLabelPdfNote">Dasselbe Etikett als PDF, für jeden Drucker auf jedem der drei Systeme.</x:String>
    <x:String x:Key="Export_FormatReportPdf">Vollständiger Bericht als PDF</x:String>
    <x:String x:Key="Export_FormatReportPdfNote">Jeder gelesene Wert, mit dem Ergebnis oben. Zum Ablagern oder für einen Kunden.</x:String>
    <x:String x:Key="Export_FormatJson">Rohdaten als JSON</x:String>
    <x:String x:Key="Export_FormatJsonNote">Alles, was das Telefon gemeldet hat, mit Versionsstand. Für Ihr eigenes System.</x:String>
    <x:String x:Key="Export_FormatCsv">Rohdaten als CSV</x:String>
    <x:String x:Key="Export_FormatCsvNote">Dieselben Zahlen, eine Zeile pro Feld, für eine Tabelle.</x:String>
    <x:String x:Key="Export_NameOf">Format</x:String>
    <x:String x:Key="Export_PrintFailed">Das Etikett konnte nicht geschrieben werden, deshalb wurde nichts gedruckt.</x:String>
