<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Window Title -->
    <x:String x:Key="WindowTitle">PhoneGrade</x:String>
    
    <!-- Tab Headers -->
    <x:String x:Key="Tab_Dashboard">Tableau de bord</x:String>
    <x:String x:Key="Tab_InteractiveTests">Tests interactifs</x:String>
    <x:String x:Key="Tab_Label">Étiquette</x:String>
    <x:String x:Key="Tab_Settings">Paramètres</x:String>
    <x:String x:Key="Tab_Logs">Journaux</x:String>
    <x:String x:Key="Tab_Troubleshoot">Dépannage</x:String>
    
    <!-- Dashboard Card Titles -->
    <x:String x:Key="Card_Status">STATUT</x:String>
    <x:String x:Key="Card_Device">APPAREIL</x:String>
    <x:String x:Key="Card_ComponentAudit">AUDIT DES COMPOSANTS OEM</x:String>
    <x:String x:Key="Card_DiagnosticIssues">PROBLÈMES DE DIAGNOSTIC</x:String>
    <x:String x:Key="Card_WebRunner">RUNNER DE TESTS WEB</x:String>
    
    <!-- Buttons -->
    <x:String x:Key="Btn_StartManual">Démarrage manuel</x:String>
    <x:String x:Key="Btn_Refresh">Actualiser</x:String>
    <x:String x:Key="Btn_OpenLabel">Ouvrir l'étiquette</x:String>
    <x:String x:Key="Btn_StartWebRunner">Démarrer le Web Runner</x:String>
    <x:String x:Key="Btn_StopWebRunner">Arrêter le Web Runner</x:String>
    <x:String x:Key="Btn_RunDiagnostics">Lancer le diagnostic</x:String>
    <x:String x:Key="Btn_CopyReport">Copier le rapport</x:String>
    <x:String x:Key="Btn_ExportReport">Exporter le rapport</x:String>
    <x:String x:Key="Btn_FixAll">Tout corriger</x:String>
    <x:String x:Key="Btn_Fix">Corriger</x:String>
    <x:String x:Key="Btn_Clear">Effacer</x:String>
    <x:String x:Key="Btn_Copy">Copier</x:String>
    <x:String x:Key="Btn_Export">Exporter</x:String>
    <x:String x:Key="Btn_OpenFolder">Ouvrir le dossier</x:String>
    
    <!-- Status Messages -->
    <x:String x:Key="Status_Ready">Branchez un iPhone ou un iPad pour démarrer...</x:String>
    <x:String x:Key="Status_NoDevice">Aucun appareil détecté. Changez de câble ou de port, ou déverrouillez l'appareil et appuyez sur « Faire confiance ».</x:String>
    <x:String x:Key="Status_ToolsMissing">Outils USB absents : diagnostic</x:String>
    
    <!-- Settings -->
    <x:String x:Key="Settings_Title">PARAMÈTRES</x:String>
    <x:String x:Key="Settings_Theme">Thème</x:String>
    <x:String x:Key="Settings_ThemeDesc">Sombre, clair ou selon le système</x:String>
    <x:String x:Key="Settings_Language">Langue</x:String>
    <x:String x:Key="Settings_LanguageDesc">Langue de l'interface</x:String>
    <x:String x:Key="Settings_AutoDetect">Détection automatique au branchement</x:String>
    <x:String x:Key="Settings_AutoDetectDesc">Démarre le processus automatiquement dès qu'un appareil est détecté</x:String>
    <x:String x:Key="Settings_UsbEventMonitoring">Surveillance des événements USB</x:String>
    <x:String x:Key="Settings_UsbEventMonitoringDesc">Utilise les événements USB natifs du système pour une détection instantanée (Windows WMI, macOS IOKit, Linux udev)</x:String>
    
    <!-- Troubleshoot -->
    <x:String x:Key="Troubleshoot_Title">ASSISTANCE DÉTECTION APPAREIL &amp; PILOTES</x:String>
    <x:String x:Key="Troubleshoot_Desc">Si un appareil n'est pas reconnu, analysez le système pour diagnostiquer les pilotes, les autorisations ou les services manquants.</x:String>
    <x:String x:Key="Troubleshoot_Scanning">Diagnostic en cours, veuillez patienter...</x:String>
    <x:String x:Key="Troubleshoot_ClickToScan">Cliquez sur « Lancer le diagnostic » pour analyser votre système : outils USB, pilotes et appareils connectés.</x:String>
    
    <!-- Logs -->
    <x:String x:Key="Logs_SearchPlaceholder">Rechercher dans les journaux...</x:String>
    <x:String x:Key="Logs_FilterDebug">Debug</x:String>
    <x:String x:Key="Logs_FilterInfo">Info</x:String>
    <x:String x:Key="Logs_FilterWarning">Avertissement</x:String>
    <x:String x:Key="Logs_FilterError">Erreur</x:String>
    
    <!-- Component Status -->
    <x:String x:Key="Component_Read">Lu</x:String>
    <x:String x:Key="Component_Original">Original</x:String>
    <x:String x:Key="Component_Mismatch">Remplacé</x:String>
    <x:String x:Key="Component_Untrusted">Non original</x:String>
    <x:String x:Key="Component_Status">Statut</x:String>

    <!-- Words for a value the phone never reported -->
    <x:String x:Key="Value_Unknown">Inconnu</x:String>
    <x:String x:Key="Value_UnknownDevice">Appareil inconnu</x:String>
    <x:String x:Key="Value_BatteryLevel">Charge {0} %</x:String>
    <x:String x:Key="Value_Checking">Vérification...</x:String>
    <x:String x:Key="Value_NotSet">Non défini</x:String>
    <x:String x:Key="Value_NotGraded">Pas de grade</x:String>
    <x:String x:Key="BatteryStatus_Unknown">État de la batterie inconnu</x:String>
    <x:String x:Key="BatteryStatus_Good">Bonne</x:String>
    <x:String x:Key="BatteryStatus_Overheated">Surchauffée</x:String>
    <x:String x:Key="BatteryStatus_Defective">Défaillante</x:String>
    <x:String x:Key="BatteryStatus_Overvoltage">Surtension</x:String>
    <x:String x:Key="BatteryStatus_StorageFault">Défaut de stockage</x:String>
    <x:String x:Key="BatteryStatus_TooCold">Trop froide</x:String>
    <x:String x:Key="ActivationLock_On">ACTIVÉ (verrouillé)</x:String>
    <x:String x:Key="ActivationLock_Off">DÉSACTIVÉ (déverrouillé)</x:String>
    
    <x:String x:Key="Settings_DailyOptions">OPTIONS QUOTIDIENNES</x:String>
    <x:String x:Key="Settings_GroupOnArrival">À l'arrivée d'un appareil</x:String>
    <x:String x:Key="Settings_GroupInteractiveTest">Le test interactif</x:String>
    <x:String x:Key="Settings_GroupAfterwards">Après l'inspection</x:String>
    <x:String x:Key="Settings_Quality">Grade par défaut</x:String>
    <x:String x:Key="Settings_Payment">Mode de facturation par défaut</x:String>
    <x:String x:Key="Settings_AutoStartWebTest">Démarrer automatiquement le test web interactif</x:String>
    <x:String x:Key="Settings_RequirePwaTest">Exiger le test PWA avant de terminer</x:String>
    <x:String x:Key="Settings_AutoFinishAfterTest">Terminer automatiquement après le test</x:String>
    <x:String x:Key="Settings_ShowSummary">Afficher le résumé avant l'impression de l'étiquette</x:String>
    <x:String x:Key="Settings_Advanced">Automatisation avancée</x:String>
    <x:String x:Key="Settings_AutoActivate">Activation automatique (bypass)</x:String>
    <x:String x:Key="Settings_RunDiagnostics">Lancer le diagnostic matériel (panic logs)</x:String>
    <x:String x:Key="Settings_Enable85Checker">Contrôle batterie 85 % (étiquette 100 %-X)</x:String>
    <x:String x:Key="Settings_OpenEditor">Ouvrir l'éditeur d'étiquette avant l'impression</x:String>
    <x:String x:Key="Settings_Connection">COMMENT LE TÉLÉPHONE OUVRE LA PAGE</x:String>
    <x:String x:Key="Settings_SecureOrigin">Par le câble USB (http://localhost)</x:String>
    <x:String x:Key="Settings_SecureOriginDesc">Le téléphone ouvre la page de test sur le PC lui-même. Un navigateur fait confiance à cette adresse : la caméra, le micro, les capteurs de mouvement et la localisation y fonctionnent donc. C'est la plus rapide des deux options, elle ne demande pas Internet et fonctionne dès que le câble est branché. C'est la voie essayée en premier.</x:String>
    <x:String x:Key="Settings_PublicTunnel">Par Internet (https, sécurisé)</x:String>
    <x:String x:Key="Settings_PublicTunnelDesc">Le PC ouvre une adresse https sécurisée qui redirige vers la page de test, via Cloudflare. C'est la solution de repli quand il n'y a pas de tunnel USB, ce qui est toujours le cas pour un iPhone. Les deux peuvent être actives en même temps : l'USB est essayé d'abord et Internet sert de repli. Il faut Internet sur le PC et sur le téléphone ; sans lui, tout reste sur le réseau local et la caméra, le micro, les capteurs de mouvement et la localisation cessent de fonctionner.</x:String>

    <!-- Licensing &amp; Subscription -->
    <x:String x:Key="Settings_LicensingCardTitle">Licence et abonnement</x:String>
    <x:String x:Key="Settings_LicenseKey">Clé de licence</x:String>
    <x:String x:Key="Settings_LicenseKeyWatermark">Saisissez votre clé de licence Lemon Squeezy</x:String>
    <x:String x:Key="Settings_ValidateActivate">Valider et activer</x:String>
    <x:String x:Key="Settings_ManageLicense">Gérer la licence</x:String>
    <x:String x:Key="Settings_FreeTierStatus">Formule gratuite ({0}/10 scans utilisés)</x:String>
    <x:String x:Key="Settings_ProTierStatus">Formule Pro (active)</x:String>
    <x:String x:Key="Settings_ActivationSuccess">Licence activée. Le scan illimité est désormais disponible.</x:String>
    <x:String x:Key="Settings_ActivationFailed">Échec de l'activation : {0}</x:String>
    <x:String x:Key="Settings_ActivationInvalid">Clé de licence invalide.</x:String>
    <x:String x:Key="Settings_ActivationExpired">Cette licence a expiré.</x:String>
    <x:String x:Key="Settings_ActivationDeactivated">Cette licence a été désactivée.</x:String>
    <x:String x:Key="Settings_ActivationError">Erreur réseau. Veuillez réessayer plus tard.</x:String>
    <x:String x:Key="Settings_ActivationLimitReached">Cette clé est limitée à un certain nombre d'ordinateurs, tous déjà en service. Libérez un ordinateur sur un autre poste, ou achetez une offre avec plus de postes.</x:String>

    <!-- Licensing: introduction screen and the status pill in the title bar -->
    <x:String x:Key="Intro_Title">Bienvenue dans PhoneGrade</x:String>
    <x:String x:Key="Intro_Subtitle">Commencez avec la formule gratuite : 10 scans, aucun compte requis. Pro supprime la limite dès que vous en avez besoin.</x:String>
    <x:String x:Key="Intro_FreeTierTitle">Gratuit</x:String>
    <x:String x:Key="Intro_FreeTierBody">10 scans. Le statut dans la barre de titre indique toujours combien il vous en reste.</x:String>
    <x:String x:Key="Intro_ProTierTitle">Pro</x:String>
    <x:String x:Key="Intro_ProTierBody">Scans illimités sur chaque appareil que vous connectez.</x:String>
    <x:String x:Key="Intro_ProBadge">Illimité</x:String>
    <x:String x:Key="Intro_StartFree">Commencer gratuitement</x:String>
    <x:String x:Key="Intro_PageWelcome">Langue et apparence</x:String>
    <x:String x:Key="Intro_WelcomeLead">Réglez ceci une seule fois. Les deux se modifient plus tard dans les Paramètres.</x:String>
    <x:String x:Key="Intro_PagePlan">Ce que la formule gratuite vous offre</x:String>
    <x:String x:Key="Intro_PageWorkflow">Comment se déroule une inspection</x:String>
    <x:String x:Key="Intro_WorkflowLead">Quatre étapes, les mêmes à chaque fois. Seul le test interactif nécessite le téléphone.</x:String>
    <x:String x:Key="Intro_StepPlug">Branchez le téléphone en USB et déverrouillez-le</x:String>
    <x:String x:Key="Intro_StepRead">PhoneGrade lit lui-même le matériel et affiche ce qu'il a trouvé</x:String>
    <x:String x:Key="Intro_StepTest">Scannez le code QR avec le téléphone pour tester la caméra, l'écran, les capteurs et l'audio</x:String>
    <x:String x:Key="Intro_StepFinish">Choisissez la qualité, imprimez l'étiquette et rendez le téléphone</x:String>
    <x:String x:Key="Intro_PageImei">Contrôles du verrouillage opérateur et de la blacklist</x:String>
    <x:String x:Key="Intro_Next">Suivant</x:String>
    <x:String x:Key="Intro_Back">Retour</x:String>
    <x:String x:Key="Intro_Skip">Passer</x:String>
    <x:String x:Key="Intro_SeePricing">Voir les tarifs</x:String>
    <x:String x:Key="Intro_HaveLicense">J'ai déjà une licence</x:String>
    <x:String x:Key="Intro_ActivationTitle">Activez votre licence</x:String>
    <x:String x:Key="Licensing_TierFree">{0} scans restants</x:String>
    <x:String x:Key="Licensing_TierPro">Pro - actif</x:String>
    <x:String x:Key="Licensing_PanelHint">Licence et scans</x:String>
    <x:String x:Key="Licensing_PanelTitle">Licence</x:String>
    <x:String x:Key="Licensing_PanelScansLeft">Scans restants</x:String>
    <x:String x:Key="Licensing_PanelClose">Fermer</x:String>
    <x:String x:Key="Licensing_PanelSeatsUsed">{0} ordinateurs sur {1} en service</x:String>
    <x:String x:Key="Licensing_PanelSeatThis">Cet ordinateur ({0})</x:String>
    <x:String x:Key="Licensing_PanelSeatsLabel">Ordinateurs</x:String>
    <x:String x:Key="Licensing_PanelNoMachineId">Cet ordinateur ne peut pas être identifié, aucune licence ne peut donc être activée ici. Les scans gratuits restent disponibles.</x:String>
    <x:String x:Key="Licensing_PanelRelease">Libérer cet ordinateur</x:String>
    <x:String x:Key="Licensing_PanelReleaseConfirm">Vraiment le libérer ?</x:String>
    <x:String x:Key="Licensing_PanelReleaseCancel">Le conserver</x:String>
    <x:String x:Key="Licensing_PanelReleaseHint">Libère cet ordinateur pour qu'un autre puisse utiliser la même clé. Vous pourrez réactiver la clé ensuite.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDone">Cet ordinateur a été libéré. Vous restez sur la formule gratuite tant que vous n'avez pas réactivé la clé.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDoneAlready">Cet ordinateur n'était déjà plus enregistré avec cette clé. Vous êtes sur la formule gratuite.</x:String>

    <x:String x:Key="Btn_Troubleshoot">Diagnostic USB et pilotes</x:String>
    <x:String x:Key="Btn_Logs">Voir les journaux système</x:String>
    
    <!-- Summary / Inspection Report -->
    <x:String x:Key="Summary_Title">RAPPORT D'INSPECTION</x:String>
    <x:String x:Key="Summary_AuditTitle">AUDIT DES COMPOSANTS MATÉRIELS 3UTOOLS</x:String>
    <x:String x:Key="Summary_AuditSubtitle">Comparaison valeur usine et valeur lue</x:String>
    <x:String x:Key="Summary_ColComponent">Composant</x:String>
    <x:String x:Key="Summary_ColPart">Pièce</x:String>
    <x:String x:Key="Summary_ColFactory">Valeur usine</x:String>
    <x:String x:Key="Summary_ColRead">Valeur lue</x:String>
    <!-- The audit rows are far narrower than the report, so the two columns get
         their own short labels; the full ones would be cut in the middle. -->
    <x:String x:Key="Active_ColFactory">Valeur usine</x:String>
    <x:String x:Key="Active_ColRead">Valeur lue</x:String>
    <x:String x:Key="Summary_ColStatus">Statut</x:String>
    <x:String x:Key="Summary_BtnPrint">IMPRIMER L'ÉTIQUETTE DYMO</x:String>
    <x:String x:Key="Summary_BtnRetest">Retester</x:String>
    <x:String x:Key="Summary_BtnNext">Appareil suivant (Terminé)</x:String>
    <x:String x:Key="Summary_SimLockFree">Déverrouillé (sans SIM)</x:String>
    <x:String x:Key="Summary_SimLocked">SIM verrouillée</x:String>

    <!-- ============ Export and printing ============ -->
    <!-- The panel an operator reaches from the inspection report. It is the only
         place that knows about labels, reports and the raw numbers, so the summary
         screen's button opens it and nothing else writes a file. -->
    <x:String x:Key="Export_Title">Exporter et imprimer</x:String>
    <x:String x:Key="Export_Lead">Enregistrez l'étiquette, le rapport et les valeurs, ou imprimez l'étiquette tout de suite.</x:String>
    <x:String x:Key="Export_PreviewTitle">Aperçu de l'étiquette</x:String>
    <x:String x:Key="Export_PreviewNote">Dessiné à partir des mêmes valeurs que le fichier. Ce qui manque s'affiche comme un espace réservé.</x:String>
    <x:String x:Key="Export_PreviewScaled">Dessiné plus petit que l'étiquette pour tenir ici. Les proportions sont bonnes ; la taille non.</x:String>
    <x:String x:Key="Export_Stock">Supports d'étiquettes</x:String>
    <x:String x:Key="Export_StockNote">Le rouleau dans l'imprimante, désigné par sa référence.</x:String>
    <x:String x:Key="Export_StockPart">Référence {0}</x:String>
    <x:String x:Key="LabelStock_1982991">Étiquette adresse 89 x 28 mm</x:String>
    <x:String x:Key="LabelStock_1983172">Grande étiquette adresse 89 x 36 mm</x:String>
    <x:String x:Key="LabelStock_30334">Polyvalente 57 x 32 mm</x:String>
    <x:String x:Key="LabelStock_30336">Petite polyvalente 54 x 25 mm</x:String>
    <x:String x:Key="LabelStock_30256">Grande étiquette d'expédition 102 x 59 mm</x:String>
    <x:String x:Key="LabelStock_1933081">Étiquette étagère résistante 89 x 25 mm</x:String>
    <x:String x:Key="Export_BarcodeTitle">Code-barres</x:String>
    <x:String x:Key="Export_BarcodeNote">Ce que porte le code-barres. Deux codes utilisent deux bandes de l'étiquette, ce qui laisse moins de place au texte.</x:String>
    <x:String x:Key="Export_BarcodeIdentifier">Identifiant seul</x:String>
    <x:String x:Key="Export_BarcodeIdentifierNote">Un code avec le numéro de série. L'étiquette se lit comme une étiquette de prix, et c'est ce que cherche une caisse.</x:String>
    <x:String x:Key="Export_BarcodeSplit">Deux codes</x:String>
    <x:String x:Key="Export_BarcodeSplitNote">Le numéro de série sur un code, le stockage, la qualité et la batterie sur un autre, les deux sur l'étiquette.</x:String>
    <x:String x:Key="Export_BarcodeCombined">Un code, les deux</x:String>
    <x:String x:Key="Export_BarcodeCombinedNote">Un code qui porte à la fois le numéro de série et les caractéristiques.</x:String>
    <x:String x:Key="Export_BarcodeNone">Pas de code-barres</x:String>
    <x:String x:Key="Export_BarcodeNoneNote">Pour un magasin dont le scanner ne sait pas en lire. L'étiquette porte alors uniquement ses mots.</x:String>
    <x:String x:Key="Export_BarcodeUnavailable">Trop large pour &#039;&#039;tre imprim&#233; en barres sur ce rouleau. Choisissez un rouleau plus large, ou un type de code-barres qui y tient.</x:String>
    <x:String x:Key="Export_SymbologyTitle">Type de code-barres</x:String>
    <x:String x:Key="Export_Symbology39">Code 39</x:String>
    <x:String x:Key="Export_Symbology39Note">Ce que lise d&#233;j&#224; toute caisse et tout scanner d&#039;une t&#233;l&#233;phonie. Il porte les majuscules et quelques symboles, si bien qu&#039;un nom de mod&#232;le arrive sur le code en tirets.</x:String>
    <x:String x:Key="Export_Symbology128">Code 128</x:String>
    <x:String x:Key="Export_Symbology128Note">Plus dense, si bien qu&#039;un seul code porte le num&#233;ro de s&#233;rie et les caract&#233;ristiques ensemble, l&#224; o&#249; Code39 ne le peut pas. Votre scanner doit &#234;tre r&#233;gl&#233; pour le lire.</x:String>


 
 
 
 
 
    <x:String x:Key="Export_LabelShowTitle">Sur l'étiquette</x:String>
    <x:String x:Key="Export_LabelShowCycles">Nombre de cycles</x:String>
    <x:String x:Key="Export_LabelShowCyclesNote">Combien de fois la batterie a été chargée, ce qu'un pourcentage ne peut pas dire.</x:String>
    <x:String x:Key="Export_LabelShowFaults">Anomalies</x:String>
    <x:String x:Key="Export_LabelShowFaultsNote">Une liste comptée de ce qui ne va pas, par exemple 2x écran non OEM.</x:String>
    <x:String x:Key="Export_LabelShowLocks">FRP et verrouillage d'activation</x:String>
    <x:String x:Key="Export_LabelShowLocksNote">Imprimé en plus grand caractère dès que l'un des deux est actif. Désactiver cette option supprime la ligne qui empêche de vendre un téléphone verrouillé.</x:String>
    <x:String x:Key="Export_LabelPreviewTitle">L'étiquette</x:String>
    <x:String x:Key="Export_LabelPreviewNote">Dessinée à la taille du rouleau ci-dessus, à partir des mêmes valeurs que le fichier.</x:String>
    <x:String x:Key="Export_LabelTooNarrow">Le numéro de série est trop long pour un code-barres sur ce support, il est donc imprimé en texte.</x:String>
    <x:String x:Key="Export_LabelNoBarcode">Pas de code-barres sur cette étiquette.</x:String>
    <x:String x:Key="Export_FormatsTitle">Ce qui doit être écrit</x:String>
    <x:String x:Key="Export_FormatsNote">Tout ce qui est coché est écrit en une seule fois, et chaque fichier est indiqué séparément.</x:String>
    <x:String x:Key="Export_Printer">Imprimante</x:String>
    <x:String x:Key="Export_PrintDialog">Fenêtre d'impression du système</x:String>
    <x:String x:Key="Export_PrinterReady">prête</x:String>
    <x:String x:Key="Export_PrinterBusy">occupée</x:String>
    <x:String x:Key="Export_NoPrinters">Aucune imprimante trouvée. Utilisez la fenêtre d'impression du système.</x:String>
    <x:String x:Key="Export_ScanPrinters">Rechercher des imprimantes</x:String>
    <x:String x:Key="Export_Copies">Exemplaires</x:String>
    <x:String x:Key="Export_BtnWrite">Écrire la sélection</x:String>
    <x:String x:Key="Export_BtnPrintLabel">Imprimer l'étiquette</x:String>
    <x:String x:Key="Export_BtnOpenFolder">Ouvrir le dossier</x:String>
    <x:String x:Key="Export_FolderLabel">Dossier</x:String>
    <x:String x:Key="Export_ResultsTitle">Écrits</x:String>
    <x:String x:Key="Export_BtnOpen">Ouvrir</x:String>
    <x:String x:Key="Export_BtnPrintOne">Imprimer</x:String>
    <x:String x:Key="Export_Close">Fermer</x:String>
    <x:String x:Key="Export_Busy">Traitement...</x:String>

    <!-- The formats, named and described. The note is what stops somebody
         picking by extension: a JSON file and a CSV file are both "the numbers". -->
    <x:String x:Key="Export_FormatDymo">Étiquette DYMO</x:String>
    <x:String x:Key="Export_FormatDymoNote">.dymo pour DYMO Label et pour l'impression directe sur une DYMO.</x:String>
    <x:String x:Key="Export_FormatLabelPdf">Étiquette en PDF</x:String>
    <x:String x:Key="Export_FormatLabelPdfNote">La même étiquette en PDF, pour toute imprimante sur chacun des trois systèmes.</x:String>
    <x:String x:Key="Export_FormatReportPdf">Rapport complet en PDF</x:String>
    <x:String x:Key="Export_FormatReportPdfNote">Toutes les valeurs lues, avec le verdict en haut. Pour archiver ou montrer à un client.</x:String>
    <x:String x:Key="Export_FormatJson">Valeurs brutes en JSON</x:String>
    <x:String x:Key="Export_FormatJsonNote">Tout ce que l'appareil a signalé, avec la version. Pour votre propre système.</x:String>
    <x:String x:Key="Export_FormatCsv">Valeurs brutes en CSV</x:String>
    <x:String x:Key="Export_FormatCsvNote">Les mêmes valeurs, une ligne par champ, pour un tableur.</x:String>
    <x:String x:Key="Export_NameOf">Format</x:String>
    <x:String x:Key="Export_PrintFailed">L'étiquette n'a pas pu être écrite, rien n'a donc été imprimé.</x:String>
    <x:String x:Key="Status_Exporting">Écriture des fichiers...</x:String>
    <x:String x:Key="Status_ExportDone">{0} fichier(s) écrit(s) dans {1}</x:String>
    <x:String x:Key="Status_ExportPartly">{0} sur {1} écrits dans {3}. {2} n'a pas pu être écrit : voir la ligne au-dessus.</x:String>
    <x:String x:Key="Status_DymoSent">Étiquette envoyée à la DYMO. La DYMO signale le travail comme accepté, pas comme imprimé.</x:String>
    <x:String x:Key="Status_DymoRefused">La DYMO n'a pas accepté l'étiquette : {0}</x:String>

    <!-- What a failed export, a note on a written one, or a print says. Read at the
         moment something went wrong, so it comes from here rather than from the
         code that detected it. -->
    <x:String x:Key="Status_TemplateMissing">Le modèle d'étiquette {0} est introuvable. Choisissez-en un autre dans les Paramètres, ou effacez le réglage pour utiliser le modèle fourni avec l'application.</x:String>
    <x:String x:Key="Status_TemplateUnreadable">Le modèle d'étiquette situé dans {0} n'a pas pu être lu : {1}</x:String>
    <x:String x:Key="Status_NoTemplateFound">Aucun modèle d'étiquette ({0}) trouvé. Recherche dans : {1}</x:String>
    <x:String x:Key="Status_TemplateHasNoFields">Le modèle d'étiquette ne contient aucun des champs que cette application remplit, toutes les étiquettes sortiraient donc identiques. Rouvrez le modèle fourni avec l'application.</x:String>
    <x:String x:Key="Status_WriteFailed">L'écriture du fichier {0} a échoué : {1}</x:String>
    <x:String x:Key="Status_UnfilledFields">Le modèle demande aussi {0}, que rien ne remplit.</x:String>
    <x:String x:Key="Status_BarcodeReplaced">Les caractères que le code-barres ne peut pas porter ont été remplacés par un tiret, et le texte est imprimé à côté.</x:String>
    <x:String x:Key="Status_BarcodeWrapped">Des astérisques ont été ajoutés pour que le code-barres puisse être relu.</x:String>
    <x:String x:Key="Status_NoFileAt">Il n'y a aucun fichier dans {0}.</x:String>
    <x:String x:Key="Status_NoFolderAt">Il n'y a aucun dossier dans {0}.</x:String>
    <x:String x:Key="Status_NoPrinterChosen">Aucune imprimante n'a été choisie.</x:String>
    <x:String x:Key="Status_PrintDialogOpened">Envoyé à la fenêtre d'impression.</x:String>
    <x:String x:Key="Status_PrintNoHandler">Aucun gestionnaire d'impression n'est installé, le fichier a donc été ouvert à la place. Imprimez-le depuis là.</x:String>
    <x:String x:Key="Status_PrintPreviewOpened">Ouvert dans l'aperçu. Imprimez-le depuis là.</x:String>
    <x:String x:Key="Status_PrintDefaultApp">Ouvert dans l'application par défaut. Imprimez-le depuis là.</x:String>
    <x:String x:Key="Status_PrintNotStarted">L'impression n'a pas pu démarrer : {0}</x:String>
    <x:String x:Key="Status_PrintQueueNeedsDialog">Choisir une imprimante par son nom demande une fenêtre d'impression sous Windows. Utilisez Imprimer.</x:String>
    <x:String x:Key="Status_PrintSentToQueue">Envoyé à {0}.</x:String>
    <x:String x:Key="Status_PrintToQueueFailed">L'impression vers {0} a échoué : {1}</x:String>
    <x:String x:Key="Status_FolderOpened">Dossier ouvert.</x:String>
    <x:String x:Key="Status_FolderNotOpened">Le dossier n'a pas pu être ouvert : {0}</x:String>
    <x:String x:Key="Status_FileOpened">Ouvert.</x:String>
    <x:String x:Key="Status_FileNotOpened">Le fichier n'a pas pu être ouvert : {0}</x:String>

