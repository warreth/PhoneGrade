    <!-- IMEI Check Labels (per check price) -->
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmiPrice">$0.360</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimplePrice">$0.200</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumPrice">$0.420</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxPrice">$0.600</x:String>

    <!-- IMEI check names and descriptions -->
    <x:String x:Key="Settings_SecImeiApi">Configuration de l'API IMEI</x:String>
    <x:String x:Key="Settings_ImeiInfoApiKeyWatermark">Collez ici votre clé API (par exemple e0d7c26f-5cc7-5644-863c-8992083dfeac)</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmi">APPLE: Carrier &amp; Lock Status &amp; FMI</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmiDesc">$0.360 - Renvoie le nom de l'opérateur, l'état du verrouillage SIM et l'état de Find My iPhone (FMI) pour les appareils Apple.</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimple">BLACKLIST: Simple Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimpleDesc">$0.200 - Renvoie uniquement l'état de base de la blacklist (propre ou blacklisté).</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremium">BLACKLIST: Premium Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumDesc">$0.420 - Renvoie des informations détaillées : IMEI, nom du modèle, fabricant, numéro de modèle, blacklisté par, blacklisté le, motif du blacklist, état du blacklist, pays de blacklist, état de la liste générale.</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnox">GENERIC: Samsung Info Check &amp; Knox Info</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxDesc">$0.600 - Renvoie les informations de l'appareil Samsung, y compris le modèle, le numéro de série, la garantie et l'état du bit de garantie Knox.</x:String>

    <!-- Introduction screen: IMEI checks (BYOK) -->
    <x:String x:Key="Intro_ImeiTitle">Contrôles IMEI (BYOK)</x:String>
    <x:String x:Key="Intro_ImeiBody">PhoneGrade contrôle le verrouillage opérateur, le FMI, la blacklist et le statut Knox via imei.info. C'est un système Bring Your Own Key : créez un compte sur imei.info, ajoutez des crédits et collez votre propre clé API dans les Paramètres. Chaque contrôle a son propre prix (de $0.200 à $0.600) et vous choisissez ceux qui s'exécutent automatiquement.</x:String>
    <x:String x:Key="Intro_ImeiConfigureButton">Configurer l'API IMEI dans les Paramètres</x:String>
    <x:String x:Key="Settings_ImeiInfoWatermarkDefault">10</x:String>

