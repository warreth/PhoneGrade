<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Window Title -->
    <x:String x:Key="WindowTitle">PhoneGrade</x:String>
    
    <!-- Tab Headers -->
    <x:String x:Key="Tab_Dashboard">Painel</x:String>
    <x:String x:Key="Tab_InteractiveTests">Testes interativos</x:String>
    <x:String x:Key="Tab_Label">Etiqueta</x:String>
    <x:String x:Key="Tab_Settings">Configurações</x:String>
    <x:String x:Key="Tab_Logs">Registros</x:String>
    <x:String x:Key="Tab_Troubleshoot">Diagnóstico</x:String>
    
    <!-- Dashboard Card Titles -->
    <x:String x:Key="Card_Status">STATUS</x:String>
    <x:String x:Key="Card_Device">APARELHO</x:String>
    <x:String x:Key="Card_ComponentAudit">AUDITORIA DE COMPONENTES (OEM)</x:String>
    <x:String x:Key="Card_DiagnosticIssues">PROBLEMAS DE DIAGNÓSTICO</x:String>
    <x:String x:Key="Card_WebRunner">EXECUTOR DE TESTES WEB</x:String>
    
    <!-- Buttons -->
    <x:String x:Key="Btn_StartManual">Iniciar manualmente</x:String>
    <x:String x:Key="Btn_Refresh">Atualizar</x:String>
    <x:String x:Key="Btn_OpenLabel">Abrir a etiqueta</x:String>
    <x:String x:Key="Btn_StartWebRunner">Iniciar o executor web</x:String>
    <x:String x:Key="Btn_StopWebRunner">Parar o executor web</x:String>
    <x:String x:Key="Btn_RunDiagnostics">Executar o diagnóstico</x:String>
    <x:String x:Key="Btn_CopyReport">Copiar o relatório</x:String>
    <x:String x:Key="Btn_ExportReport">Exportar o relatório</x:String>
    <x:String x:Key="Btn_FixAll">Corrigir todos os problemas</x:String>
    <x:String x:Key="Btn_Fix">Corrigir</x:String>
    <x:String x:Key="Btn_Clear">Limpar</x:String>
    <x:String x:Key="Btn_Copy">Copiar</x:String>
    <x:String x:Key="Btn_Export">Exportar</x:String>
    <x:String x:Key="Btn_OpenFolder">Abrir a pasta</x:String>
    
    <!-- Status Messages -->
    <x:String x:Key="Status_Ready">Conecte um iPhone/iPad para começar...</x:String>
    <x:String x:Key="Status_NoDevice">Nenhum aparelho encontrado. Tente outro cabo ou outra porta, ou desbloqueie o aparelho e toque em Confiar.</x:String>
    <x:String x:Key="Status_ToolsMissing">Sem USB: diagnostique o PC</x:String>
    
    <!-- Settings -->
    <x:String x:Key="Settings_Title">CONFIGURAÇÕES</x:String>
    <x:String x:Key="Settings_Theme">Tema</x:String>
    <x:String x:Key="Settings_ThemeDesc">Escuro, claro ou o padrão do sistema</x:String>
    <x:String x:Key="Settings_Language">Idioma</x:String>
    <x:String x:Key="Settings_LanguageDesc">Idioma da interface</x:String>
    <x:String x:Key="Settings_AutoDetect">Detectar ao conectar</x:String>
    <x:String x:Key="Settings_AutoDetectDesc">Iniciar o processo automaticamente quando um aparelho for detectado</x:String>
    <x:String x:Key="Settings_UsbEventMonitoring">Monitoramento de eventos USB</x:String>
    <x:String x:Key="Settings_UsbEventMonitoringDesc">Usar os eventos USB nativos do sistema para detectar o aparelho na hora (Windows WMI, macOS IOKit, Linux udev)</x:String>
    
    <!-- Troubleshoot -->
    <x:String x:Key="Troubleshoot_Title">DETECÇÃO DE APARELHOS E ASSISTENTE DE DRIVERS</x:String>
    <x:String x:Key="Troubleshoot_Desc">Se um aparelho não for reconhecido, verifique o sistema para diagnosticar drivers, permissões ou serviços ausentes.</x:String>
    <x:String x:Key="Troubleshoot_Scanning">Executando o diagnóstico, aguarde...</x:String>
    <x:String x:Key="Troubleshoot_ClickToScan">Clique em Executar o diagnóstico para verificar no sistema as ferramentas USB, os drivers e os aparelhos conectados.</x:String>
    
    <!-- Logs -->
    <x:String x:Key="Logs_SearchPlaceholder">Buscar nos registros...</x:String>
    <x:String x:Key="Logs_FilterDebug">Debug</x:String>
    <x:String x:Key="Logs_FilterInfo">Info</x:String>
    <x:String x:Key="Logs_FilterWarning">Aviso</x:String>
    <x:String x:Key="Logs_FilterError">Erro</x:String>
    
    <!-- Component Status -->
    <x:String x:Key="Component_Read">Lido</x:String>
    <x:String x:Key="Component_Original">Original</x:String>
    <x:String x:Key="Component_Mismatch">Substituído</x:String>
    <x:String x:Key="Component_Untrusted">Não original</x:String>
    <x:String x:Key="Component_Status">Situação</x:String>

    <!-- Words for a value the phone never reported -->
    <x:String x:Key="Value_Unknown">Desconhecido</x:String>
    <x:String x:Key="Value_UnknownDevice">Aparelho desconhecido</x:String>
    <x:String x:Key="Value_BatteryLevel">Carga {0}%</x:String>
    <x:String x:Key="Value_Checking">Verificando...</x:String>
    <x:String x:Key="Value_NotSet">Não definido</x:String>
    <x:String x:Key="Value_NotGraded">Sem classificação</x:String>
    <x:String x:Key="BatteryStatus_Unknown">Situação da bateria desconhecida</x:String>
    <x:String x:Key="BatteryStatus_Good">Boa</x:String>
    <x:String x:Key="BatteryStatus_Overheated">Superaquecida</x:String>
    <x:String x:Key="BatteryStatus_Defective">Com defeito</x:String>
    <x:String x:Key="BatteryStatus_Overvoltage">Sobretensão</x:String>
    <x:String x:Key="BatteryStatus_StorageFault">Falha de armazenamento</x:String>
    <x:String x:Key="BatteryStatus_TooCold">Muito fria</x:String>
    <x:String x:Key="ActivationLock_On">LIGADA (bloqueado)</x:String>
    <x:String x:Key="ActivationLock_Off">DESLIGADA (desbloqueado)</x:String>
    
    <x:String x:Key="Settings_DailyOptions">OPÇÕES DIÁRIAS</x:String>
    <x:String x:Key="Settings_GroupOnArrival">Quando um aparelho chega</x:String>
    <x:String x:Key="Settings_GroupInteractiveTest">O teste interativo</x:String>
    <x:String x:Key="Settings_GroupAfterwards">Depois da inspeção</x:String>
    <x:String x:Key="Settings_Quality">Qualidade padrão</x:String>
    <x:String x:Key="Settings_Payment">Forma de pagamento padrão</x:String>
    <x:String x:Key="Settings_AutoStartWebTest">Iniciar o teste web interativo automaticamente</x:String>
    <x:String x:Key="Settings_RequirePwaTest">Exigir o teste PWA antes de finalizar</x:String>
    <x:String x:Key="Settings_AutoFinishAfterTest">Finalizar automaticamente após o teste</x:String>
    <x:String x:Key="Settings_ShowSummary">Mostrar o resumo antes de imprimir a etiqueta</x:String>
    <x:String x:Key="Settings_Advanced">Automação avançada</x:String>
    <x:String x:Key="Settings_AutoActivate">Ativação automática (bypass)</x:String>
    <x:String x:Key="Settings_RunDiagnostics">Executar o diagnóstico de hardware (logs de pânico)</x:String>
    <x:String x:Key="Settings_Enable85Checker">Verificação de bateria de 85% (etiqueta 100%-X)</x:String>
    <x:String x:Key="Settings_OpenEditor">Abrir o editor de etiqueta antes de imprimir</x:String>
    <x:String x:Key="Settings_Connection">COMO O APARELHO ABRE A PÁGINA</x:String>
    <x:String x:Key="Settings_SecureOrigin">Pelo cabo USB (http://localhost)</x:String>
    <x:String x:Key="Settings_SecureOriginDesc">O aparelho abre a página de teste no próprio PC. O navegador confia nesse endereço, então a câmera, o microfone, os sensores de movimento e a localização funcionam ali. Esta é a opção mais rápida, não precisa de internet e funciona assim que o cabo é conectado. É a rota tentada primeiro.</x:String>
    <x:String x:Key="Settings_PublicTunnel">Pela internet (https, seguro)</x:String>
    <x:String x:Key="Settings_PublicTunnelDesc">O PC abre um endereço https seguro que encaminha para a página de teste, pela Cloudflare. Este é o plano reserva quando não há túnel USB, o que sempre acontece com um iPhone. As duas opções podem ficar ligadas ao mesmo tempo: o USB é tentado primeiro e a internet é o plano reserva. Precisa de internet no PC e no aparelho; sem isso tudo continua na rede local e a câmera, o microfone, os sensores de movimento e a localização param de funcionar.</x:String>

    <!-- Licensing &amp; Subscription -->
    <x:String x:Key="Settings_LicensingCardTitle">Licenciamento e assinatura</x:String>
    <x:String x:Key="Settings_LicenseKey">Chave de licença</x:String>
    <x:String x:Key="Settings_LicenseKeyWatermark">Digite sua chave de licença do Lemon Squeezy</x:String>
    <x:String x:Key="Settings_ValidateActivate">Validar e ativar</x:String>
    <x:String x:Key="Settings_ManageLicense">Gerenciar a licença</x:String>
    <x:String x:Key="Settings_FreeTierStatus">Plano gratuito ({0}/10 varreduras usadas)</x:String>
    <x:String x:Key="Settings_ProTierStatus">Plano Pro (ativo)</x:String>
    <x:String x:Key="Settings_ActivationSuccess">Licença ativada. A varredura ilimitada já está disponível.</x:String>
    <x:String x:Key="Settings_ActivationFailed">Falha na ativação: {0}</x:String>
    <x:String x:Key="Settings_ActivationInvalid">Chave de licença inválida.</x:String>
    <x:String x:Key="Settings_ActivationExpired">Esta licença expirou.</x:String>
    <x:String x:Key="Settings_ActivationDeactivated">Esta licença foi desativada.</x:String>
    <x:String x:Key="Settings_ActivationError">Erro de rede. Tente novamente mais tarde.</x:String>
    <x:String x:Key="Settings_ActivationLimitReached">Esta chave permite um número limitado de computadores e todos já estão em uso. Libere um computador em outra bancada ou compre um plano com mais vagas.</x:String>

    <!-- Licensing: introduction screen and the status pill in the title bar -->
    <x:String x:Key="Intro_Title">Boas-vindas ao PhoneGrade</x:String>
    <x:String x:Key="Intro_Subtitle">Comece no plano gratuito: 10 varreduras, sem precisar de conta. O Pro remove o limite sempre que você precisar de mais.</x:String>
    <x:String x:Key="Intro_FreeTierTitle">Gratuito</x:String>
    <x:String x:Key="Intro_FreeTierBody">10 varreduras. O status na barra de título sempre mostra quantas ainda restam.</x:String>
    <x:String x:Key="Intro_ProTierTitle">Pro</x:String>
    <x:String x:Key="Intro_ProTierBody">Varreduras ilimitadas em todos os aparelhos que você conectar.</x:String>
    <x:String x:Key="Intro_ProBadge">Ilimitado</x:String>
    <x:String x:Key="Intro_StartFree">Começar de graça</x:String>
    <x:String x:Key="Intro_PageWelcome">Idioma e aparência</x:String>
    <x:String x:Key="Intro_WelcomeLead">Defina uma vez só. As duas opções podem ser alteradas depois em Configurações.</x:String>
    <x:String x:Key="Intro_PagePlan">O que o plano gratuito oferece</x:String>
    <x:String x:Key="Intro_PageWorkflow">Como uma inspeção acontece</x:String>
    <x:String x:Key="Intro_WorkflowLead">Quatro etapas, sempre as mesmas. O teste interativo é o único que precisa do aparelho.</x:String>
    <x:String x:Key="Intro_StepPlug">Conecte o aparelho pelo USB e desbloqueie-o</x:String>
    <x:String x:Key="Intro_StepRead">O PhoneGrade lê o hardware e escreve na tela o que encontrou</x:String>
    <x:String x:Key="Intro_StepTest">Leia o código QR com o aparelho para rodar os testes de câmera, tela, sensores e áudio</x:String>
    <x:String x:Key="Intro_StepFinish">Escolha a nota, imprima a etiqueta e devolva o aparelho</x:String>
    <x:String x:Key="Intro_PageImei">Bloqueio de operadora e lista negra</x:String>
    <x:String x:Key="Intro_Next">Avançar</x:String>
    <x:String x:Key="Intro_Back">Voltar</x:String>
    <x:String x:Key="Intro_Skip">Pular</x:String>
    <x:String x:Key="Intro_SeePricing">Ver preços</x:String>
    <x:String x:Key="Intro_HaveLicense">Já tenho uma licença</x:String>
    <x:String x:Key="Intro_ActivationTitle">Ative sua licença</x:String>
    <x:String x:Key="Licensing_TierFree">{0} varreduras restantes</x:String>
    <x:String x:Key="Licensing_TierPro">Pro - Ativo</x:String>
    <x:String x:Key="Licensing_PanelHint">Licença e varreduras</x:String>
    <x:String x:Key="Licensing_PanelTitle">Licença</x:String>
    <x:String x:Key="Licensing_PanelScansLeft">Varreduras restantes</x:String>
    <x:String x:Key="Licensing_PanelClose">Fechar</x:String>
    <x:String x:Key="Licensing_PanelSeatsUsed">{0} de {1} computadores em uso</x:String>
    <x:String x:Key="Licensing_PanelSeatThis">Este computador ({0})</x:String>
    <x:String x:Key="Licensing_PanelSeatsLabel">Computadores</x:String>
    <x:String x:Key="Licensing_PanelNoMachineId">Este computador não pode ser identificado, então não dá para ativar uma licença aqui. As varreduras gratuitas continuam funcionando.</x:String>
    <x:String x:Key="Licensing_PanelRelease">Liberar este computador</x:String>
    <x:String x:Key="Licensing_PanelReleaseConfirm">Liberar mesmo assim?</x:String>
    <x:String x:Key="Licensing_PanelReleaseCancel">Manter</x:String>
    <x:String x:Key="Licensing_PanelReleaseHint">Libera este computador para que outro possa usar a mesma chave. Depois você pode ativar a chave de novo.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDone">Este computador foi liberado. Você fica no plano gratuito até ativar a chave de novo.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDoneAlready">Este computador não estava mais registrado com a chave. Você está no plano gratuito.</x:String>

    <x:String x:Key="Btn_Troubleshoot">Diagnóstico de USB e drivers</x:String>
    <x:String x:Key="Btn_Logs">Ver os registros do sistema</x:String>
    
    <!-- Summary / Inspection Report -->
    <x:String x:Key="Summary_Title">RELATÓRIO DE INSPEÇÃO</x:String>
    <x:String x:Key="Summary_AuditTitle">AUDITORIA DE COMPONENTES DE HARDWARE 3UTOOLS</x:String>
    <x:String x:Key="Summary_AuditSubtitle">Comparação entre o valor de fábrica e o valor lido</x:String>
    <x:String x:Key="Summary_ColComponent">Componente</x:String>
    <x:String x:Key="Summary_ColPart">Peça</x:String>
    <x:String x:Key="Summary_ColFactory">Valor de fábrica</x:String>
    <x:String x:Key="Summary_ColRead">Valor lido</x:String>
    <!-- The audit rows are far narrower than the report, so the two columns get
         their own short labels; the full ones would be cut in the middle. -->
    <x:String x:Key="Active_ColFactory">Fábrica</x:String>
    <x:String x:Key="Active_ColRead">Lido</x:String>
    <x:String x:Key="Summary_ColStatus">Situação</x:String>
    <x:String x:Key="Summary_BtnPrint">IMPRIMIR ETIQUETA DYMO</x:String>
    <x:String x:Key="Summary_BtnRetest">Testar de novo</x:String>
    <x:String x:Key="Summary_BtnNext">Próximo aparelho (concluído)</x:String>
    <x:String x:Key="Summary_SimLockFree">Desbloqueado (sem SIM)</x:String>
    <x:String x:Key="Summary_SimLocked">SIM bloqueado</x:String>

    <!-- ============ Export and printing ============ -->
    <!-- The panel an operator reaches from the inspection report. It is the only
         place that knows about labels, reports and the raw numbers, so the summary
         screen's button opens it and nothing else writes a file. -->
    <x:String x:Key="Export_Title">Exportar e imprimir</x:String>
    <x:String x:Key="Export_Lead">Salve a etiqueta, o relatório e os números, ou imprima a etiqueta na hora.</x:String>
    <x:String x:Key="Export_PreviewTitle">Prévia da etiqueta</x:String>
    <x:String x:Key="Export_PreviewNote">Desenhada com os mesmos valores do arquivo. O que estiver faltando aparece como marcador.</x:String>
    <x:String x:Key="Export_PreviewScaled">Desenhada menor do que a etiqueta para caber aqui. O formato está certo; o tamanho não.</x:String>
    <x:String x:Key="Export_Stock">Bobina de etiquetas</x:String>
    <x:String x:Key="Export_StockNote">A bobina que está na impressora, pelo número de peça com que foi encomendada.</x:String>
    <x:String x:Key="Export_StockPart">Peça {0}</x:String>
    <x:String x:Key="LabelStock_1982991">Etiqueta de endereço 89 x 28 mm</x:String>
    <x:String x:Key="LabelStock_1983172">Etiqueta de endereço grande 89 x 36 mm</x:String>
    <x:String x:Key="LabelStock_30334">Multiuso 57 x 32 mm</x:String>
    <x:String x:Key="LabelStock_30336">Multiuso pequeno 54 x 25 mm</x:String>
    <x:String x:Key="LabelStock_30256">Envio grande 102 x 59 mm</x:String>
    <x:String x:Key="LabelStock_1933081">Etiqueta resistente para prateleiras 89 x 25 mm</x:String>
    <x:String x:Key="Export_BarcodeTitle">Código de barras</x:String>
    <x:String x:Key="Export_BarcodeNote">O que o código de barras carrega. Dois códigos precisam de duas faixas da etiqueta, o que deixa menos espaço para o texto.</x:String>
    <x:String x:Key="Export_BarcodeIdentifier">Somente o identificador</x:String>
    <x:String x:Key="Export_BarcodeIdentifierNote">Um código com o número de série. A etiqueta fica parecendo uma etiqueta de preço, e é isso que o caixa procura.</x:String>
    <x:String x:Key="Export_BarcodeSplit">Dois códigos</x:String>
    <x:String x:Key="Export_BarcodeSplitNote">O número de série em um código e o armazenamento, a nota e a bateria em outro, ambos na etiqueta.</x:String>
    <x:String x:Key="Export_BarcodeCombined">Um código, com tudo</x:String>
    <x:String x:Key="Export_BarcodeCombinedNote">Um código que carrega o número de série e a especificação juntos.</x:String>
    <x:String x:Key="Export_BarcodeNone">Sem código de barras</x:String>
    <x:String x:Key="Export_BarcodeNoneNote">Para uma loja cujo leitor não consegue ler um. A etiqueta leva o texto e nada mais.</x:String>
    <x:String x:Key="Export_BarcodeUnavailable">Largo demais para imprimir como barras neste rolo. Escolha um rolo mais largo, ou um tipo de c&#243;digo de barras que caiba.</x:String>
    <x:String x:Key="Export_SymbologyTitle">Tipo de c&#243;digo de barras</x:String>
    <x:String x:Key="Export_Symbology39">Code 39</x:String>
    <x:String x:Key="Export_Symbology39Note">O que qualquer caixa e qualquer scanner de uma loja de telem&#243;veis j&#225; l&#234;. Transporta mai&#250;sculas e poucos s&#237;mbolos, por isso um nome de modelo vai para o c&#243;digo como travess&#245;es.</x:String>
    <x:String x:Key="Export_Symbology128">Code 128</x:String>
    <x:String x:Key="Export_Symbology128Note">Mais denso, por isso um s&#243; c&#243;digo pode levar o identificador e as especifica&#231;&#245;es juntos onde o Code39 n&#227;o consegue. O seu scanner tem de estar configurado para o ler.</x:String>


 
 
 
 
 
    <x:String x:Key="Export_LabelShowTitle">Na etiqueta</x:String>
    <x:String x:Key="Export_LabelShowCycles">Número de recargas</x:String>
    <x:String x:Key="Export_LabelShowCyclesNote">Quantas vezes a bateria foi recarregada, o que um percentual não informa.</x:String>
    <x:String x:Key="Export_LabelShowFaults">Defeitos</x:String>
    <x:String x:Key="Export_LabelShowFaultsNote">Uma lista contada do que está errado, como 2x tela não original.</x:String>
    <x:String x:Key="Export_LabelShowLocks">FRP e bloqueio de ativação</x:String>
    <x:String x:Key="Export_LabelShowLocksNote">Impresso em letra maior quando algum deles estiver ligado. Desligar esta opção remove a linha que impede a venda de um aparelho bloqueado.</x:String>
    <x:String x:Key="Export_LabelPreviewTitle">A etiqueta</x:String>
    <x:String x:Key="Export_LabelPreviewNote">Desenhada no tamanho da bobina acima, com os mesmos valores do arquivo.</x:String>
    <x:String x:Key="Export_LabelTooNarrow">O número de série é longo demais para um código de barras nesta bobina, então ele é impresso como texto.</x:String>
    <x:String x:Key="Export_LabelNoBarcode">Sem código de barras nesta etiqueta.</x:String>
    <x:String x:Key="Export_FormatsTitle">O que gravar</x:String>
    <x:String x:Key="Export_FormatsNote">Tudo que estiver marcado é gravado de uma vez, e cada item é relatado separadamente.</x:String>
    <x:String x:Key="Export_Printer">Impressora</x:String>
    <x:String x:Key="Export_PrintDialog">Janela de impressão do sistema</x:String>
    <x:String x:Key="Export_PrinterReady">pronta</x:String>
    <x:String x:Key="Export_PrinterBusy">ocupada</x:String>
    <x:String x:Key="Export_NoPrinters">Nenhuma impressora encontrada. Use a janela de impressão do sistema.</x:String>
    <x:String x:Key="Export_ScanPrinters">Procurar impressoras</x:String>
    <x:String x:Key="Export_Copies">Cópias</x:String>
    <x:String x:Key="Export_BtnWrite">Gravar as selecionadas</x:String>
    <x:String x:Key="Export_BtnPrintLabel">Imprimir a etiqueta</x:String>
    <x:String x:Key="Export_BtnOpenFolder">Abrir a pasta</x:String>
    <x:String x:Key="Export_FolderLabel">Em</x:String>
    <x:String x:Key="Export_ResultsTitle">Gravados</x:String>
    <x:String x:Key="Export_BtnOpen">Abrir</x:String>
    <x:String x:Key="Export_BtnPrintOne">Imprimir</x:String>
    <x:String x:Key="Export_Close">Fechar</x:String>
    <x:String x:Key="Export_Busy">Processando...</x:String>

    <!-- The formats, named and described. The note is what stops somebody
         picking by extension: a JSON file and a CSV file are both "the numbers". -->
    <x:String x:Key="Export_FormatDymo">Etiqueta DYMO</x:String>
    <x:String x:Key="Export_FormatDymoNote">.dymo para a DYMO Label e para imprimir direto em uma DYMO.</x:String>
    <x:String x:Key="Export_FormatLabelPdf">Etiqueta em PDF</x:String>
    <x:String x:Key="Export_FormatLabelPdfNote">A mesma etiqueta em PDF, para qualquer impressora em qualquer um dos três sistemas.</x:String>
    <x:String x:Key="Export_FormatReportPdf">Relatório completo em PDF</x:String>
    <x:String x:Key="Export_FormatReportPdfNote">Todos os valores lidos, com o veredito no topo. Para arquivar ou para mostrar a um cliente.</x:String>
    <x:String x:Key="Export_FormatJson">Números brutos em JSON</x:String>
    <x:String x:Key="Export_FormatJsonNote">Tudo o que o aparelho informou, versionado. Para o seu próprio sistema.</x:String>
    <x:String x:Key="Export_FormatCsv">Números brutos em CSV</x:String>
    <x:String x:Key="Export_FormatCsvNote">Os mesmos números, uma linha por campo, para uma planilha.</x:String>
    <x:String x:Key="Export_NameOf">Formato</x:String>
    <x:String x:Key="Export_PrintFailed">Não foi possível gravar a etiqueta, então nada foi impresso.</x:String>
    <x:String x:Key="Status_Exporting">Gravando os arquivos...</x:String>
