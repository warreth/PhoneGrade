    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumPrice">$0.420</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxPrice">$0.600</x:String>

    <!-- IMEI check names and descriptions -->
    <x:String x:Key="Settings_SecImeiApi">Configuração da API de IMEI</x:String>
    <x:String x:Key="Settings_ImeiInfoApiKeyWatermark">Cole sua chave de API aqui (por exemplo, e0d7c26f-5cc7-5644-863c-8992083dfeac)</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmi">APPLE: Carrier &amp; Lock Status &amp; FMI</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmiDesc">$0.360 - Retorna o nome da operadora, o status do bloqueio de SIM e o status do Find My iPhone (FMI) para aparelhos Apple.</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimple">BLACKLIST: Simple Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimpleDesc">$0.200 - Retorna apenas o status básico da lista negra (limpo ou na lista negra).</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremium">BLACKLIST: Premium Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumDesc">$0.420 - Retorna informações detalhadas: IMEI, nome do modelo, fabricante, número do modelo, quem colocou na lista, quando, motivo, status da lista negra, país da lista negra, status da lista geral.</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnox">GENERIC: Samsung Info Check &amp; Knox Info</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxDesc">$0.600 - Retorna informações do aparelho Samsung, incluindo modelo, número de série, garantia e o status do bit de garantia do Knox.</x:String>

    <!-- Introduction screen: IMEI checks (BYOK) -->
    <x:String x:Key="Intro_ImeiTitle">Verificações de IMEI (BYOK)</x:String>
    <x:String x:Key="Intro_ImeiBody">O PhoneGrade verifica bloqueio de operadora, FMI, lista negra e status do Knox pelo imei.info. Este é um sistema Bring Your Own Key: crie uma conta no imei.info, adicione créditos e cole sua própria chave de API em Configurações. Cada verificação tem seu próprio preço (de $0.200 a $0.600) e você escolhe quais rodam automaticamente.</x:String>
    <x:String x:Key="Intro_ImeiConfigureButton">Configurar a API de IMEI em Configurações</x:String>
    <x:String x:Key="Settings_ImeiInfoWatermarkDefault">10</x:String>

