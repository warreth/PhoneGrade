<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Window Title -->
    <x:String x:Key="WindowTitle">PhoneGrade</x:String>
    
    <!-- Tab Headers -->
    <x:String x:Key="Tab_Dashboard">Panel</x:String>
    <x:String x:Key="Tab_InteractiveTests">Pruebas interactivas</x:String>
    <x:String x:Key="Tab_Label">Etiqueta</x:String>
    <x:String x:Key="Tab_Settings">Ajustes</x:String>
    <x:String x:Key="Tab_Logs">Registros</x:String>
    <x:String x:Key="Tab_Troubleshoot">Diagnóstico</x:String>
    
    <!-- Dashboard Card Titles -->
    <x:String x:Key="Card_Status">ESTADO</x:String>
    <x:String x:Key="Card_Device">DISPOSITIVO</x:String>
    <x:String x:Key="Card_ComponentAudit">AUDITORÍA DE COMPONENTES OEM</x:String>
    <x:String x:Key="Card_DiagnosticIssues">PROBLEMAS DE DIAGNÓSTICO</x:String>
    <x:String x:Key="Card_WebRunner">EJECUTOR DE PRUEBAS WEB</x:String>
    
    <!-- Buttons -->
    <x:String x:Key="Btn_StartManual">Iniciar manualmente</x:String>
    <x:String x:Key="Btn_Refresh">Actualizar</x:String>
    <x:String x:Key="Btn_OpenLabel">Abrir etiqueta</x:String>
    <x:String x:Key="Btn_StartWebRunner">Iniciar el ejecutor web</x:String>
    <x:String x:Key="Btn_StopWebRunner">Detener el ejecutor web</x:String>
    <x:String x:Key="Btn_RunDiagnostics">Ejecutar diagnóstico</x:String>
    <x:String x:Key="Btn_CopyReport">Copiar informe</x:String>
    <x:String x:Key="Btn_ExportReport">Exportar informe</x:String>
    <x:String x:Key="Btn_FixAll">Corregir todo</x:String>
    <x:String x:Key="Btn_Fix">Corregir</x:String>
    <x:String x:Key="Btn_Clear">Limpiar</x:String>
    <x:String x:Key="Btn_Copy">Copiar</x:String>
    <x:String x:Key="Btn_Export">Exportar</x:String>
    <x:String x:Key="Btn_OpenFolder">Abrir carpeta</x:String>
    
    <!-- Status Messages -->
    <x:String x:Key="Status_Ready">Conecte un iPhone o un iPad para empezar...</x:String>
    <x:String x:Key="Status_NoDevice">No se encontró ningún dispositivo. Pruebe otro cable o puerto, o desbloquee el dispositivo y toque Confiar.</x:String>
    <x:String x:Key="Status_ToolsMissing">Sin USB: ejecute el diagnóstico</x:String>
    
    <!-- Settings -->
    <x:String x:Key="Settings_Title">AJUSTES</x:String>
    <x:String x:Key="Settings_Theme">Tema</x:String>
    <x:String x:Key="Settings_ThemeDesc">Oscuro, claro o según el sistema</x:String>
    <x:String x:Key="Settings_Language">Idioma</x:String>
    <x:String x:Key="Settings_LanguageDesc">Idioma de la interfaz</x:String>
    <x:String x:Key="Settings_IntroTitle">Introducción</x:String>
    <x:String x:Key="Settings_IntroDesc">Vuelve a ver el tutorial de bienvenida. Los ajustes que ya elegiste se mantienen.</x:String>
    <x:String x:Key="Settings_IntroReplay">Mostrar introducción</x:String>
    <x:String x:Key="Settings_AutoDetect">Detección automática al conectar</x:String>
    <x:String x:Key="Settings_AutoDetectDesc">Iniciar el proceso automáticamente cuando se detecte un dispositivo</x:String>
    <x:String x:Key="Settings_UsbEventMonitoring">Supervisión de eventos USB</x:String>
    <x:String x:Key="Settings_UsbEventMonitoringDesc">Use los eventos USB nativos del sistema operativo para detectar el dispositivo al instante (Windows WMI, macOS IOKit, Linux udev)</x:String>
    
    <!-- Troubleshoot -->
    <x:String x:Key="Troubleshoot_Title">DETECCIÓN DE DISPOSITIVOS &amp; ASISTENTE DE CONTROLADORES</x:String>
    <x:String x:Key="Troubleshoot_Desc">Si un dispositivo no se reconoce, analice el sistema para diagnosticar los controladores, los permisos o los servicios que falten.</x:String>
    <x:String x:Key="Troubleshoot_Scanning">Ejecutando el diagnóstico, espere...</x:String>
    <x:String x:Key="Troubleshoot_ClickToScan">Pulse Ejecutar diagnóstico para buscar herramientas USB, controladores y dispositivos conectados en el sistema.</x:String>
    
    <!-- Logs -->
    <x:String x:Key="Logs_SearchPlaceholder">Buscar en los registros...</x:String>
    <x:String x:Key="Logs_FilterDebug">Debug</x:String>
    <x:String x:Key="Logs_FilterInfo">Info</x:String>
    <x:String x:Key="Logs_FilterWarning">Advertencia</x:String>
    <x:String x:Key="Logs_FilterError">Error</x:String>
    
    <!-- Component Status -->
    <x:String x:Key="Component_Read">Leído</x:String>
    <x:String x:Key="Component_Original">Original</x:String>
    <x:String x:Key="Component_Mismatch">Sustituido</x:String>
    <x:String x:Key="Component_Untrusted">No original</x:String>
    <x:String x:Key="Component_Status">Estado</x:String>

    <!-- Words for a value the phone never reported -->
    <x:String x:Key="Value_Unknown">Desconocido</x:String>
    <x:String x:Key="Value_UnknownDevice">Dispositivo desconocido</x:String>
    <x:String x:Key="Value_BatteryLevel">Carga {0}%</x:String>
    <x:String x:Key="Value_Checking">Comprobando...</x:String>
    <x:String x:Key="Value_NotSet">Sin definir</x:String>
    <x:String x:Key="Value_NotGraded">Sin grado</x:String>
    <x:String x:Key="BatteryStatus_Unknown">Estado de la batería desconocido</x:String>
    <x:String x:Key="BatteryStatus_Good">Correcta</x:String>
    <x:String x:Key="BatteryStatus_Overheated">Sobrecalentada</x:String>
    <x:String x:Key="BatteryStatus_Defective">Defectuosa</x:String>
    <x:String x:Key="BatteryStatus_Overvoltage">Sobretensión</x:String>
    <x:String x:Key="BatteryStatus_StorageFault">Fallo de almacenamiento</x:String>
    <x:String x:Key="BatteryStatus_TooCold">Demasiado fría</x:String>
    <x:String x:Key="ActivationLock_On">ACTIVADO (bloqueado)</x:String>
    <x:String x:Key="ActivationLock_Off">DESACTIVADO (desbloqueado)</x:String>
    
    <x:String x:Key="Settings_DailyOptions">OPCIONES DIARIAS</x:String>
    <x:String x:Key="Settings_GroupOnArrival">Cuando llega un dispositivo</x:String>
    <x:String x:Key="Settings_GroupInteractiveTest">La prueba interactiva</x:String>
    <x:String x:Key="Settings_GroupAfterwards">Después de la inspección</x:String>
    <x:String x:Key="Settings_Quality">Grado predeterminado</x:String>
    <x:String x:Key="Settings_Payment">Método de facturación predeterminado</x:String>
    <x:String x:Key="Settings_AutoStartWebTest">Iniciar automáticamente la prueba web interactiva</x:String>
    <x:String x:Key="Settings_RequirePwaTest">Exigir la prueba PWA antes de finalizar</x:String>
    <x:String x:Key="Settings_AutoFinishAfterTest">Finalizar automáticamente después de la prueba</x:String>
    <x:String x:Key="Settings_ShowSummary">Mostrar el resumen antes de imprimir la etiqueta</x:String>
    <x:String x:Key="Settings_Advanced">Automatización avanzada</x:String>
    <x:String x:Key="Settings_AutoActivate">Activación automática (bypass)</x:String>
    <x:String x:Key="Settings_RunDiagnostics">Ejecutar el diagnóstico de hardware (registros de pánico)</x:String>
    <x:String x:Key="Settings_Enable85Checker">Comprobación de batería al 85% (etiqueta 100%-X)</x:String>
    <x:String x:Key="Settings_OpenEditor">Abrir el editor de etiquetas antes de imprimir</x:String>
    <x:String x:Key="Settings_Connection">CÓMO ABRE EL TELÉFONO LA PÁGINA</x:String>
    <x:String x:Key="Settings_SecureOrigin">Por el cable USB (http://localhost)</x:String>
    <x:String x:Key="Settings_SecureOriginDesc">El teléfono abre la página de prueba en el propio PC. Un navegador confía en esa dirección, así que allí funcionan la cámara, el micrófono, los sensores de movimiento y la ubicación. Esta es la vía más rápida de las dos, no necesita internet y funciona en cuanto se conecta el cable. Es la que se intenta primero.</x:String>
    <x:String x:Key="Settings_PublicTunnel">Por internet (https, seguro)</x:String>
    <x:String x:Key="Settings_PublicTunnelDesc">El PC abre una dirección https segura que redirige a la página de prueba a través de Cloudflare. Esta es la alternativa cuando no hay túnel USB, lo que siempre ocurre con un iPhone. Ambas pueden estar activas a la vez: primero se intenta USB y la conexión a internet es la alternativa. Necesita internet en el PC y en el teléfono; sin él todo se queda en la red local y la cámara, el micrófono, los sensores de movimiento y la ubicación dejan de funcionar.</x:String>

    <!-- Licensing &amp; Subscription -->
    <x:String x:Key="Settings_LicensingCardTitle">Licencias y suscripción</x:String>
    <x:String x:Key="Settings_LicenseKey">Clave de licencia</x:String>
    <x:String x:Key="Settings_LicenseKeyWatermark">Introduzca su clave de licencia de Lemon Squeezy</x:String>
    <x:String x:Key="Settings_ValidateActivate">Validar y activar</x:String>
    <x:String x:Key="Settings_ManageLicense">Gestionar la licencia</x:String>
    <x:String x:Key="Settings_FreeTierStatus">Plan gratuito ({0}/10 análisis usados)</x:String>
    <x:String x:Key="Settings_ProTierStatus">Plan Pro (Activo)</x:String>
    <x:String x:Key="Settings_ActivationSuccess">Licencia activada. El análisis ilimitado ya está disponible.</x:String>
    <x:String x:Key="Settings_ActivationFailed">Error en la activación: {0}</x:String>
    <x:String x:Key="Settings_ActivationInvalid">Clave de licencia no válida.</x:String>
    <x:String x:Key="Settings_ActivationExpired">Esta licencia ha caducado.</x:String>
    <x:String x:Key="Settings_ActivationDeactivated">Esta licencia ha sido desactivada.</x:String>
    <x:String x:Key="Settings_ActivationError">Error de red. Vuelva a intentarlo más tarde.</x:String>
    <x:String x:Key="Settings_ActivationLimitReached">Esta clave permite un número limitado de equipos y todos están en uso. Libere un equipo de otro puesto de trabajo o contrate un plan con más.</x:String>

    <!-- Licensing: introduction screen and the status pill in the title bar -->
    <x:String x:Key="Intro_Title">Bienvenido a PhoneGrade</x:String>
    <x:String x:Key="Intro_Subtitle">Empiece con el plan gratuito: 10 análisis y sin necesidad de cuenta. Pro elimina el límite cuando necesite más.</x:String>
    <x:String x:Key="Intro_FreeTierTitle">Gratis</x:String>
    <x:String x:Key="Intro_FreeTierBody">10 análisis. El estado de la barra de título siempre muestra cuántos le quedan.</x:String>
    <x:String x:Key="Intro_ProTierTitle">Pro</x:String>
    <x:String x:Key="Intro_ProTierBody">Análisis ilimitados en cada dispositivo que conecte.</x:String>
    <x:String x:Key="Intro_ProBadge">Ilimitado</x:String>
    <x:String x:Key="Intro_StartFree">Empezar gratis</x:String>
    <x:String x:Key="Intro_PageWelcome">Idioma y apariencia</x:String>
    <x:String x:Key="Intro_WelcomeLead">Configure esto una sola vez. Ambos se pueden cambiar después en Ajustes.</x:String>
    <x:String x:Key="Intro_PagePlan">Lo que ofrece el plan gratuito</x:String>
    <x:String x:Key="Intro_PageWorkflow">Cómo se desarrolla una inspección</x:String>
    <x:String x:Key="Intro_WorkflowLead">Cuatro pasos, siempre los mismos. La prueba interactiva es la única que necesita el teléfono.</x:String>
    <x:String x:Key="Intro_StepPlug">Conecte el teléfono por USB y desbloquéelo</x:String>
    <x:String x:Key="Intro_StepRead">PhoneGrade lee el hardware por sí mismo y escribe en pantalla lo que ha encontrado</x:String>
    <x:String x:Key="Intro_StepTest">Escanee el código QR con el teléfono para ejecutar las pruebas de cámara, pantalla, sensores y audio</x:String>
    <x:String x:Key="Intro_StepFinish">Elija la calificación, imprima la etiqueta y devuelva el teléfono</x:String>
    <x:String x:Key="Intro_PageImei">Comprobaciones de bloqueo de operador y de lista negra</x:String>
    <x:String x:Key="Intro_Next">Siguiente</x:String>
    <x:String x:Key="Intro_Back">Atrás</x:String>
    <x:String x:Key="Intro_Skip">Omitir</x:String>
    <x:String x:Key="Intro_SeePricing">Ver precios</x:String>
    <x:String x:Key="Intro_HaveLicense">Ya tengo una licencia</x:String>
    <x:String x:Key="Intro_ActivationTitle">Active su licencia</x:String>
    <x:String x:Key="Licensing_TierFree">{0} análisis restantes</x:String>
    <x:String x:Key="Licensing_TierPro">Pro - Activo</x:String>
    <x:String x:Key="Licensing_PanelHint">Licencia y análisis</x:String>
    <x:String x:Key="Licensing_PanelTitle">Licencia</x:String>
    <x:String x:Key="Licensing_PanelScansLeft">Análisis restantes</x:String>
    <x:String x:Key="Licensing_PanelClose">Cerrar</x:String>
    <x:String x:Key="Licensing_PanelSeatsUsed">{0} de {1} equipos en uso</x:String>
    <x:String x:Key="Licensing_PanelSeatThis">Este equipo ({0})</x:String>
    <x:String x:Key="Licensing_PanelSeatsLabel">Equipos</x:String>
    <x:String x:Key="Licensing_PanelNoMachineId">Este equipo no se puede identificar, así que aquí no se puede activar ninguna licencia. Los análisis gratuitos siguen funcionando.</x:String>
    <x:String x:Key="Licensing_PanelRelease">Liberar este equipo</x:String>
    <x:String x:Key="Licensing_PanelReleaseConfirm">¿Seguro que desea liberarlo?</x:String>
    <x:String x:Key="Licensing_PanelReleaseCancel">Mantenerlo</x:String>
    <x:String x:Key="Licensing_PanelReleaseHint">Libera este equipo para que otro pueda usar la misma clave. Después podrá activar la clave de nuevo.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDone">Este equipo ha sido liberado. Estará en el plan gratuito hasta que vuelva a activar la clave.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDoneAlready">Este equipo ya no estaba registrado con la clave. Está en el plan gratuito.</x:String>

    <x:String x:Key="Btn_Troubleshoot">Diagnóstico de USB y de controladores</x:String>
    <x:String x:Key="Btn_Logs">Ver los registros del sistema</x:String>
    
    <!-- Summary / Inspection Report -->
    <x:String x:Key="Summary_Title">INFORME DE INSPECCIÓN</x:String>
    <x:String x:Key="Summary_AuditTitle">AUDITORÍA DE COMPONENTES DE HARDWARE 3UTOOLS</x:String>
    <x:String x:Key="Summary_AuditSubtitle">Comparación del valor de fábrica con el valor leído</x:String>
    <x:String x:Key="Summary_ColComponent">Componente</x:String>
    <x:String x:Key="Summary_ColPart">Pieza</x:String>
    <x:String x:Key="Summary_ColFactory">Valor de fábrica</x:String>
    <x:String x:Key="Summary_ColRead">Valor leído</x:String>
    <!-- The audit rows are far narrower than the report, so the two columns get
         their own short labels; the full ones would be cut in the middle. -->
    <x:String x:Key="Active_ColFactory">Valor de fábrica</x:String>
    <x:String x:Key="Active_ColRead">Valor leído</x:String>
    <x:String x:Key="Summary_ColStatus">Estado</x:String>
    <x:String x:Key="Summary_BtnPrint">Finalizar</x:String>
    <x:String x:Key="Summary_BtnRetest">Repetir la prueba</x:String>
    <x:String x:Key="Summary_BtnNext">Siguiente dispositivo (Listo)</x:String>
    <x:String x:Key="Summary_SimLockFree">Desbloqueado (libre de SIM)</x:String>
    <x:String x:Key="Summary_SimLocked">Bloqueo SIM</x:String>

    <!-- ============ Export and printing ============ -->
    <!-- The panel an operator reaches from the inspection report. It is the only
         place that knows about labels, reports and the raw numbers, so the summary
         screen's button opens it and nothing else writes a file. -->
    <x:String x:Key="Export_Title">Finalizar</x:String>
    <x:String x:Key="Export_Lead">Comprueba la etiqueta. Imprimir y guardar se hace de una vez.</x:String>
    <x:String x:Key="Export_PreviewTitle">Vista previa de la etiqueta</x:String>
    <x:String x:Key="Export_PreviewNote">Dibujada con los mismos valores que el archivo, al tamaño del rollo.</x:String>
    <x:String x:Key="Export_PreviewScaled">Se dibuja más pequeño que la etiqueta para que quepa aquí. La proporción es correcta; el tamaño no.</x:String>
    <x:String x:Key="Export_Stock">Bobina de etiquetas</x:String>
    <x:String x:Key="Export_StockNote">La bobina que hay en la impresora, identificada por su número de artículo.</x:String>
    <x:String x:Key="Export_StockPart">Artículo {0}</x:String>
    <x:String x:Key="LabelStock_1982991">Etiqueta de dirección 89 x 28 mm</x:String>
    <x:String x:Key="LabelStock_1983172">Etiqueta de dirección grande 89 x 36 mm</x:String>
    <x:String x:Key="LabelStock_30334">Multiusos 57 x 32 mm</x:String>
    <x:String x:Key="LabelStock_30336">Multiusos pequeña 54 x 25 mm</x:String>
    <x:String x:Key="LabelStock_30256">Envío grande 102 x 59 mm</x:String>
    <x:String x:Key="LabelStock_1933081">Estantería resistente 89 x 25 mm</x:String>
    <x:String x:Key="Export_BarcodeTitle">Código de barras</x:String>
    <x:String x:Key="Export_BarcodeNote">Qué contiene el código de barras. Dos códigos necesitan dos bandas de la etiqueta, lo que deja menos espacio para el texto.</x:String>
    <x:String x:Key="Export_BarcodeIdentifier">Solo el identificador</x:String>
    <x:String x:Key="Export_BarcodeIdentifierNote">Un código con el número de serie. La etiqueta se lee como una etiqueta de precio y esto es lo que busca una caja registradora.</x:String>
    <x:String x:Key="Export_BarcodeSplit">Dos códigos</x:String>
    <x:String x:Key="Export_BarcodeSplitNote">El número de serie en un código y el almacenamiento, la calificación y la batería en otro, ambos en la etiqueta.</x:String>
    <x:String x:Key="Export_BarcodeCombined">Un código, todo</x:String>
    <x:String x:Key="Export_BarcodeCombinedNote">Un código que lleva el número de serie y la especificación juntos.</x:String>
    <x:String x:Key="Export_BarcodeNone">Sin código de barras</x:String>
    <x:String x:Key="Export_BarcodeNoneNote">Para una tienda cuyo escáner no puede leer ninguno. La etiqueta lleva solo su texto y nada más.</x:String>
    <x:String x:Key="Export_BarcodeUnavailable">Demasiado ancho para imprimirlo como barras en este rollo. Elija un rollo m&#225;s ancho o un tipo de c&#243;digo de barras que quepa.</x:String>
    <x:String x:Key="Export_SymbologyTitle">Tipo de c&#243;digo de barras</x:String>
    <x:String x:Key="Export_Symbology39">Code 39</x:String>
    <x:String x:Key="Export_Symbology39Note">Lo que ya leen todas las cajas y los esc&#225;neres de una tienda de m&#243;viles. Admite may&#250;sculas y unos pocos s&#237;mbolos, as&#237; que un nombre de modelo va al c&#243;digo como guiones.</x:String>
    <x:String x:Key="Export_Symbology128">Code 128</x:String>
    <x:String x:Key="Export_Symbology128Note">M&#225;s denso, de modo que un solo c&#243;digo puede llevar el identificador y la especificaci&#243;n juntos donde Code39 no puede. Su esc&#225;ner debe estar configurado para leerlo.</x:String>
    <x:String x:Key="Export_LabelShowCycles">Ciclos de carga</x:String>
    <x:String x:Key="Export_LabelPreviewTitle">La etiqueta</x:String>
    <x:String x:Key="Export_LabelPreviewNote">Se dibuja al tamaño de la bobina anterior, con los mismos valores que el archivo.</x:String>
    <x:String x:Key="Export_LabelTooNarrow">El número de serie es demasiado largo para un código de barras en esta bobina, así que se imprime como texto.</x:String>
    <x:String x:Key="Export_LabelNoBarcode">Sin código de barras en esta etiqueta.</x:String>
    <x:String x:Key="Export_FormatsTitle">Qué escribir</x:String>
    <x:String x:Key="Export_FormatsNote">Todo lo marcado se escribe de una vez y cada archivo se informa por separado.</x:String>
    <x:String x:Key="Export_Printer">Impresora</x:String>
    <x:String x:Key="Export_PrintDialog">Diálogo de impresión del sistema</x:String>
    <x:String x:Key="Export_PrinterReady">preparada</x:String>
    <x:String x:Key="Export_PrinterBusy">ocupada</x:String>
    <x:String x:Key="Export_NoPrinters">No se encontró ninguna impresora. Use el diálogo de impresión del sistema.</x:String>
    <x:String x:Key="Export_ScanPrinters">Buscar impresoras</x:String>
    <x:String x:Key="Export_Copies">Copias</x:String>
    <x:String x:Key="Export_BtnWrite">Escribir lo seleccionado</x:String>
    <x:String x:Key="Export_BtnPrintLabel">Imprimir la etiqueta</x:String>
    <x:String x:Key="Export_BtnOpenFolder">Abrir la carpeta</x:String>
    <x:String x:Key="Export_FolderLabel">En</x:String>
    <x:String x:Key="Export_ResultsTitle">Escritos</x:String>
    <x:String x:Key="Export_BtnOpen">Abrir</x:String>
    <x:String x:Key="Export_BtnPrintOne">Imprimir</x:String>
    <x:String x:Key="Export_Close">Cerrar</x:String>
    <x:String x:Key="Export_Busy">Trabajando...</x:String>

    <!-- The formats, named and described. The note is what stops somebody
         picking by extension: a JSON file and a CSV file are both "the numbers". -->
    <x:String x:Key="Export_FormatDymo">Etiqueta DYMO</x:String>
    <x:String x:Key="Export_FormatDymoNote">.dymo para DYMO Label y para imprimir directamente en una DYMO.</x:String>
    <x:String x:Key="Export_FormatLabelPdf">Etiqueta en PDF</x:String>
    <x:String x:Key="Export_FormatLabelPdfNote">La misma etiqueta en PDF, para cualquier impresora de cualquiera de los tres sistemas.</x:String>
    <x:String x:Key="Export_FormatReportPdf">Informe completo en PDF</x:String>
    <x:String x:Key="Export_FormatReportPdfNote">Todos los valores leídos, con el veredicto arriba. Para archivar o para enseñarle a un cliente.</x:String>
    <x:String x:Key="Export_FormatJson">Datos en JSON</x:String>
    <x:String x:Key="Export_FormatJsonNote">Todo lo que informó el dispositivo, con su versión. Para su propio sistema.</x:String>
    <x:String x:Key="Export_FormatCsv">Datos en CSV</x:String>
    <x:String x:Key="Export_FormatCsvNote">Los mismos datos, una fila por campo, para una hoja de cálculo.</x:String>
    <x:String x:Key="Export_NameOf">Formato</x:String>
    <x:String x:Key="Export_PrintFailed">No se pudo escribir la etiqueta, así que no se imprimió nada.</x:String>
    <x:String x:Key="Status_Exporting">Escribiendo los archivos...</x:String>
    <x:String x:Key="Status_ExportDone">{0} archivo(s) escritos en {1}</x:String>
    <x:String x:Key="Status_ExportPartly">{0} de {1} escritos en {3}. {2} no se pudo escribir: vea la línea anterior.</x:String>
    <x:String x:Key="Status_DymoSent">Etiqueta enviada a la DYMO. La DYMO informa el trabajo como aceptado, no como impreso.</x:String>
    <x:String x:Key="Status_DymoRefused">La DYMO no aceptó la etiqueta: {0}</x:String>

    <!-- What a failed export, a note on a written one, or a print says. Read at the
         moment something went wrong, so it comes from here rather than from the
         code that detected it. -->
    <x:String x:Key="Status_TemplateMissing">La plantilla de etiqueta {0} no está. Elija otra en Ajustes o vacíe el ajuste para usar la plantilla que viene con la aplicación.</x:String>
    <x:String x:Key="Status_TemplateUnreadable">No se pudo leer la plantilla de etiqueta en {0}: {1}</x:String>
    <x:String x:Key="Status_NoTemplateFound">No se encontró ninguna plantilla de etiqueta ({0}). Se buscó en: {1}</x:String>
    <x:String x:Key="Status_TemplateHasNoFields">La plantilla de etiqueta no contiene ninguno de los campos que rellena esta aplicación, así que todas las etiquetas saldrían iguales. Vuelva a abrir la plantilla que viene con la aplicación.</x:String>
    <x:String x:Key="Status_WriteFailed">Error al escribir el archivo {0}: {1}</x:String>
    <x:String x:Key="Status_UnfilledFields">La plantilla también pide {0}, que nada rellena.</x:String>
    <x:String x:Key="Status_BarcodeReplaced">Los caracteres que el código de barras no puede llevar se sustituyeron por un guion y el texto se imprime al lado.</x:String>
    <x:String x:Key="Status_BarcodeWrapped">Se añadieron asteriscos para que el código de barras se pueda leer de nuevo.</x:String>
    <x:String x:Key="Status_NoFileAt">No hay ningún archivo en {0}.</x:String>
    <x:String x:Key="Status_NoFolderAt">No hay ninguna carpeta en {0}.</x:String>
    <x:String x:Key="Status_NoPrinterChosen">No se eligió ninguna impresora.</x:String>
