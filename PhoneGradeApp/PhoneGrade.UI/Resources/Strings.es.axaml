    <!-- IMEI API Settings -->
    <x:String x:Key="Settings_ImeiInfoGuide">Guía de configuración</x:String>
    <x:String x:Key="Settings_ImeiInfoGuideStep1">Cree una cuenta en imei.info</x:String>
    <x:String x:Key="Settings_ImeiInfoGuideStep2">Pulse 'API Manage' en la barra lateral y copie su clave de API (por ejemplo, e0d7c26f-5cc7-5644-863c-8992083dfeac).</x:String>
    <x:String x:Key="Settings_ImeiInfoGuideStep3">Pegue la clave de API en el campo de arriba y pulse Guardar.</x:String>
    <x:String x:Key="Settings_ImeiInfoGuideStep4">Vaya a 'Add Credits' en el sitio web para añadir saldo a su cuenta.</x:String>
    <x:String x:Key="Settings_ImeiInfoWhyTitle">Por qué necesita su propia clave</x:String>
    <x:String x:Key="Settings_ImeiInfoWhy">Las comprobaciones de IMEI se ejecutan contra su propia cuenta de imei.info, así que la clave que pega más abajo es suya y se queda en el archivo de ajustes de este equipo. PhoneGrade no incluye ninguna.</x:String>
    <x:String x:Key="Settings_ImeiInfoWhyCredits">Cada comprobación se cobra al saldo de esa cuenta al precio que aparece junto a ella, así que añada saldo antes de la primera.</x:String>
    <x:String x:Key="Settings_ImeiInfoOpenDashboard">Abrir el panel de imei.info</x:String>
    <x:String x:Key="Settings_ImeiInfoSaveKey">Guardar la clave de API</x:String>
    <x:String x:Key="Settings_ImeiInfoTestKey">Probar la clave de API</x:String>
    <x:String x:Key="Settings_ImeiInfoChecks">Comprobaciones automáticas</x:String>
    <x:String x:Key="Settings_ImeiInfoChecksDesc">Seleccione qué comprobaciones se ejecutan en cada dispositivo. Los precios son por comprobación y en USD.</x:String>
    <x:String x:Key="Settings_ImeiInfoCostCalculator">Calculadora de coste</x:String>
    <x:String x:Key="Settings_ImeiInfoCostCalculatorDesc">Estime el coste mensual según el volumen de dispositivos.</x:String>
    <x:String x:Key="Settings_ImeiInfoAppleDevices">Dispositivos Apple / Mes</x:String>
    <x:String x:Key="Settings_ImeiInfoAndroidDevices">Dispositivos Android / Mes</x:String>
    <x:String x:Key="Settings_ImeiInfoApiKey">Clave de API</x:String>
    <x:String x:Key="Settings_ImeiInfoApiKeyDesc">Su clave de API de imei.info para las comprobaciones automáticas.</x:String>
    <x:String x:Key="Settings_ImeiInfoEstimatedMonthlyCost">Coste mensual estimado: {0} USD</x:String>
    <x:String x:Key="Settings_ImeiInfoEstimatedPerDevice">Coste estimado por dispositivo: {0} USD</x:String>
    <x:String x:Key="Settings_ImeiInfoKeyInvalid">Clave de API no válida: {0}</x:String>
    <x:String x:Key="Settings_ImeiInfoKeyValid">Clave de API válida. Saldo: {0} USD</x:String>
    <x:String x:Key="Settings_ImeiInfoKeyTesting">Probando la clave de API...</x:String>
    <x:String x:Key="Settings_ImeiInfoKeyEmpty">Clave vacía</x:String>
    <x:String x:Key="Settings_ImeiInfoKeyUnknownError">Error desconocido</x:String>
    <x:String x:Key="Settings_ImeiInfoApiKeySaved">Clave de API guardada</x:String>

    <!-- IMEI Check Labels (per check price) -->
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmiPrice">$0.360</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimplePrice">$0.200</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumPrice">$0.420</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxPrice">$0.600</x:String>

    <!-- IMEI check names and descriptions -->
    <x:String x:Key="Settings_SecImeiApi">Configuración de la API de IMEI</x:String>
    <x:String x:Key="Settings_ImeiInfoApiKeyWatermark">Pegue aquí su clave de API (por ejemplo, e0d7c26f-5cc7-5644-863c-8992083dfeac)</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmi">APPLE: Carrier &amp; Lock Status &amp; FMI</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmiDesc">$0.360 - Devuelve el nombre del operador, el estado del bloqueo SIM y el estado de Find My iPhone (FMI) para dispositivos Apple.</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimple">BLACKLIST: Simple Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimpleDesc">$0.200 - Devuelve solo el estado básico de la lista negra (limpio o en lista negra).</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremium">BLACKLIST: Premium Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumDesc">$0.420 - Devuelve información detallada: IMEI, Model Name, Manufacturer, Model Number, Blacklisted By, Blacklisted On, Blacklist Reason, Blacklist Status, Blacklisted Country, General List Status.</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnox">GENERIC: Samsung Info Check &amp; Knox Info</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxDesc">$0.600 - Devuelve información del dispositivo Samsung, incluido el modelo, el número de serie, la garantía y el estado del bit de garantía de Knox.</x:String>

    <!-- Introduction screen: IMEI checks (BYOK) -->
    <x:String x:Key="Intro_ImeiTitle">Comprobaciones de IMEI (BYOK)</x:String>
    <x:String x:Key="Intro_ImeiBody">PhoneGrade comprueba el bloqueo de operador, el FMI, la lista negra y el estado de Knox a través de imei.info. Es un sistema Bring Your Own Key: cree una cuenta en imei.info, añada saldo y pegue su propia clave de API en Ajustes. Cada comprobación tiene su propio precio (de $0.200 a $0.600) y usted elige cuáles se ejecutan automáticamente.</x:String>
    <x:String x:Key="Intro_ImeiConfigureButton">Configurar la API de IMEI en Ajustes</x:String>
    <x:String x:Key="Settings_ImeiInfoWatermarkDefault">10</x:String>

