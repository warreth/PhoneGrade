<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Window Title -->
    <x:String x:Key="WindowTitle">PhoneGrade</x:String>
    
    <!-- Tab Headers -->
    <x:String x:Key="Tab_Dashboard">Dashboard</x:String>
    <x:String x:Key="Tab_InteractiveTests">Interactieve Tests</x:String>
    <x:String x:Key="Tab_Label">Label</x:String>
    <x:String x:Key="Tab_Settings">Instellingen</x:String>
    <x:String x:Key="Tab_Logs">Logs</x:String>
    <x:String x:Key="Tab_Troubleshoot">Troubleshoot</x:String>
    
    <!-- Dashboard Card Titles -->
    <x:String x:Key="Card_Status">STATUS</x:String>
    <x:String x:Key="Card_Device">TOESTEL</x:String>
    <x:String x:Key="Card_ComponentAudit">OEM ONDERDELEN AUDIT</x:String>
    <x:String x:Key="Card_DiagnosticIssues">DIAGNOSTISCHE PROBLEMEN</x:String>
    <x:String x:Key="Card_WebRunner">WEB TEST RUNNER</x:String>
    
    <!-- Buttons -->
    <x:String x:Key="Btn_StartManual">Start handmatig</x:String>
    <x:String x:Key="Btn_Refresh">Verversen</x:String>
    <x:String x:Key="Btn_OpenLabel">Open label</x:String>
    <x:String x:Key="Btn_StartWebRunner">Start Web Runner</x:String>
    <x:String x:Key="Btn_StopWebRunner">Stop Web Runner</x:String>
    <x:String x:Key="Btn_RunDiagnostics">Voer Diagnose Uit</x:String>
    <x:String x:Key="Btn_CopyReport">Kopieer Rapport</x:String>
    <x:String x:Key="Btn_ExportReport">Exporteer Rapport</x:String>
    <x:String x:Key="Btn_FixAll">Los Alles Op</x:String>
    <x:String x:Key="Btn_Fix">Oplossen</x:String>
    <x:String x:Key="Btn_Clear">Wissen</x:String>
    <x:String x:Key="Btn_Copy">Kopieer</x:String>
    <x:String x:Key="Btn_Export">Exporteer</x:String>
    <x:String x:Key="Btn_OpenFolder">Open Map</x:String>
    
    <!-- Status Messages -->
    <x:String x:Key="Status_Ready">Plug een iPhone/iPad in om te starten...</x:String>
    <x:String x:Key="Status_NoDevice">Geen toestel gevonden. Kabel/poort proberen of toestel ontgrendelen en 'Vertrouwen' tikken.</x:String>
    <x:String x:Key="Status_ToolsMissing">Geen USB-tools: diagnose starten</x:String>
    
    <!-- Settings -->
    <x:String x:Key="Settings_Title">INSTELLINGEN</x:String>
    <x:String x:Key="Settings_Theme">Thema</x:String>
    <x:String x:Key="Settings_ThemeDesc">Donker, licht of volgens systeem</x:String>
    <x:String x:Key="Settings_Language">Taal</x:String>
    <x:String x:Key="Settings_LanguageDesc">Interface taal</x:String>
    <x:String x:Key="Settings_AutoDetect">Start automatisch bij insteken</x:String>
    <x:String x:Key="Settings_AutoDetectDesc">Zodra een toestel gedetecteerd wordt, draait het hele proces vanzelf</x:String>
    <x:String x:Key="Settings_UsbEventMonitoring">USB-gebeurtenis monitoring</x:String>
    <x:String x:Key="Settings_UsbEventMonitoringDesc">Gebruik native OS USB-gebeurtenissen voor directe toesteldetectie (Windows WMI, macOS IOKit, Linux udev)</x:String>
    
    <!-- Troubleshoot -->
    <x:String x:Key="Troubleshoot_Title">APPARAAT DETECTIE &amp; DRIVER ASSISTENT</x:String>
    <x:String x:Key="Troubleshoot_Desc">Als een toestel niet wordt herkend, scan het systeem om ontbrekende drivers, permissies of daemons te diagnosticeren.</x:String>
    <x:String x:Key="Troubleshoot_Scanning">Diagnose wordt uitgevoerd, even geduld...</x:String>
    <x:String x:Key="Troubleshoot_ClickToScan">Klik op Voer Diagnose Uit om je systeem te scannen op USB tools, drivers en aangesloten apparaten.</x:String>
    
    <!-- Logs -->
    <x:String x:Key="Logs_SearchPlaceholder">Zoek logs...</x:String>
    <x:String x:Key="Logs_FilterDebug">Debug</x:String>
    <x:String x:Key="Logs_FilterInfo">Info</x:String>
    <x:String x:Key="Logs_FilterWarning">Waarschuwing</x:String>
    <x:String x:Key="Logs_FilterError">Fout</x:String>
    
    <!-- Component Status -->
    <x:String x:Key="Component_Read">Gelezen</x:String>
    <x:String x:Key="Component_Original">Origineel</x:String>
    <x:String x:Key="Component_Mismatch">Vervangen</x:String>
    <x:String x:Key="Component_Untrusted">Niet-origineel</x:String>
    <x:String x:Key="Component_Status">Status</x:String>

    <!-- Words for a value the phone never reported -->
    <x:String x:Key="Value_Unknown">Onbekend</x:String>
    <x:String x:Key="Value_UnknownDevice">Onbekend toestel</x:String>
    <x:String x:Key="Value_BatteryLevel">Lading {0}%</x:String>
    <x:String x:Key="Value_Checking">Controleren...</x:String>
    <x:String x:Key="Value_NotSet">Niet opgegeven</x:String>
    <x:String x:Key="Value_NotGraded">Niet beoordeeld</x:String>
    <x:String x:Key="BatteryStatus_Unknown">Batterijstatus onbekend</x:String>
    <x:String x:Key="BatteryStatus_Good">Goed</x:String>
    <x:String x:Key="BatteryStatus_Overheated">Oververhit</x:String>
    <x:String x:Key="BatteryStatus_Defective">Defect</x:String>
    <x:String x:Key="BatteryStatus_Overvoltage">Overspanning</x:String>
    <x:String x:Key="BatteryStatus_StorageFault">Storing</x:String>
    <x:String x:Key="BatteryStatus_TooCold">Te koud</x:String>
    <x:String x:Key="ActivationLock_On">AAN (gelocked)</x:String>
    <x:String x:Key="ActivationLock_Off">UIT (vrij)</x:String>
    
    <x:String x:Key="Settings_DailyOptions">DAGELIJKSE OPTIES</x:String>
    <x:String x:Key="Settings_GroupOnArrival">Wanneer een toestel aankomt</x:String>
    <x:String x:Key="Settings_GroupInteractiveTest">De interactieve test</x:String>
    <x:String x:Key="Settings_GroupAfterwards">Na de inspectie</x:String>
    <x:String x:Key="Settings_Quality">Standaard Kwaliteit</x:String>
    <x:String x:Key="Settings_Payment">Standaard Factuurmethode</x:String>
    <x:String x:Key="Settings_AutoStartWebTest">Automatisch interactieve webtest starten</x:String>
    <x:String x:Key="Settings_RequirePwaTest">PWA Test Verplicht voor afronden</x:String>
    <x:String x:Key="Settings_AutoFinishAfterTest">Automatisch afronden na test</x:String>
    <x:String x:Key="Settings_ShowSummary">Toon samenvatting voor label printen</x:String>
    <x:String x:Key="Settings_Advanced">Geavanceerde automatisering</x:String>
    <x:String x:Key="Settings_AutoActivate">Automatisch activeren (bypass)</x:String>
    <x:String x:Key="Settings_RunDiagnostics">Hardware diagnose draaien (panic-logs)</x:String>
    <x:String x:Key="Settings_Enable85Checker">85% Batterijcheck (100%-X label)</x:String>
    <x:String x:Key="Settings_OpenEditor">Label editor openen voor printen</x:String>
    <x:String x:Key="Settings_Connection">HOE DE TELEFOON DE PAGINA OPENT</x:String>
    <x:String x:Key="Settings_SecureOrigin">Via USB-kabel (http://localhost)</x:String>
    <x:String x:Key="Settings_SecureOriginDesc">De telefoon opent de testpagina op de pc zelf. Dat adres vertrouwt een browser, dus camera, microfoon, bewegingssensoren en locatie doen er allemaal hun werk. Dit is de snelste van de twee, heeft geen internet nodig en werkt zodra de kabel zit. Deze optie wordt als eerste geprobeerd.</x:String>
    <x:String x:Key="Settings_PublicTunnel">Via internet (https, beveiligd)</x:String>
    <x:String x:Key="Settings_PublicTunnelDesc">De pc opent een beveiligd https-adres dat naar de testpagina doorstuurt, via Cloudflare. Dit is de terugval wanneer de usb-tunnel er niet is, en bij een iPhone is dat altijd zo. Beide mogen aan staan: usb wordt eerst geprobeerd en internet is de terugval. Heeft internet nodig op de pc en op het toestel; zonder internet blijft alles op het lokale netwerk en werken camera, microfoon, bewegingssensoren en locatie niet.</x:String>

    <!-- Licensing & Subscription -->
    <x:String x:Key="Settings_LicensingCardTitle">Licentie en abonnement</x:String>
    <x:String x:Key="Settings_LicenseKey">Licentiesleutel</x:String>
    <x:String x:Key="Settings_LicenseKeyWatermark">Voer uw Lemon Squeezy licentiesleutel in</x:String>
    <x:String x:Key="Settings_ValidateActivate">Valideren en activeren</x:String>
    <x:String x:Key="Settings_ManageLicense">Licentie beheren</x:String>
    <x:String x:Key="Settings_FreeTierStatus">Gratis versie ({0}/10 scans gebruikt)</x:String>
    <x:String x:Key="Settings_ProTierStatus">Pro versie (Actief)</x:String>
    <x:String x:Key="Settings_ActivationSuccess">Licentie geactiveerd. Onbeperkt scannen is nu beschikbaar.</x:String>
    <x:String x:Key="Settings_ActivationFailed">Activering mislukt: {0}</x:String>
    <x:String x:Key="Settings_ActivationInvalid">Ongeldige licentiesleutel.</x:String>
    <x:String x:Key="Settings_ActivationExpired">Deze licentie is verlopen.</x:String>
    <x:String x:Key="Settings_ActivationDeactivated">Deze licentie is gedeactiveerd.</x:String>
    <x:String x:Key="Settings_ActivationError">Netwerkfout. Probeer het later opnieuw.</x:String>
    <x:String x:Key="Settings_ActivationLimitReached">Deze sleutel is beperkt tot een aantal computers en die zijn allemaal in gebruik. Maak een computer op een andere werkplek vrij, of neem een abonnement met meer plaatsen.</x:String>

    <!-- Introductiescherm en de statusmelding bovenaan -->
    <x:String x:Key="Intro_Title">Welkom bij PhoneGrade</x:String>
    <x:String x:Key="Intro_Subtitle">Begin op de gratis versie: 10 scans, geen account nodig. Pro haalt de limiet weg zodra je meer nodig hebt.</x:String>
    <x:String x:Key="Intro_FreeTierTitle">Gratis</x:String>
    <x:String x:Key="Intro_FreeTierBody">10 scans. De status bovenaan laat altijd zien hoeveel je nog hebt.</x:String>
    <x:String x:Key="Intro_ProTierTitle">Pro</x:String>
    <x:String x:Key="Intro_ProTierBody">Onbeperkt scannen op elk toestel dat je aansluit.</x:String>
    <x:String x:Key="Intro_ProBadge">Onbeperkt</x:String>
    <x:String x:Key="Intro_StartFree">Gratis starten</x:String>
    <x:String x:Key="Intro_PageWelcome">Taal en weergave</x:String>
    <x:String x:Key="Intro_WelcomeLead">Kies dit een keer. Beide zijn later aan te passen bij Instellingen.</x:String>
    <x:String x:Key="Intro_PagePlan">Wat de gratis versie je geeft</x:String>
    <x:String x:Key="Intro_PageWorkflow">Hoe een inspectie verloopt</x:String>
    <x:String x:Key="Intro_WorkflowLead">Vier stappen, elke keer hetzelfde. Alleen de interactieve test heeft de telefoon zelf nodig.</x:String>
    <x:String x:Key="Intro_StepPlug">Sluit de telefoon aan via USB en ontgrendel hem</x:String>
    <x:String x:Key="Intro_StepRead">PhoneGrade leest de hardware zelf uit en toont wat het heeft gevonden</x:String>
    <x:String x:Key="Intro_StepTest">Scan de QR-code met de telefoon voor de camera-, scherm-, sensor- en audiotoets</x:String>
    <x:String x:Key="Intro_StepFinish">Kies de kwaliteit, druk het label af en geef de telefoon terug</x:String>
    <x:String x:Key="Intro_PageImei">Carrier lock en blacklist controles</x:String>
    <x:String x:Key="Intro_Next">Volgende</x:String>
    <x:String x:Key="Intro_Back">Terug</x:String>
    <x:String x:Key="Intro_Skip">Overslaan</x:String>
    <x:String x:Key="Intro_SeePricing">Bekijk prijzen</x:String>
    <x:String x:Key="Intro_HaveLicense">Ik heb al een licentie</x:String>
    <x:String x:Key="Intro_ActivationTitle">Activeer je licentie</x:String>
    <x:String x:Key="Licensing_TierFree">{0} scans over</x:String>
    <x:String x:Key="Licensing_TierPro">Pro - Actief</x:String>
    <x:String x:Key="Licensing_PanelHint">Licentie en scans</x:String>
    <x:String x:Key="Licensing_PanelTitle">Licentie</x:String>
    <x:String x:Key="Licensing_PanelScansLeft">Scans resterend</x:String>
    <x:String x:Key="Licensing_PanelClose">Sluiten</x:String>
    <x:String x:Key="Licensing_PanelSeatsUsed">{0} van {1} computers in gebruik</x:String>
    <x:String x:Key="Licensing_PanelSeatThis">Deze computer ({0})</x:String>
    <x:String x:Key="Licensing_PanelSeatsLabel">Computers</x:String>
    <x:String x:Key="Licensing_PanelNoMachineId">Deze computer kan niet worden herkend, dus hier kan geen licentie worden geactiveerd. De gratis scans blijven werken.</x:String>
    <x:String x:Key="Licensing_PanelRelease">Deze computer vrijmaken</x:String>
    <x:String x:Key="Licensing_PanelReleaseConfirm">Echt vrijmaken?</x:String>
    <x:String x:Key="Licensing_PanelReleaseCancel">Behouden</x:String>
    <x:String x:Key="Licensing_PanelReleaseHint">Maakt deze computer vrij zodat een andere dezelfde sleutel kan gebruiken. Je kunt de sleutel daarna opnieuw activeren.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDone">Deze computer is vrijgemaakt. Je bent op de gratis versie tot je de sleutel opnieuw activeert.</x:String>
    <x:String x:Key="Licensing_PanelReleaseDoneAlready">Deze computer stond niet meer bij de sleutel. Je bent op de gratis versie.</x:String>

    <x:String x:Key="Btn_Troubleshoot">USB en Driver Diagnose</x:String>
    <x:String x:Key="Btn_Logs">Systeemlogboeken Bekijken</x:String>

    <!-- Summary / Inspection Report -->
    <x:String x:Key="Summary_Title">INSPECTIERAPPORT</x:String>
    <x:String x:Key="Summary_AuditTitle">3UTOOLS HARDWARE COMPONENTEN AUDIT</x:String>
    <x:String x:Key="Summary_AuditSubtitle">Vergelijking Fabriekswaarde vs Gelezen Waarde</x:String>
    <x:String x:Key="Summary_ColComponent">Onderdeel</x:String>
    <x:String x:Key="Summary_ColPart">Onderdeel</x:String>
    <x:String x:Key="Summary_ColFactory">Fabriekswaarde (Ex-factory)</x:String>
    <x:String x:Key="Summary_ColRead">Gelezen Waarde (Read)</x:String>
    <!-- The audit rows are far narrower than the report, so the two columns get
         their own short labels; the full ones would be cut in the middle. -->
    <x:String x:Key="Active_ColFactory">Fabriekswaarde</x:String>
    <x:String x:Key="Active_ColRead">Gelezen waarde</x:String>
    <x:String x:Key="Summary_ColStatus">Status</x:String>
    <x:String x:Key="Summary_BtnPrint">DYMO LABEL AFDRUKKEN</x:String>
    <x:String x:Key="Summary_BtnRetest">Opnieuw Testen</x:String>
    <x:String x:Key="Summary_BtnNext">Volgend Toestel (Klaar)</x:String>
    <x:String x:Key="Summary_SimLockFree">Vrijgeschakeld (Simlockvrij)</x:String>
    <x:String x:Key="Summary_SimLocked">Simlock Actief</x:String>

    <!-- ============ Exporteren en afdrukken ============ -->
    <!-- Het scherm dat de operator opent vanaf het inspectierapport. Het is de
         enige plek die van labels, rapporten en ruwe getallen weet, dus de knop op
         het rapport opent dit scherm en nergens anders wordt een bestand geschreven. -->
    <x:String x:Key="Export_Title">Exporteren en afdrukken</x:String>
    <x:String x:Key="Export_Lead">Bewaar het label, het rapport en de getallen, of druk het label meteen af.</x:String>
    <x:String x:Key="Export_PreviewTitle">Labelvoorbeeld</x:String>
    <x:String x:Key="Export_PreviewNote">Getekend uit dezelfde waarden als het bestand. Wat ontbreekt staat als plaatshouder.</x:String>
    <x:String x:Key="Export_PreviewScaled">Kleiner getekend dan het label zodat het hier past. De verhouding klopt, het formaat niet.</x:String>
    <x:String x:Key="Export_Stock">Labelvoorraad</x:String>
    <x:String x:Key="Export_StockNote">De rol in de printer, op het artikelnummer waar hij besteld wordt.</x:String>
    <x:String x:Key="Export_StockPart">Artikel {0}</x:String>
    <x:String x:Key="LabelStock_1982991">Adreslabel 89 x 28 mm</x:String>
    <x:String x:Key="LabelStock_1983172">Groot adreslabel 89 x 36 mm</x:String>
    <x:String x:Key="LabelStock_30334">Universeel 57 x 32 mm</x:String>
    <x:String x:Key="LabelStock_30336">Klein universeel 54 x 25 mm</x:String>
    <x:String x:Key="LabelStock_30256">Verzendlabel 102 x 59 mm</x:String>
    <x:String x:Key="LabelStock_1933081">Plankenlabel 89 x 25 mm</x:String>
    <x:String x:Key="Export_BarcodeTitle">Barcode</x:String>
    <x:String x:Key="Export_BarcodeNote">Wat de barcode bevat. Twee codes nemen twee stroken van het label in, waardoor er minder ruimte overblijft voor de tekst.</x:String>
    <x:String x:Key="Export_BarcodeIdentifier">Alleen identificatie</x:String>
    <x:String x:Key="Export_BarcodeIdentifierNote">Eén code met het serienummer. Het label leest als prijskaartje, en dit is wat een kassa zoekt.</x:String>
    <x:String x:Key="Export_BarcodeSplit">Twee codes</x:String>
    <x:String x:Key="Export_BarcodeSplitNote">Het serienummer op de ene code en opslag, grade en batterij op de andere, allebei op het label.</x:String>
    <x:String x:Key="Export_BarcodeCombined">Eén code, alles</x:String>
    <x:String x:Key="Export_BarcodeCombinedNote">Eén code met het serienummer en de specificatie samen.</x:String>
    <x:String x:Key="Export_BarcodeNone">Geen barcode</x:String>
    <x:String x:Key="Export_BarcodeNoneNote">Voor een winkel waarvan de scanner er geen één kan lezen. Het label krijgt alleen zijn woorden.</x:String>
    <x:String x:Key="Export_BarcodeUnavailable">Te breed om als balken op deze rol te drukken. Kies een bredere rol, of een barcodeformaat dat erop past.</x:String>
    <x:String x:Key="Export_SymbologyTitle">Barcodeformaat</x:String>
    <x:String x:Key="Export_Symbology39">Code 39</x:String>
    <x:String x:Key="Export_Symbology39Note">Wat elke kassa en scanner in een telefoonwinkel al leest. Draagt hoofdletters en een handvol tekens, dus een modelnaam komt als streepjes op de code.</x:String>
    <x:String x:Key="Export_Symbology128">Code 128</x:String>
    <x:String x:Key="Export_Symbology128Note">Dichter, dus één code kan het serienummer en de specificatie samen dragen waar Code39 dat niet kan. Je scanner moet erop ingesteld staan.</x:String>
    <x:String x:Key="Export_LabelShowTitle">Op het label</x:String>
    <x:String x:Key="Export_LabelShowCycles">Laadcycli</x:String>
    <x:String x:Key="Export_LabelShowCyclesNote">Hoe vaak de batterij is opgeladen, wat een percentage je niet kan vertellen.</x:String>
    <x:String x:Key="Export_LabelShowFaults">Fouten</x:String>
    <x:String x:Key="Export_LabelShowFaultsNote">Een getelde lijst van wat er mis is, zoals 2x niet-origineel scherm.</x:String>
    <x:String x:Key="Export_LabelShowLocks">FRP en activeringsvergrendeling</x:String>
    <x:String x:Key="Export_LabelShowLocksNote">Wordt in groter letterwerk gedrukt als een van beide aanstaat. Uitzetten haalt de regel weg die verhindert dat een vergrendelde telefoon wordt verkocht.</x:String>
    <x:String x:Key="Export_LabelPreviewTitle">Het label</x:String>
    <x:String x:Key="Export_LabelPreviewNote">Getekend op de maat van de rol hierboven, uit dezelfde waarden als het bestand.</x:String>
    <x:String x:Key="Export_LabelTooNarrow">Het serienummer is te lang voor een barcode op deze voorraad, dus het wordt als tekst gedrukt.</x:String>
    <x:String x:Key="Export_LabelNoBarcode">Geen barcode op dit label.</x:String>
    <x:String x:Key="Export_FormatsTitle">Wat er geschreven wordt</x:String>
    <x:String x:Key="Export_FormatsNote">Alles wat aangevinkt staat wordt in een keer geschreven, en elk bestand wordt apart gemeld.</x:String>
    <x:String x:Key="Export_Printer">Printer</x:String>
    <x:String x:Key="Export_PrintDialog">Afdrukvenster van het systeem</x:String>
    <x:String x:Key="Export_PrinterReady">gereed</x:String>
    <x:String x:Key="Export_PrinterBusy">bezet</x:String>
    <x:String x:Key="Export_NoPrinters">Geen printer gevonden. Gebruik het afdrukvenster van het systeem.</x:String>
    <x:String x:Key="Export_ScanPrinters">Printers zoeken</x:String>
    <x:String x:Key="Export_Copies">Aantal</x:String>
    <x:String x:Key="Export_BtnWrite">Geselecteerde schrijven</x:String>
    <x:String x:Key="Export_BtnPrintLabel">Label afdrukken</x:String>
    <x:String x:Key="Export_BtnOpenFolder">Map openen</x:String>
    <x:String x:Key="Export_FolderLabel">Naar</x:String>
    <x:String x:Key="Export_ResultsTitle">Geschreven</x:String>
    <x:String x:Key="Export_BtnOpen">Openen</x:String>
    <x:String x:Key="Export_BtnPrintOne">Afdrukken</x:String>
    <x:String x:Key="Export_Close">Sluiten</x:String>
    <x:String x:Key="Export_Busy">Bezig...</x:String>

    <!-- De formaten, met een regel erbij. Die regel voorkomt dat iemand op de
         extensie kiest: een JSON-bestand en een CSV-bestand zijn allebei "de
         getallen". -->
    <x:String x:Key="Export_FormatDymo">DYMO-label</x:String>
    <x:String x:Key="Export_FormatDymoNote">.dymo voor DYMO Label en om rechtstreeks naar een DYMO te sturen.</x:String>
    <x:String x:Key="Export_FormatLabelPdf">Label als PDF</x:String>
    <x:String x:Key="Export_FormatLabelPdfNote">Hetzelfde label als PDF, voor elke printer op elk van de drie systemen.</x:String>
    <x:String x:Key="Export_FormatReportPdf">Volledig rapport als PDF</x:String>
    <x:String x:Key="Export_FormatReportPdfNote">Elke gelezen waarde, met het oordeel bovenaan. Om te bewaren of aan een klant te tonen.</x:String>
    <x:String x:Key="Export_FormatJson">Ruwe getallen als JSON</x:String>
    <x:String x:Key="Export_FormatJsonNote">Alles wat het toestel gemeld heeft, met versienummer. Voor uw eigen systeem.</x:String>
    <x:String x:Key="Export_FormatCsv">Ruwe getallen als CSV</x:String>
    <x:String x:Key="Export_FormatCsvNote">Dezelfde getallen, een rij per veld, voor een rekenblad.</x:String>
    <x:String x:Key="Export_NameOf">Formaat</x:String>
    <x:String x:Key="Export_PrintFailed">Het label kon niet worden geschreven, dus er is niets afgedrukt.</x:String>
    <x:String x:Key="Status_Exporting">Bestanden schrijven...</x:String>
    <x:String x:Key="Status_ExportDone">{0} bestand(en) geschreven naar {1}</x:String>
    <x:String x:Key="Status_ExportPartly">{0} van {1} geschreven naar {3}. {2} kon niet worden geschreven: zie de regel hierboven.</x:String>
    <x:String x:Key="Status_DymoSent">Label naar DYMO gestuurd. DYMO meldt de opdracht als aangenomen, niet als afgedrukt.</x:String>
