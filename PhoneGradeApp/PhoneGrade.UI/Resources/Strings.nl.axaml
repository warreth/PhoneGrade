<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Window Title -->
    <x:String x:Key="WindowTitle">PhoneGrade</x:String>
    
    <!-- Tab Headers -->
    <x:String x:Key="Tab_Dashboard">Dashboard</x:String>
    <x:String x:Key="Tab_InteractiveTests">Interactieve Tests</x:String>
    <x:String x:Key="Tab_Label">Label</x:String>
    <x:String x:Key="Tab_Settings">Instellingen</x:String>
    <x:String x:Key="Tab_Logs">Logs</x:String>
    <x:String x:Key="Tab_Troubleshoot">Troubleshoot</x:String>
    
    <!-- Dashboard Card Titles -->
    <x:String x:Key="Card_Status">STATUS</x:String>
    <x:String x:Key="Card_Device">TOESTEL</x:String>
    <x:String x:Key="Card_ComponentAudit">OEM ONDERDELEN AUDIT</x:String>
    <x:String x:Key="Card_DiagnosticIssues">DIAGNOSTISCHE PROBLEMEN</x:String>
    <x:String x:Key="Card_WebRunner">WEB TEST RUNNER</x:String>
    
    <!-- Buttons -->
    <x:String x:Key="Btn_StartManual">Start handmatig</x:String>
    <x:String x:Key="Btn_Refresh">Verversen</x:String>
    <x:String x:Key="Btn_OpenLabel">Open label</x:String>
    <x:String x:Key="Btn_StartWebRunner">Start Web Runner</x:String>
    <x:String x:Key="Btn_StopWebRunner">Stop Web Runner</x:String>
    <x:String x:Key="Btn_RunDiagnostics">Voer Diagnose Uit</x:String>
    <x:String x:Key="Btn_CopyReport">Kopieer Rapport</x:String>
    <x:String x:Key="Btn_ExportReport">Exporteer Rapport</x:String>
    <x:String x:Key="Btn_FixAll">Los Alles Op</x:String>
    <x:String x:Key="Btn_Fix">Oplossen</x:String>
    <x:String x:Key="Btn_Clear">Wissen</x:String>
    <x:String x:Key="Btn_Copy">Kopieer</x:String>
    <x:String x:Key="Btn_Export">Exporteer</x:String>
    <x:String x:Key="Btn_OpenFolder">Open Map</x:String>
    
    <!-- Status Messages -->
    <x:String x:Key="Status_Ready">Plug een iPhone/iPad in om te starten...</x:String>
    <x:String x:Key="Status_NoDevice">Geen toestel gevonden. Kabel/poort proberen of toestel ontgrendelen en 'Vertrouwen' tikken.</x:String>
    <x:String x:Key="Status_ToolsMissing">USB tools ontbreken: noch libimobiledevice noch adb is geinstalleerd of vindbaar in PATH. Open de Troubleshoot tab voor installatie-instructies.</x:String>
    
    <!-- Settings -->
    <x:String x:Key="Settings_Title">INSTELLINGEN</x:String>
    <x:String x:Key="Settings_Theme">Thema</x:String>
    <x:String x:Key="Settings_ThemeDesc">Donker, licht of volgens systeem</x:String>
    <x:String x:Key="Settings_Language">Taal</x:String>
    <x:String x:Key="Settings_LanguageDesc">Interface taal</x:String>
    <x:String x:Key="Settings_AutoDetect">Start automatisch bij insteken</x:String>
    <x:String x:Key="Settings_AutoDetectDesc">Zodra een toestel gedetecteerd wordt, draait het hele proces vanzelf</x:String>
    <x:String x:Key="Settings_ManualScan">Handmatige scan</x:String>
    <x:String x:Key="Settings_ManualScanDesc">Voer een eenmalige toestelscan uit met de legado polling-methode</x:String>
    <x:String x:Key="Settings_UsbEventMonitoring">USB-gebeurtenis monitoring</x:String>
    <x:String x:Key="Settings_UsbEventMonitoringDesc">Gebruik native OS USB-gebeurtenissen voor directe toesteldetectie (Windows WMI, macOS IOKit, Linux udev)</x:String>
    
    <!-- Troubleshoot -->
    <x:String x:Key="Troubleshoot_Title">APPARAAT DETECTIE &amp; DRIVER ASSISTENT</x:String>
    <x:String x:Key="Troubleshoot_Desc">Als een toestel niet wordt herkend, scan het systeem om ontbrekende drivers, permissies of daemons te diagnosticeren.</x:String>
    <x:String x:Key="Troubleshoot_Scanning">Diagnose wordt uitgevoerd, even geduld...</x:String>
    <x:String x:Key="Troubleshoot_ClickToScan">Klik op Voer Diagnose Uit om je systeem te scannen op USB tools, drivers en aangesloten apparaten.</x:String>
    
    <!-- Logs -->
    <x:String x:Key="Logs_SearchPlaceholder">Zoek logs...</x:String>
    <x:String x:Key="Logs_FilterDebug">Debug</x:String>
    <x:String x:Key="Logs_FilterInfo">Info</x:String>
    <x:String x:Key="Logs_FilterWarning">Waarschuwing</x:String>
    <x:String x:Key="Logs_FilterError">Fout</x:String>
    
    <!-- Component Status -->
    <x:String x:Key="Component_Read">Gelezen</x:String>
    <x:String x:Key="Component_Original">Origineel</x:String>
    <x:String x:Key="Component_Mismatch">Vervangen</x:String>
    <x:String x:Key="Component_Untrusted">Niet-origineel</x:String>
    <x:String x:Key="Component_Status">Status</x:String>

    <!-- Words for a value the phone never reported -->
    <x:String x:Key="Value_Unknown">Onbekend</x:String>
    <x:String x:Key="Value_UnknownDevice">Onbekend toestel</x:String>
    <x:String x:Key="Value_BatteryLevel">Lading {0}%</x:String>
    <x:String x:Key="Value_Checking">Controleren...</x:String>
    <x:String x:Key="Value_NotSet">Niet opgegeven</x:String>
    <x:String x:Key="Value_NotGraded">Niet beoordeeld</x:String>
    <x:String x:Key="ActivationLock_On">AAN (gelocked)</x:String>
    <x:String x:Key="ActivationLock_Off">UIT (vrij)</x:String>
    
    <x:String x:Key="Settings_DailyOptions">DAGELIJKSE OPTIES</x:String>
    <x:String x:Key="Settings_Quality">Standaard Kwaliteit</x:String>
    <x:String x:Key="Settings_Payment">Standaard Factuurmethode</x:String>
    <x:String x:Key="Settings_AutoStartWebTest">Automatisch interactieve webtest starten</x:String>
    <x:String x:Key="Settings_RequirePwaTest">PWA Test Verplicht voor afronden</x:String>
    <x:String x:Key="Settings_AutoFinishAfterTest">Automatisch afronden na test</x:String>
    <x:String x:Key="Settings_ShowSummary">Toon samenvatting voor label printen</x:String>
    <x:String x:Key="Settings_Advanced">Geavanceerde automatisering</x:String>
    <x:String x:Key="Settings_AutoActivate">Automatisch activeren (bypass)</x:String>
    <x:String x:Key="Settings_RunDiagnostics">Hardware diagnose draaien (panic-logs)</x:String>
    <x:String x:Key="Settings_Enable85Checker">85% Batterijcheck (100%-X label)</x:String>
    <x:String x:Key="Settings_OpenEditor">Label editor openen voor printen</x:String>
    <x:String x:Key="Settings_Connection">HOE DE TELEFOON DE PAGINA OPENT</x:String>
    <x:String x:Key="Settings_SecureOrigin">Via USB-kabel (http://localhost)</x:String>
    <x:String x:Key="Settings_SecureOriginDesc">De telefoon opent de testpagina op de pc zelf. Dat adres vertrouwt een browser, dus camera, microfoon, bewegingssensoren en locatie doen er allemaal hun werk. Dit is de snelste van de twee, heeft geen internet nodig en werkt zodra de kabel zit. Deze optie wordt als eerste geprobeerd.</x:String>
    <x:String x:Key="Settings_PublicTunnel">Via internet (https, beveiligd)</x:String>
    <x:String x:Key="Settings_PublicTunnelDesc">De pc opent een beveiligd https-adres dat naar de testpagina doorstuurt, via Cloudflare. Dit is de terugval wanneer de usb-tunnel er niet is, en bij een iPhone is dat altijd zo. Beide mogen aan staan: usb wordt eerst geprobeerd en internet is de terugval. Heeft internet nodig op de pc en op het toestel; zonder internet blijft alles op het lokale netwerk en werken camera, microfoon, bewegingssensoren en locatie niet.</x:String>

    <!-- Licensing & Subscription -->
    <x:String x:Key="Settings_LicensingCardTitle">Licentie en abonnement</x:String>
    <x:String x:Key="Settings_LicenseKey">Licentiesleutel</x:String>
    <x:String x:Key="Settings_LicenseKeyWatermark">Voer uw Lemon Squeezy licentiesleutel in</x:String>
    <x:String x:Key="Settings_ValidateActivate">Valideren en activeren</x:String>
    <x:String x:Key="Settings_ManageLicense">Licentie beheren</x:String>
    <x:String x:Key="Settings_FreeTierStatus">Gratis versie ({0}/10 scans gebruikt)</x:String>
    <x:String x:Key="Settings_ProTierStatus">Pro versie (Actief)</x:String>
    <x:String x:Key="Settings_ActivationSuccess">Licentie geactiveerd. Onbeperkt scannen is nu beschikbaar.</x:String>
    <x:String x:Key="Settings_ActivationFailed">Activering mislukt: {0}</x:String>
    <x:String x:Key="Settings_ActivationInvalid">Ongeldige licentiesleutel.</x:String>
    <x:String x:Key="Settings_ActivationExpired">Deze licentie is verlopen.</x:String>
    <x:String x:Key="Settings_ActivationDeactivated">Deze licentie is gedeactiveerd.</x:String>
    <x:String x:Key="Settings_ActivationError">Netwerkfout. Probeer het later opnieuw.</x:String>

    <!-- Introductiescherm en de statusmelding bovenaan -->
    <x:String x:Key="Intro_Title">Welkom bij PhoneGrade</x:String>
    <x:String x:Key="Intro_Subtitle">Begin op de gratis versie: 10 scans, geen account nodig. Pro haalt de limiet weg zodra je meer nodig hebt.</x:String>
    <x:String x:Key="Intro_FreeTierTitle">Gratis</x:String>
    <x:String x:Key="Intro_FreeTierBody">10 scans. De status bovenaan laat altijd zien hoeveel je nog hebt.</x:String>
    <x:String x:Key="Intro_ProTierTitle">Pro</x:String>
    <x:String x:Key="Intro_ProTierBody">Onbeperkt scannen op elk toestel dat je aansluit.</x:String>
    <x:String x:Key="Intro_ProBadge">Onbeperkt</x:String>
    <x:String x:Key="Intro_StartFree">Gratis starten</x:String>
    <x:String x:Key="Intro_SeePricing">Bekijk prijzen</x:String>
    <x:String x:Key="Intro_HaveLicense">Ik heb al een licentie</x:String>
    <x:String x:Key="Intro_ActivationTitle">Activeer je licentie</x:String>
    <x:String x:Key="Licensing_TierFree">{0} scans over</x:String>
    <x:String x:Key="Licensing_TierPro">Pro - Actief</x:String>
    <x:String x:Key="Licensing_PanelHint">Licentie en scans</x:String>
    <x:String x:Key="Licensing_PanelTitle">Licentie</x:String>
    <x:String x:Key="Licensing_PanelScansLeft">Scans resterend</x:String>
    <x:String x:Key="Licensing_PanelClose">Sluiten</x:String>

    <x:String x:Key="Btn_Troubleshoot">USB en Driver Diagnose</x:String>
    <x:String x:Key="Btn_Logs">Systeemlogboeken Bekijken</x:String>

    <!-- Summary / Inspection Report -->
    <x:String x:Key="Summary_Title">INSPECTIERAPPORT</x:String>
    <x:String x:Key="Summary_AuditTitle">3UTOOLS HARDWARE COMPONENTEN AUDIT</x:String>
    <x:String x:Key="Summary_AuditSubtitle">Vergelijking Fabriekswaarde vs Gelezen Waarde</x:String>
    <x:String x:Key="Summary_ColComponent">Onderdeel</x:String>
    <x:String x:Key="Summary_ColFactory">Fabriekswaarde (Ex-factory)</x:String>
    <x:String x:Key="Summary_ColRead">Gelezen Waarde (Read)</x:String>
    <!-- The audit rows are far narrower than the report, so the two columns get
         their own short labels; the full ones would be cut in the middle. -->
    <x:String x:Key="Active_ColFactory">Fabriekswaarde</x:String>
    <x:String x:Key="Active_ColRead">Gelezen waarde</x:String>
    <x:String x:Key="Summary_ColStatus">Status</x:String>
    <x:String x:Key="Summary_BtnPrint">DYMO LABEL AFDRUKKEN</x:String>
    <x:String x:Key="Summary_BtnRetest">Opnieuw Testen</x:String>
    <x:String x:Key="Summary_BtnNext">Volgend Toestel (Klaar)</x:String>
    <x:String x:Key="Summary_SimLockFree">Vrijgeschakeld (Simlockvrij)</x:String>
    <x:String x:Key="Summary_SimLocked">Simlock Actief</x:String>

    <!-- Header bar -->
    <x:String x:Key="Header_Connected">Toestel verbonden</x:String>
    <x:String x:Key="Header_NoDevice">Geen toestel</x:String>
    <x:String x:Key="Header_SettingsTooltip">Instellingen en opties</x:String>
    <x:String x:Key="Btn_Close">Sluiten</x:String>
    <x:String x:Key="Btn_Rescan">Opnieuw scannen</x:String>
    <x:String x:Key="Btn_ScanManually">Handmatig scannen</x:String>
    <x:String x:Key="Btn_StartInspection">Start inspectie</x:String>
    <x:String x:Key="Btn_Finish">Afronden</x:String>

    <!-- Idle screen and the USB trust guide -->
    <x:String x:Key="TrialLimit_Reached">Gratis proefversie limiet bereikt (10/10). Koop een licentie om door te gaan met scannen.</x:String>
    <x:String x:Key="Idle_Title">Sluit een toestel aan via USB</x:String>
    <x:String x:Key="Idle_Lead">Ondersteunt iPhone, iPad en Android toestellen. Zorg dat het scherm ontgrendeld is en bevestig 'Vertrouw deze computer'.</x:String>
    <x:String x:Key="Idle_DetectedDevices">Gedetecteerde apparaten:</x:String>
    <!-- USB-foutopsporing uitleg. Alleen geopend door een Android-toestel op
         de kabel waar adb nog niet mee kan praten, en door niets anders. -->
    <x:String x:Key="AdbTutorial_Title">USB-foutopsporing inschakelen</x:String>
    <x:String x:Key="AdbTutorial_Lead">De telefoon is verbonden, maar vertrouwt deze computer nog niet. De telefoon zelf is prima; er moet een keer op de telefoon worden getikt.</x:String>
    <x:String x:Key="AdbTutorial_ManufacturerPrefix">Voor uw {0}:</x:String>
    <x:String x:Key="AdbTutorial_DeviceWord">{0}-toestel</x:String>
    <x:String x:Key="AdbTutorial_AndroidDevice">Android-toestel</x:String>
    <x:String x:Key="AdbTutorial_Common_ScreenLock">Ontgrendel het scherm en laat het aan. Een vergrendeld scherm toont de vraag niet.</x:String>
    <x:String x:Key="AdbTutorial_Common_Authorize">Open de melding "USB-foutopsporing toestaan?" op de telefoon, tik "Altijd toestaan vanaf deze computer" aan en daarna op OK.</x:String>
    <!-- Twee eigen stappen per merk: waar dat merk de build-nummer verbergt,
         en hoe het het ontwikkelaarmenu noemt. -->
    <x:String x:Key="AdbTutorial_Samsung_Step1">Ga naar Instellingen &gt; Over de telefoon &gt; Software-informatie en tik zeven keer op "Build-nummer"</x:String>
    <x:String x:Key="AdbTutorial_Samsung_Step2">Ga naar Instellingen &gt; Ontwikkelaarsopties en zet "USB-foutopsporing" aan</x:String>
    <x:String x:Key="AdbTutorial_Xiaomi_Step1">Ga naar Instellingen &gt; Over de telefoon en tik zeven keer op "MIUI-versie" of "HyperOS-versie"</x:String>
    <x:String x:Key="AdbTutorial_Xiaomi_Step2">Ga naar Instellingen &gt; Extra instellingen &gt; Ontwikkelaarsopties en zet "USB-foutopsporing" aan</x:String>
    <x:String x:Key="AdbTutorial_Google_Step1">Ga naar Instellingen &gt; Over de telefoon en tik zeven keer op "Build-nummer"</x:String>
    <x:String x:Key="AdbTutorial_Google_Step2">Ga naar Instellingen &gt; Systeem &gt; Ontwikkelaarsopties en zet "USB-foutopsporing" aan</x:String>
    <x:String x:Key="AdbTutorial_Motorola_Step1">Ga naar Instellingen &gt; Over de telefoon en tik zeven keer op "Build-nummer"</x:String>
    <x:String x:Key="AdbTutorial_Motorola_Step2">Ga naar Instellingen &gt; Systeem &gt; Ontwikkelaarsopties en zet "USB-foutopsporing" aan</x:String>
    <x:String x:Key="AdbTutorial_Sony_Step1">Ga naar Instellingen &gt; Over de telefoon en tik zeven keer op "Build-nummer"</x:String>
    <x:String x:Key="AdbTutorial_Sony_Step2">Ga naar Instellingen &gt; Systeem &gt; Ontwikkelaarsopties en zet "USB-foutopsporing" aan</x:String>
    <x:String x:Key="AdbTutorial_Huawei_Step1">Ga naar Instellingen &gt; Over de telefoon en tik zeven keer op "Build-nummer"</x:String>
    <x:String x:Key="AdbTutorial_Huawei_Step2">Ga naar Instellingen &gt; Systeem &gt; Ontwikkelaarsopties en zet "USB-foutopsporing" aan</x:String>
    <x:String x:Key="AdbTutorial_OnePlus_Step1">Ga naar Instellingen &gt; Over de telefoon en tik zeven keer op "Build-nummer"</x:String>
    <x:String x:Key="AdbTutorial_OnePlus_Step2">Ga naar Instellingen &gt; Systeem &gt; Ontwikkelaarsopties en zet "USB-foutopsporing" aan</x:String>
    <!-- Het paar voor een merk zonder eigen tabel, zodat een telefoon waar
         niemand aan gedacht heeft toch iets kloppends te horen krijgt. -->
    <x:String x:Key="AdbTutorial_Generic_Step1">Ga naar Instellingen &gt; Over de telefoon en tik zeven keer op "Build-nummer"</x:String>
    <x:String x:Key="AdbTutorial_Generic_Step2">Open "Ontwikkelaarsopties" in de instellingen en zet "USB-foutopsporing" aan</x:String>
    <x:String x:Key="AdbTutorial_Common_Caveat">Na inschakelen, controleer de telefoon op de melding "USB-foutopsporing toestaan?" en tik "Altijd toestaan vanaf deze computer".</x:String>
    <x:String x:Key="AdbTutorial_RetryButton">Opnieuw zoeken</x:String>
    <x:String x:Key="AdbTutorial_Close">Sluiten</x:String>

    <!-- Inspection in progress -->
    <x:String x:Key="Active_SpecsTitle">HARDWARE SPECIFICATIES</x:String>
    <x:String x:Key="Spec_Model">Model</x:String>
    <x:String x:Key="Spec_Serial">Serienummer</x:String>
    <x:String x:Key="Spec_Storage">Opslag</x:String>
    <x:String x:Key="Spec_Color">Kleur</x:String>
    <x:String x:Key="Spec_Battery">Batterijconditie</x:String>
    <x:String x:Key="Spec_Grade">Kwaliteitsklasse</x:String>
    <x:String x:Key="Spec_Memory">Geheugen</x:String>
    <x:String x:Key="Active_SecurityTitle">BEVEILIGING &amp; STATUS</x:String>
    <x:String x:Key="Spec_Imei">IMEI Nummer</x:String>
    <x:String x:Key="Spec_FindMy">Find My (iCloud)</x:String>
    <x:String x:Key="Spec_Blacklist">Blacklist Status</x:String>
    <x:String x:Key="Spec_NotChecked">Niet gecontroleerd</x:String>
    <x:String x:Key="Active_OemTitle">ORIGINELE ONDERDELEN AUDIT (OEM)</x:String>
    <x:String x:Key="Active_InteractiveTitle">INTERACTIEVE HARDWARETEST</x:String>
    <x:String x:Key="Active_InteractiveLead">Scan met de camera van het toestel om display, touch, camera en audio te testen:</x:String>

    <!-- Result screen -->
    <x:String x:Key="Summary_Imei">IMEI / serienummer:</x:String>
    <x:String x:Key="Summary_Storage">Opslag:</x:String>
    <x:String x:Key="Summary_Memory">Geheugen:</x:String>
    <x:String x:Key="Summary_Color">Kleur:</x:String>
    <x:String x:Key="Summary_Fmi">iCloud (FMI)</x:String>
    <x:String x:Key="Summary_BatteryHealth">Batterijconditie</x:String>
    <x:String x:Key="Summary_InvoiceMethod">Factuurmethode</x:String>
    <x:String x:Key="Summary_SimLock">SIM Lock</x:String>
    <x:String x:Key="Summary_HardwareTests">Hardware Tests (PWA)</x:String>
    <x:String x:Key="Summary_ReportTitle">INSPECTIERAPPORT (AFWIJKINGEN &amp; DEFECTEN)</x:String>
    <x:String x:Key="Summary_ReportNote">Enkel niet-originele onderdelen en mislukte of overgeslagen tests</x:String>
    <x:String x:Key="Summary_AuditSection">ONDERDELEN AUDIT (NIET-OEM / VERVANGEN)</x:String>
    <x:String x:Key="Summary_TestsSection">INTERACTIEVE HARDWARETESTS</x:String>
    <x:String x:Key="Summary_AllOemOriginal">Alle onderdelen zijn origineel (OEM)</x:String>
    <x:String x:Key="Summary_AllTestsPassed">Alle interactieve tests zijn geslaagd</x:String>
    <x:String x:Key="Report_Failed">MISLUKT</x:String>
    <x:String x:Key="Report_Skipped">OVERGESLAGEN</x:String>
    <x:String x:Key="Report_DismissTest">Deze test uit het rapport laten</x:String>
    <x:String x:Key="Report_Dismissed">tests uit het rapport gelaten</x:String>
    <x:String x:Key="Report_Restore">Ongedaan maken</x:String>

    <!-- The two questions at the end of an inspection -->
    <x:String x:Key="QualityPopup_Title">Kies de kwaliteit</x:String>
    <x:String x:Key="QualityPopup_Lead">Hoe dit toestel uit de inspectie komt. De keuze komt op het label te staan.</x:String>
    <x:String x:Key="PaymentPopup_Title">Factuurmethode</x:String>
    <x:String x:Key="PaymentPopup_Lead">Hoe dit toestel wordt gefactureerd.</x:String>

    <!-- Logs and diagnostics -->
    <x:String x:Key="Logs_Title">Systeemlogboeken &amp; Tool Output</x:String>

    <!-- Settings page: the topics and their rows -->
    <x:String x:Key="Settings_Lead">Taal, werkwijze en verbinding. Wijzigingen worden direct opgeslagen.</x:String>
    <x:String x:Key="Settings_Close">Sluiten</x:String>
    <x:String x:Key="Settings_CloseTooltip">Terug naar het scherm erachter</x:String>
    <x:String x:Key="Settings_SecGeneral">Algemeen</x:String>
    <x:String x:Key="Settings_SecWorkflow">Werkwijze</x:String>
    <x:String x:Key="Settings_SecConnection">Verbinding</x:String>
    <x:String x:Key="Settings_SecLicense">Licentie</x:String>
    <x:String x:Key="Settings_SecSupport">Hulp</x:String>
    <x:String x:Key="Settings_SecAdvanced">Geavanceerd</x:String>
    <x:String x:Key="Settings_QualityDesc">De klasse waar een inspectie mee begint. Een lege keuze vraagt bij elke inspectie.</x:String>
    <x:String x:Key="Settings_PaymentDesc">De factuurmethode waar een inspectie mee begint. Een lege keuze vraagt bij elke inspectie.</x:String>
    <x:String x:Key="Settings_QualityAsk">Elke keer vragen</x:String>
    <x:String x:Key="Settings_PaymentAsk">Elke keer vragen</x:String>
    <x:String x:Key="Settings_AutoStartWebTestDesc">Opent de testpagina zodra de code is gescand, zodat de operateur niets hoeft te starten.</x:String>
    <x:String x:Key="Settings_RequirePwaTestDesc">De inspectie kan niet worden afgerond voordat de test op de telefoon heeft gedraaid.</x:String>
    <x:String x:Key="Settings_AutoFinishAfterTestDesc">Gaat vanzelf naar het resultaatscherm zodra de test op de telefoon terugmeldt.</x:String>
    <x:String x:Key="Settings_ShowSummaryDesc">Toont het rapport voordat het label wordt afgedrukt, zodat het nog kan worden gecorrigeerd.</x:String>
    <x:String x:Key="Settings_TroubleshootCardTitle">USB- en driverdiagnose</x:String>
    <x:String x:Key="Settings_TroubleshootCardDesc">Controleert de tools, de drivers en de diensten die dit gereedschap nodig heeft, en repareert wat het kan.</x:String>
    <x:String x:Key="Settings_LogsCardTitle">Systeemlogboeken</x:String>
    <x:String x:Key="Settings_LogsCardDesc">Alles wat het gereedschap en zijn hulpmiddelen hebben gemeld, met een filter en een zoekvak.</x:String>
    <x:String x:Key="Settings_AutoActivateDesc">Activeert een aangesloten toestel zonder te vragen, wat een reeks van hetzelfde toestel versnelt.</x:String>
