    <!-- IMEI Check Labels (prijs per check) -->
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmiPrice">$0.360</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimplePrice">$0.200</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumPrice">$0.420</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxPrice">$0.600</x:String>

    <!-- IMEI check namen en beschrijvingen -->
    <x:String x:Key="Settings_SecImeiApi">IMEI API Configuratie</x:String>
    <x:String x:Key="Settings_ImeiInfoApiKeyWatermark">Plak hier je API-sleutel (bijv. e0d7c26f-5cc7-5644-863c-8992083dfeac)</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmi">APPLE: Carrier &amp; Lock Status &amp; FMI</x:String>
    <x:String x:Key="Settings_ImeiCheck_AppleCarrierLockFmiDesc">$0.360 - Geeft providernaam, SIM-lockstatus en Find My iPhone (FMI)-status voor Apple toestellen.</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimple">BLACKLIST: Simpele Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistSimpleDesc">$0.200 - Geeft alleen de basis blackliststatus (schoon of geblacklist).</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremium">BLACKLIST: Premium Check</x:String>
    <x:String x:Key="Settings_ImeiCheck_BlacklistPremiumDesc">$0.420 - Geeft gedetailleerde info: IMEI, Modelnaam, Fabrikant, Modelnummer, Geblacklist Door, Geblacklist Op, Blacklist Reden, Blacklist Status, Geblacklist Land, Algemene Lijst Status.</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnox">GENERIC: Samsung Info Check &amp; Knox Info</x:String>
    <x:String x:Key="Settings_ImeiCheck_SamsungInfoKnoxDesc">$0.600 - Geeft Samsung toestelinformatie inclusief model, serienummer, garantie en Knox garantie bit status.</x:String>

    <!-- Introductiescherm: IMEI controles (BYOK) -->
    <x:String x:Key="Intro_ImeiTitle">IMEI controles (BYOK)</x:String>
    <x:String x:Key="Intro_ImeiBody">PhoneGrade controleert carrier lock, FMI, blacklist en Knox status via imei.info. Dit is een Bring Your Own Key systeem: maak een account aan bij imei.info, voeg credits toe en plak je eigen API-sleutel bij Instellingen. Elke check heeft een eigen prijs (van $0.200 tot $0.600) en je kiest zelf welke checks automatisch draaien.</x:String>
    <x:String x:Key="Intro_ImeiConfigureButton">IMEI API instellen bij Instellingen</x:String>
    <x:String x:Key="Settings_ImeiInfoWatermarkDefault">10</x:String>

