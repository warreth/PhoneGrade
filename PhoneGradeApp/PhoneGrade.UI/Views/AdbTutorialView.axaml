<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhoneGrade.UI.ViewModels"
             xmlns:converters="using:PhoneGrade.UI.Converters"
             x:Class="PhoneGrade.UI.Views.AdbTutorialView"
             x:DataType="vm:AdbTutorialViewModel"
             x:CompileBindings="True">

    <!--
        The how-to itself. The frame around it - the top bar, the two buttons
        and the flag that decides whether any of this is on screen - lives in
        MainWindow, beside the settings page it sits next to when open.

        Nothing here scrolls. Four lines, a caveat and a heading have to fit the
        smallest window the kiosk opens at, because an operator who has to drag
        a panel to find the last line will not drag it.
    -->
    <Border Classes="card" Padding="24" MaxWidth="640"
            HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel Spacing="12">
            <Border Classes="stepPlan">
                <StackPanel>
                    <TextBlock Classes="stepPlanTitle"
                               Text="{Binding ManufacturerPrefix}"/>

                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdbTutorialViewModel+StepItem">
                                <Border Classes="stepItem">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Classes="stepRail"/>
                                        <Border Classes="stepBadge">
                                            <TextBlock Text="{Binding Index, StringFormat='{}{0}'}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="stepBody"
                                                   Text="{Binding Value, Converter={StaticResource LocalizationConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="stepCaveatBox" Margin="0,2,0,0">
                <TextBlock Classes="stepCaveat" Text="{DynamicResource AdbTutorial_Common_Caveat}"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
