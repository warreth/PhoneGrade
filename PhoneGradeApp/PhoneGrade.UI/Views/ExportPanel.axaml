<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhoneGrade.UI.ViewModels"
             xmlns:views="using:PhoneGrade.UI.Views"
             xmlns:conv="using:PhoneGrade.UI.Converters"
             x:Class="PhoneGrade.UI.Views.ExportPanel"
             x:DataType="vm:ExportViewModel">

    <!--
        ==================== FINISH: LABEL AND RECORD ====================

        An overlay rather than a window, on top of the report screen: the operator
        came from there and goes back to it, and a second window would leave two
        windows stacked with no visual order between them.

        One action, the one every shop performs on every phone: the label is drawn
        on screen exactly as it will print, and one button prints it and files the
        record. Everything a shop configures once - the roll, the arrangement, the
        barcode, the files, the folder - lives in the settings and is listed on the
        right as it stands, not asked again. The one thing that can differ for a
        single inspection sits behind "Deze keer anders", collapsed.

        A phone that did not report one of the four values a label cannot do
        without is not labelled: the panel says which value is missing and opens the
        editor, and offers to file the record without a label rather than printing a
        tag with a placeholder on it.
    -->
    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Classes="topBar" Padding="24,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="pageTitle" Text="{DynamicResource Export_Title}"/>
                    <TextBlock Classes="settingDesc" Text="{DynamicResource Export_Lead}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="headerBtn" VerticalAlignment="Center"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="{DynamicResource Export_Close}"
                        Content="{DynamicResource Export_Close}"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="*,1,*" Margin="24,20,24,16" MaxWidth="1100"
                  HorizontalAlignment="Stretch">

                <!-- ============ The label, and the one button ============ -->
                <StackPanel Grid.Column="0" Spacing="14">

                    <TextBlock Classes="cardTitle" Text="{DynamicResource Export_PreviewTitle}"/>

                    <!--
                        The sheet, drawn from the same plate the label PDF is
                        written from, at the shape of the stock. It scales itself
                        down when the column cannot hold it at full size and says so
                        underneath, because a scaled preview keeps the right shape
                        and stops being a picture of the physical label.
                    -->
                    <views:LabelView x:Name="Sheet"
                                     Plate="{Binding Plate}"
                                     Layout="{Binding Layout}"
                                     MaxWidth="420"
                                     HorizontalAlignment="Center"/>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="settingDesc" Text="{DynamicResource Export_PreviewNote}"/>
                        <TextBlock Classes="settingDesc"
                                   Foreground="{DynamicResource WarnColor}"
                                   Text="{DynamicResource Export_PreviewScaled}"
                                   IsVisible="{Binding #Sheet.SheetScaled}"/>
                    </StackPanel>

                    <!--
                        The phone cannot be labelled yet. The card replaces the
                        button rather than sitting beside it: one of the two is the
                        way forward and an operator should not have to choose
                        between a greyed button and a red card.
                    -->
                    <Border Classes="settingCard" IsVisible="{Binding IsLabelBlocked}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="cardTitle" Foreground="{DynamicResource DangerColor}"
                                       Text="{DynamicResource Export_MissingTitle}"/>
                            <TextBlock Classes="settingDesc" TextWrapping="Wrap"
                                       Text="{DynamicResource Export_MissingBody}"/>
                            <TextBlock Classes="valueText" FontWeight="Bold" TextWrapping="Wrap"
                                       Text="{Binding MissingFieldsText}"/>
                            <Button Classes="kioskPrint" FontSize="15"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding FixCommand}"
                                    Content="{DynamicResource Export_BtnFix}"/>
                            <Button Classes="kioskSecondary"
                                    HorizontalContentAlignment="Center"
                                    IsEnabled="{Binding CanFinish}"
                                    Command="{Binding FinishCommand}"
                                    Content="{DynamicResource Export_BtnSaveWithoutLabel}"/>
                        </StackPanel>
                    </Border>

                    <!-- The one action. Print and file, or file alone when the fold
                         has printing ticked off. -->
                    <Button Classes="kioskPrint" FontSize="16"
                            HorizontalContentAlignment="Center"
                            IsVisible="{Binding !IsLabelBlocked}"
                            IsEnabled="{Binding CanFinish}"
                            Command="{Binding FinishCommand}"
                            Content="{Binding PrimaryLabelKey, Converter={StaticResource LocalizationConverter}}"/>

                    <TextBlock Classes="settingDesc" TextWrapping="Wrap" Text="{Binding FolderLine}"/>

                    <!-- What happened, and the two things an operator does next. -->
                    <Border Classes="settingCard" IsVisible="{Binding Confirmed}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="valueText" TextWrapping="Wrap" Text="{Binding Status}"
                                       Foreground="{Binding StatusIsError, Converter={x:Static conv:ExportStatusBrushConverter.Instance}}"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="kioskSecondary" Command="{Binding OpenFolderCommand}"
                                        Content="{DynamicResource Export_BtnOpenFolder}"/>
                                <Button Classes="kioskPrint" FontSize="14" Padding="16,10"
                                        Command="{Binding NextDeviceCommand}"
                                        Content="{DynamicResource Export_BtnNextDevice}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- A finish that did not complete still reports; the confirm
                         card above is only for the ones that did. -->
                    <TextBlock Classes="settingDesc" TextWrapping="Wrap" Text="{Binding Status}"
                               IsVisible="{Binding !Confirmed}"
                               Foreground="{Binding StatusIsError, Converter={x:Static conv:ExportStatusBrushConverter.Instance}}"/>
                    <TextBlock Classes="valueHint" IsVisible="{Binding IsBusy}"
                               Text="{DynamicResource Export_Busy}"/>
                </StackPanel>

                <!-- ============ The standard, and the exceptions ============ -->
                <StackPanel Grid.Column="2" Spacing="12">

                    <Border Classes="settingCard" Padding="0">
                        <StackPanel>
                            <ToggleButton x:Name="AgainToggle" Classes="foldHead">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="cardTitle" Text="{DynamicResource Export_AgainFold}"/>
                                        <TextBlock Classes="settingDesc" Text="{DynamicResource Export_AgainFoldNote}"/>
                                    </StackPanel>
                                    <Path Grid.Column="1" Classes="chevron"
                                          Data="M 0,0 L 6,6 L 0,12" Stroke="{DynamicResource TextDimColor}"
                                          StrokeThickness="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </ToggleButton>

                            <StackPanel Spacing="12" Margin="14,0,14,14"
                                        IsVisible="{Binding #AgainToggle.IsChecked}">

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="fieldCaption" Text="{DynamicResource Export_RollOverride}"/>
                                    <ComboBox ItemsSource="{Binding Layouts}"
                                              SelectedItem="{Binding Stock}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LabelLayoutItem">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding TitleKey, Converter={StaticResource LocalizationConverter}}"/>
                                                    <TextBlock Classes="valueHint" Text="{Binding PartNumber}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Classes="settingDesc" TextWrapping="Wrap"
                                               Text="{DynamicResource Export_RollOverrideNote}"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <CheckBox IsChecked="{Binding SaveOnly}"
                                              Content="{DynamicResource Export_NoPrint}"/>
                                    <TextBlock Classes="settingDesc" Margin="26,0,0,0" TextWrapping="Wrap"
                                               Text="{DynamicResource Export_NoPrintNote}"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <CheckBox IsChecked="{Binding ExtraFiles}"
                                              Content="{DynamicResource Export_ExtraFiles}"/>
                                    <TextBlock Classes="settingDesc" Margin="26,0,0,0" TextWrapping="Wrap"
                                               Text="{DynamicResource Export_ExtraFilesNote}"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="fieldCaption" Text="{DynamicResource Export_Printer}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="headerBtn" FontSize="12"
                                                Padding="8,4"
                                                Command="{Binding DetectPrintersCommand}"
                                                Content="{DynamicResource Export_ScanPrinters}"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding Printers}"
                                              SelectedItem="{Binding Printer}"
                                              PlaceholderText="{DynamicResource Export_PrintDialog}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PrinterOption">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Detail}" Classes="valueHint"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Classes="settingDesc"
                                               Text="{DynamicResource Export_NoPrinters}"
                                               IsVisible="{Binding !Printers.Count}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- What every finish writes, as it is configured. The values
                         are the settings' own, so a shop that changes one sees the
                         change here rather than in a file it did not expect. -->
                    <Border Classes="settingCard">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="cardTitle" Text="{DynamicResource Export_AsConfigured}"/>

                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="configuredLabel"
                                               Text="{DynamicResource Export_ConfiguredLabel}"/>
                                    <TextBlock Grid.Column="1" Classes="configuredValue"
                                               Text="{Binding ConfiguredVariant}"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="configuredLabel"
                                               Text="{DynamicResource Export_ConfiguredFormats}"/>
                                    <TextBlock Grid.Column="1" Classes="configuredValue"
                                               Text="{Binding ConfiguredFormats}"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="configuredLabel"
                                               Text="{DynamicResource Export_ConfiguredFolder}"/>
                                    <TextBlock Grid.Column="1" Classes="configuredValue"
                                               Text="{Binding ConfiguredFolder}"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="configuredLabel"
                                               Text="{DynamicResource Export_ConfiguredRoll}"/>
                                    <TextBlock Grid.Column="1" Classes="configuredValue"
                                               Text="{Binding ConfiguredRoll}"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="configuredLabel"
                                               Text="{DynamicResource Export_ConfiguredPrinter}"/>
                                    <TextBlock Grid.Column="1" Classes="configuredValue"
                                               Text="{Binding ConfiguredPrinter}"/>
                                </Grid>
                            </StackPanel>

                            <Button Classes="headerBtn" HorizontalAlignment="Left"
                                    Command="{Binding OpenLabelSettingsCommand}"
                                    Content="{DynamicResource Export_ConfiguredChange}"/>
                        </StackPanel>
                    </Border>

                    <!-- What was written. A failed row keeps its place in the list
                         rather than moving to a separate error box, because the
                         operator needs to see that the other files still arrived. -->
                    <Border Classes="settingCard" IsVisible="{Binding HasResults}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="cardTitle" VerticalAlignment="Center"
                                           Text="{DynamicResource Export_ResultsTitle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Classes="valueHint"
                                               Text="{DynamicResource Export_FolderLabel}"/>
                                    <TextBlock Classes="valueText" MaxWidth="220"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding FolderName}"/>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExportResultItem">
                                        <Border Classes="reportRow" Margin="0,0,0,6" Padding="10,8"
                                                Background="{Binding Succeeded, Converter={x:Static conv:ExportResultBrushConverter.Instance}}">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="valueText"
                                                                   Text="{Binding TitleKey, Converter={StaticResource LocalizationConverter}}"/>
                                                        <TextBlock Classes="valueHint"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding FileName}"
                                                                   IsVisible="{Binding Succeeded}"/>
                                                    </StackPanel>
                                                    <TextBlock TextWrapping="Wrap" Classes="settingDesc"
                                                               Foreground="{DynamicResource DangerColor}"
                                                               Text="{Binding Outcome.Problem}"
                                                               IsVisible="{Binding Outcome.Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    <TextBlock TextWrapping="Wrap" Classes="settingDesc"
                                                               Foreground="{DynamicResource WarnColor}"
                                                               Text="{Binding Outcome.Note}"
                                                               IsVisible="{Binding Outcome.Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>

                                                <Button Grid.Column="1" Classes="kioskSecondary" FontSize="12"
                                                        Margin="8,0,0,0" Padding="12,6"
                                                        Content="{DynamicResource Export_BtnOpen}"
                                                        IsVisible="{Binding CanOpenInApp}"
                                                        Command="{Binding $parent[ItemsControl].((vm:ExportViewModel)DataContext).OpenFileCommand}"
                                                        CommandParameter="{Binding Outcome.Path}"/>

                                                <Button Grid.Column="2" Classes="kioskSecondary" FontSize="12"
                                                        Margin="6,0,0,0" Padding="12,6"
                                                        Content="{DynamicResource Export_BtnPrintOne}"
                                                        IsVisible="{Binding CanPrint}"
                                                        Command="{Binding $parent[ItemsControl].((vm:ExportViewModel)DataContext).PrintFileCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
