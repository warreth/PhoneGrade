<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhoneGrade.UI.ViewModels"
        x:Class="PhoneGrade.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PhoneGrade"
        Width="760" Height="800"
        MinWidth="600" MinHeight="620"
        CanResize="True"
        WindowStartupLocation="CenterScreen">

    <!-- Native system chrome on every platform: title bar with close/min/max and
         Wayland-compatible resize. ExtendClientAreaToDecorationsHint is deliberately
         NOT used — it removes resize + title buttons on Wayland. -->

    <Panel>

        <!-- ==================== Main content ==================== -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24" Spacing="16">

                <!-- ============ Hero: status + progress + actions ============ -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="cardTitle" Text="STATUS"/>
                        <TextBlock Text="{Binding Status}" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap" LineHeight="26"/>
                        <ProgressBar Value="{Binding Progress}" Maximum="100"/>
                        <Grid ColumnDefinitions="*,12,*,12,*">
                            <Button Grid.Column="0" Classes="cta" Command="{Binding StartCommand}"
                                    Content="▶  Start handmatig"
                                    ToolTip.Tip="Start het label-proces voor het geselecteerde toestel"/>
                            <Button Grid.Column="2" Command="{Binding RefreshDevicesCommand}"
                                    Content="⟳  Verversen"
                                    ToolTip.Tip="Zoek opnieuw naar verbonden toestellen"/>
                            <Button Grid.Column="4" Command="{Binding OpenLabelCommand}"
                                    Content="Open label"
                                    ToolTip.Tip="Open het laatst gegenereerde label in Dymo Label"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Device card ============ -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="cardTitle" Text="TOESTEL"/>

                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="Gedetecteerd toestel — bij één toestel automatisch geselecteerd">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Device summary: shown once data is loaded -->
                        <Grid IsVisible="{Binding HasDevice}" ColumnDefinitions="*,*,*,*,*" Margin="0,2,0,0">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="dim" Text="Model" FontSize="11"/>
                                <TextBlock Text="{Binding DeviceData.Model}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Classes="dim" Text="Opslag" FontSize="11"/>
                                <TextBlock Text="{Binding DeviceData.Storage}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Classes="dim" Text="Kleur" FontSize="11"/>
                                <TextBlock Text="{Binding DeviceData.Color}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2">
                                <TextBlock Classes="dim" Text="Batterij" FontSize="11"/>
                                <TextBlock Text="{Binding DeviceData.BatteryHealth}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="2">
                                <TextBlock Classes="dim" Text="Kwaliteit" FontSize="11"/>
                                <TextBlock Text="{Binding DeviceData.Quality}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Component audit list -->
                        <StackPanel Spacing="8" IsVisible="{Binding HasDevice}">
                            <TextBlock Classes="cardTitle" Text="OEM ONDERDELEN AUDIT"/>
                            <ItemsControl ItemsSource="{Binding ComponentChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardDeepColor}"
                                                CornerRadius="10" Padding="12" Margin="0,0,0,6"
                                                BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1">
                                            <Grid ColumnDefinitions="140,*,*,90">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Classes="dim" Text="Gelezen" FontSize="11"/>
                                                    <TextBlock Text="{Binding SerialRead}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Classes="dim" Text="Origineel" FontSize="11"/>
                                                    <TextBlock Text="{Binding SerialOriginal}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="3" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Background="{Binding Status, Converter={x:Static vm:ComponentStatusToBrushConverter.Instance}}">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Diagnostics list -->
                        <StackPanel Spacing="8" IsVisible="{Binding HasIssues}">
                            <TextBlock Classes="cardTitle" Text="GEVONDEN PROBLEMEN"/>
                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardDeepColor}"
                                                CornerRadius="10" Padding="14" Margin="0,0,0,8"
                                                BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <Border Width="9" Height="9" CornerRadius="5"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding Level, Converter={x:Static vm:SeverityToBrushConverter.Instance}}"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"
                                                           FontSize="12.5" Foreground="{DynamicResource TextDimColor}"/>
                                                <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" FontSize="12.5"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Web Test Runner (PWA) ============ -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="INTERACTIEVE WEBTEST (PWA)" Classes="cardTitle"/>
                                <TextBlock Classes="dim" Text="Test touchscreen, display, audio en sensoren via mobiele Safari/Chrome" FontSize="12"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource CardBgColor}" CornerRadius="4" Padding="6,2" BorderBrush="{DynamicResource BorderSubtleColor}" BorderThickness="1">
                                <TextBlock Text="{Binding InteractiveSessionStatus}" FontSize="11" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="140,*" Margin="0,4,0,0">
                            <!-- QR Code Preview -->
                            <Border Grid.Column="0" Width="130" Height="130" Background="White" CornerRadius="8" Padding="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Image Source="{Binding QrCodeBitmap}" Stretch="Uniform"/>
                            </Border>

                            <!-- Instructions & Link -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="Scan met de camera van het toestel:" FontWeight="SemiBold" FontSize="13"/>
                                <SelectableTextBlock Text="{Binding WebRunnerUrl}" Foreground="{DynamicResource PrimaryColor}" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="Geen profielen of certificaten vereist. Verbind met dezelfde Wi-Fi of USB proxy." Classes="dim" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding InteractiveTestSummary}" Foreground="{DynamicResource SuccessColor}" FontWeight="Medium" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Settings ============ -->
                <Border Classes="card">
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="INSTELLINGEN" Classes="cardTitle"/>
                        </Expander.Header>
                        <StackPanel Spacing="14" Margin="0,14,0,0">

                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Thema" FontWeight="Medium"/>
                                    <TextBlock Classes="dim" Text="Donker, licht of volgens systeem" FontSize="12"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                                          MinWidth="140" VerticalAlignment="Center"/>
                            </Grid>

                            <Separator/>

                            <StackPanel Spacing="12">
                                <CheckBox Content="Start automatisch bij insteken" IsChecked="{Binding AutoDetectOnPlug}"
                                          ToolTip.Tip="Zodra een iPhone/iPad gedetecteerd wordt, draait het hele proces vanzelf"/>
                                <CheckBox Content="Activeer toestel automatisch (bypass)" IsChecked="{Binding AutoActivate}"/>
                                <CheckBox Content="Diagnostiek: panic-logs &amp; sensoren" IsChecked="{Binding RunDiagnostics}"
                                          ToolTip.Tip="Haalt crash-logs op en vertaalt fouten naar leesbare reparatie-tips"/>
                                <CheckBox Content="Batterijchecker: X op label bij &lt; 85%" IsChecked="{Binding Enable85PercentChecker}"/>
                                <CheckBox Content="Open editor vóór het label" IsChecked="{Binding OpenEditorBeforePrint}"/>
                            </StackPanel>

                            <Separator/>

                            <Grid ColumnDefinitions="*,*,12,*,*">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Standaard kwaliteit" FontWeight="Medium"/>
                                    <TextBlock Classes="dim" Text="Leeg = altijd vragen" FontSize="12"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding DefaultQuality}"/>
                                <StackPanel Grid.Column="3" Spacing="3">
                                    <TextBlock Text="Standaard betaling" FontWeight="Medium"/>
                                    <TextBlock Classes="dim" Text="Leeg = altijd vragen" FontSize="12"/>
                                </StackPanel>
                                <ComboBox Grid.Column="4" ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding DefaultPaymentMethod}"/>
                            </Grid>

                        </StackPanel>
                    </Expander>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== Quality popup ==================== -->
        <Panel IsVisible="{Binding IsQualityPopupVisible}" ZIndex="10">
            <Rectangle Fill="{DynamicResource OverlayColor}"/>
            <Border Classes="card" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 24 60 0 #66000000" Padding="28">
                <StackPanel Spacing="14">
                    <TextBlock Text="Kies de kwaliteit" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Classes="dim" Text="Komt op het label bij de kvaliteitscode"
                               FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Button Classes="cta" Height="48" Content="A  —  Zo goed als nieuw"
                            Command="{Binding SetQualityCommand}" CommandParameter="A"
                            Background="{DynamicResource SuccessColor}"/>
                    <Button Classes="cta" Height="48" Content="B  —  Licht gebruik"
                            Command="{Binding SetQualityCommand}" CommandParameter="B"
                            Background="{DynamicResource WarnColor}"/>
                    <Button Classes="cta" Height="48" Content="C  —  Zichtbare schade"
                            Command="{Binding SetQualityCommand}" CommandParameter="C"
                            Background="{DynamicResource DangerColor}"/>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ==================== Payment popup ==================== -->
        <Panel IsVisible="{Binding IsPaymentPopupVisible}" ZIndex="10">
            <Rectangle Fill="{DynamicResource OverlayColor}"/>
            <Border Classes="card" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 24 60 0 #66000000" Padding="28">
                <StackPanel Spacing="14">
                    <TextBlock Text="Betaalmethode" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Classes="dim" Text="Wordt op het label afgedrukt"
                               FontSize="12" HorizontalAlignment="Center"/>
                    <Button Classes="cta" Height="48" Content="Marge  —  cash/kaart"
                            Command="{Binding SetPaymentMethodCommand}" CommandParameter="Marge"/>
                    <Button Classes="cta" Height="48" Content="BTW  —  order/factuur"
                            Command="{Binding SetPaymentMethodCommand}" CommandParameter="BTW"/>
                </StackPanel>
            </Border>
        </Panel>

    </Panel>
</Window>
