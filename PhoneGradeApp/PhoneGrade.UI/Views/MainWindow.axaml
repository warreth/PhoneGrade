<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhoneGrade.UI.ViewModels"
        xmlns:views="using:PhoneGrade.UI.Views"
        x:Class="PhoneGrade.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PhoneGrade Kiosk"
        Width="1050" Height="740"
        MinWidth="850" MinHeight="620"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/avalonia-logo.ico">

    <Panel>
        <Grid RowDefinitions="64,*">
            <!-- ==================== FIXED HEADER BAR ==================== -->
            <Border Grid.Row="0" Background="{DynamicResource CardColor}" 
                    BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="0,0,0,1" 
                    Padding="24,0">
                <Grid ColumnDefinitions="280,*,200" VerticalAlignment="Center">
                    <!-- Left: Brand / Connection Status Pill -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        
                        <!-- Unified PG SVG Logo -->
                        <Viewbox Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center">
                            <Canvas Width="100" Height="100">
                                <Rectangle Fill="#2563eb" Width="100" Height="100" RadiusX="16" RadiusY="16"/>
                                <TextBlock Text="PG" FontSize="54" Foreground="#ffffff" FontFamily="system-ui, -apple-system" FontWeight="Bold" Canvas.Left="19" Canvas.Top="14"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="PhoneGrade" FontSize="18" FontWeight="Bold" 
                                   Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                        
                        <Border Classes="pill" 
                                Classes.success="{Binding SelectedDevice.Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Classes.neutral="{Binding SelectedDevice.Key, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                            <TextBlock Classes="pillText" 
                                       Text="{Binding SelectedDevice.Key, Converter={StaticResource DeviceConnectionTextConverter}}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Center: Current Device Summary (if active) -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasDevice}">
                            <TextBlock Text="{Binding DeviceData, Converter={StaticResource ModelDisplayConverter}}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="|" Foreground="{DynamicResource TextDimColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DeviceData.Identifier}" Classes="dim" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="|" Foreground="{DynamicResource TextDimColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Status}" Classes="dim" FontSize="12" VerticalAlignment="Center" 
                                       MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: License status, Quick Actions & Settings Gear -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                        <!--
                            The whole licensing story in one place: tier, scans left
                            on it, and a click into the panel that activates a key
                            or opens the pricing page. Amber once the run is close
                            to ending, red when it has ended.
                        -->
                        <Button Classes="statusPill"
                                Classes.success="{Binding Licensing.IsPro}"
                                Classes.warn="{Binding Licensing.IsAlmostOut}"
                                Classes.danger="{Binding Licensing.IsLimitReached}"
                                Classes.neutral="{Binding Licensing.IsFreeSteady}"
                                Command="{Binding ToggleLicensePanelCommand}"
                                IsVisible="{Binding Licensing, Converter={x:Static ObjectConverters.IsNotNull}}"
                                ToolTip.Tip="{DynamicResource Licensing_PanelHint}">
                            <TextBlock Classes="pillText" Text="{Binding Licensing.TierSummary}"/>
                        </Button>

                        <Button Classes="iconBtn" Command="{Binding RefreshDevicesCommand}"
                                ToolTip.Tip="Zoek opnieuw naar verbonden apparaten">
                            <TextBlock Text="Verversen" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDimColor}"/>
                        </Button>

                        <Button Classes="iconBtn" Command="{Binding ToggleSettingsCommand}"
                                ToolTip.Tip="Instellingen en opties">
                            <TextBlock Text="Instellingen" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN DYNAMIC CONTENT AREA ==================== -->
            <Panel Grid.Row="1" Background="{DynamicResource AppBgColor}">

                <!-- Trial limit warning banner (appears above idle/active states) -->
                <Border Classes="card" IsVisible="{Binding IsTrialLimitReached}"
                        BorderBrush="{DynamicResource WarnColor}" BorderThickness="2"
                        Padding="16" Margin="32,0,32,16">
                    <StackPanel Spacing="12">
                        <TextBlock TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{DynamicResource WarnColor}" FontWeight="SemiBold"
                                   Text="Gratis proefversie limiet bereikt (10/10). Koop een licentie om door te gaan met scannen."/>
                    </StackPanel>
                </Border>

                <!-- ==================== STATE 1: IDLE ==================== -->
                <Grid IsVisible="{Binding IsIdleState}" RowDefinitions="*,Auto,*" Margin="32">
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" MaxWidth="500">
                        <Border Width="88" Height="88" CornerRadius="44" Background="{DynamicResource CardColor}"
                                BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="2"
                                HorizontalAlignment="Center">
                            <TextBlock Text="USB" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}"/>
                        </Border>

                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="Sluit een toestel aan via USB" FontSize="24" FontWeight="Bold" 
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="Ondersteunt iPhone, iPad en Android toestellen. Zorg dat het scherm ontgrendeld is en bevestig 'Vertrouw deze computer'." 
                                       Classes="dim" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                        </StackPanel>

                        <!-- Device dropdown selector if multiple connected -->
                        <Border Classes="card" IsVisible="{Binding Devices.Count}" Padding="16" Margin="0,8,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Gedetecteerde apparaten:" FontWeight="SemiBold" FontSize="12"/>
                                <!-- The selection is only ever written into the view model, never read out of a
                                     cleared control: see DeviceSelectionChanged. -->
                                <ComboBox ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice, Mode=OneWay}"
                                          SelectionChanged="DeviceSelectionChanged"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Value}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Classes="cta" Command="{Binding StartCommand}" Content="Start Inspectie" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>


                        <!--
                            ADB unauthorized warning card.

                            This appears only when the phone is connected but has not
                            accepted this computer, so the phone itself is fine and
                            nothing about it is broken. What is needed is a tap on the
                            phone, which is why this is a numbered guide rather than a
                            sentence: the previous text was English, told the operator
                            to switch to MTP mode, which this tool never uses and which
                            changes nothing about the adb state, and did not say the
                            one thing that decides whether it works next time, which is
                            ticking "Always allow from this computer".
                        -->
                        <Border Classes="card" IsVisible="{Binding ShowAdbWarning}"
                                BorderBrush="{DynamicResource WarnColor}" BorderThickness="2"
                                Padding="16" Margin="0,16,0,0">
                            <StackPanel Spacing="12">

                                <TextBlock TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{DynamicResource WarnColor}" FontWeight="SemiBold"
                                           Text="De telefoon is verbonden, maar vertrouwt deze computer nog niet. De telefoon zelf is prima; er moet een keer op de telefoon worden getikt."/>

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <Border Grid.Column="0" Grid.Row="0" Classes="stepBadge" Margin="0,0,0,8">
                                        <TextBlock Text="1"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Classes="stepBody" Margin="10,0,0,8"
                                               Text="Ontgrendel het scherm en laat het aan. Een vergrendeld scherm toont de vraag niet."/>

                                    <Border Grid.Column="0" Grid.Row="1" Classes="stepBadge" Margin="0,0,0,8">
                                        <TextBlock Text="2"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Classes="stepBody" Margin="10,0,0,8"
                                               Text="Open de melding &#8220;USB-debugging toestaan?&#8221; op de telefoon. Tik &#8220;Altijd toestaan vanaf deze computer&#8221; aan en daarna op OK."/>

                                    <Border Grid.Column="0" Grid.Row="2" Classes="stepBadge" Margin="0,0,0,8">
                                        <TextBlock Text="3"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Grid.Row="2" Classes="stepBody" Margin="10,0,0,8"
                                               Text="Staat die melding er niet? Ga naar Instellingen, &#8220;Over de telefoon&#8221; en tik zeven keer op &#8220;Build-nummer&#8221;."/>

                                    <Border Grid.Column="0" Grid.Row="3" Classes="stepBadge">
                                        <TextBlock Text="4"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Classes="stepBody" Margin="10,0,0,0"
                                               Text="Kies daarna &#8220;Ontwikkelaarsopties&#8221; en zet &#8220;USB-debugging&#8221; aan. De melding verschijnt dan vanzelf opnieuw."/>
                                </Grid>

                                <Border Background="#20F5A623" CornerRadius="4" Padding="10,8">
                                    <TextBlock Classes="stepCaveat"
                                               Text="Zonder &#8220;Altijd toestaan&#8221; vraagt de telefoon het bij elke nieuwe kabel opnieuw en staat de pc steeds weer op &#8220;niet vertrouwd&#8221;."/>
                                </Border>

                                <Button Classes="cta" Command="{Binding RetryAdbDetectionCommand}"
                                        Content="Opnieuw zoeken" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Button Classes="kioskSecondary" Command="{Binding RefreshDevicesCommand}" Content="Handmatig Scannen" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ==================== STATE 2: ACTIVE (Reading Specs & Testing) ==================== -->
                <ScrollViewer IsVisible="{Binding IsActiveState}" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="*,340" Margin="16,12" RowDefinitions="Auto,*">
                        <!-- Top: Progress bar -->
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="card" Padding="12,8" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="13"/>
                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="kioskSecondary" Command="{Binding RetestCommand}" Content="Opnieuw Scannen" Margin="12,0,0,0" Padding="10,6"/>
                            </Grid>
                        </Border>

                        <!-- Left Column: Device Specs & Component Audit -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="10" Margin="0,0,12,0">
                            <!-- Specs Card -->
                            <Border Classes="card" Padding="10,8">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="cardTitle" Text="HARDWARE SPECIFICATIES" FontSize="11"/>
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="1" Margin="0,0,6,8">
                                            <TextBlock Classes="dim" Text="Model" FontSize="10"/>
                                            <TextBlock Text="{Binding DeviceData, Converter={StaticResource ModelDisplayConverter}}" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1" Margin="0,0,6,8">
                                            <TextBlock Classes="dim" Text="Serienummer" FontSize="10"/>
                                            <TextBlock Text="{Binding DeviceData.Identifier}" FontWeight="SemiBold" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="1" Margin="0,0,0,8">
                                            <TextBlock Classes="dim" Text="Opslag" FontSize="10"/>
                                            <TextBlock Text="{Binding DeviceData.Storage}" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="1" Margin="0,0,6,0">
                                            <TextBlock Classes="dim" Text="Kleur" FontSize="10"/>
                                            <TextBlock Text="{Binding DeviceData.Color, Converter={StaticResource ColorConverter}}" FontWeight="SemiBold" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1" Margin="0,0,6,0">
                                            <TextBlock Classes="dim" Text="Batterijconditie" FontSize="10"/>
                                            <TextBlock Text="{Binding DeviceData.BatteryHealth, Converter={StaticResource BatteryConverter}}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding DeviceData.BatteryLevel, Converter={StaticResource BatteryLevelConverter}}" Classes="dim" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="1">
                                            <TextBlock Classes="dim" Text="Kwaliteitsklasse" FontSize="10"/>
                                            <TextBlock Text="{Binding SelectedGradeDisplay}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentColor}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="1">
                                            <TextBlock Classes="dim" Text="Geheugen" FontSize="10"/>
                                            <TextBlock Text="{Binding DeviceData.Memory, Converter={StaticResource MemoryConverter}}" FontWeight="SemiBold" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Security & Locks Card -->
                            <Border Classes="card" Padding="10,8">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="cardTitle" Text="BEVEILIGING &amp; STATUS" FontSize="11"/>
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto" Margin="0,2,0,0">
                                        <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,6,0">
                                            <TextBlock Classes="dim" Text="IMEI Nummer" FontSize="10"/>
                                            <TextBlock Text="{Binding DeviceData.Identifier}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="1" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Classes="dim" Text="Find My (iCloud)" FontSize="10"/>
                                                <Border Background="{DynamicResource TrackColor}" CornerRadius="3" Padding="3,1">
                                                    <TextBlock Text="{Binding DeviceData.FmiVerificationSource}" FontSize="8" Foreground="{DynamicResource TextDimColor}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DeviceData.ActivationLock, Converter={StaticResource ActivationLockConverter}, FallbackValue='Onbekend'}" 
                                                       Foreground="{Binding DeviceData.ActivationLock, Converter={StaticResource ActivationLockBrushConverter}}"
                                                       FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="1">
                                            <TextBlock Classes="dim" Text="Blacklist Status" FontSize="10"/>
                                            <TextBlock Text="Niet gecontroleerd" Classes="dim" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Component Audit List -->
                            <Border Classes="card" Padding="10,8">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="cardTitle" Text="ORIGINELE ONDERDELEN AUDIT (OEM)" FontSize="11"/>
                                    <ItemsControl ItemsSource="{Binding ComponentChecks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardDeepColor}" CornerRadius="6" Padding="8,4" Margin="0,0,0,4"
                                                        BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="210,*,*,90">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock Classes="dim" Text="Gelezen" FontSize="9"/>
                                                            <TextBlock Text="{Binding SerialRead}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="1">
                                                            <TextBlock Classes="dim" Text="Origineel" FontSize="9"/>
                                                            <TextBlock Text="{Binding SerialOriginal}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="3" CornerRadius="3" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Background="{Binding Status, Converter={x:Static vm:ComponentStatusToBrushConverter.Instance}}">
                                                            <TextBlock Text="{Binding Status, Converter={StaticResource ComponentStatusConverter}}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Integrated PWA Hardware Test Card -->
                        <Border Grid.Row="1" Grid.Column="1" Classes="card" VerticalAlignment="Top" Padding="10,8">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="cardTitle" Text="INTERACTIEVE HARDWARETEST" FontSize="11"/>
                                
                                <TextBlock Text="Scan met de camera van het toestel om display, touch, camera en audio te testen:" 
                                           Classes="dim" FontSize="11" TextWrapping="Wrap" LineHeight="15"/>

                                <!-- QR Container -->
                                <Border Background="White" CornerRadius="8" Padding="8" Width="150" Height="150" HorizontalAlignment="Center">
                                    <Image Source="{Binding QrCodeBitmap}" Stretch="Uniform"/>
                                </Border>

                                <SelectableTextBlock Text="{Binding WebRunnerUrl}" Foreground="{DynamicResource AccentColor}" 
                                                     FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center"/>

                                <Border Classes="pill neutral" HorizontalAlignment="Center" Padding="6,3">
                                    <TextBlock Classes="pillText" Text="{Binding InteractiveSessionStatus}" FontSize="10"/>
                                </Border>

                                <TextBlock Text="{Binding InteractiveTestSummary}" Foreground="{DynamicResource SuccessColor}" 
                                           FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>

                                <Button Classes="cta" Command="{Binding FinishInspectionCommand}" Content="Afronden" 
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0" Padding="0,8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ==================== STATE 3: SUMMARY (Results & Print) ==================== -->
                <Grid IsVisible="{Binding IsSummaryState}" RowDefinitions="Auto,*,Auto" Margin="20,12" MaxWidth="960" HorizontalAlignment="Stretch">
                    <!-- Top Row: Compact Grade Banner & Specs Summary Card -->
                    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
                        <!-- Top Grade & Result Banner -->
                        <Border Classes="card" Background="{DynamicResource CardDeepColor}" Padding="14,10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Summary_Title}" Classes="cardTitle" FontSize="11"/>
                                    <TextBlock Text="{Binding DeviceData, Converter={StaticResource ModelDisplayConverter}}" FontSize="18" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding DeviceData.Identifier, StringFormat='IMEI / Serienummer: {0}'}" Classes="dim" FontSize="11"/>
                                        <TextBlock Text="{Binding DeviceData.Storage, StringFormat='Opslag: {0}'}" Classes="dim" FontSize="11"/>
                                        <TextBlock Text="{Binding DeviceData.Memory, Converter={StaticResource MemoryConverter}, StringFormat='Geheugen: {0}'}" Classes="dim" FontSize="11"/>
                                        <TextBlock Text="{Binding DeviceData.Color, Converter={StaticResource ColorConverter}, StringFormat='Kleur: {0}'}" Classes="dim" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Big Quality Grade Pill & FMI Badge -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="pill" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource CardBorderColor}" Padding="8,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="iCloud (FMI)" FontSize="9" Classes="dim"/>
                                                <Border Background="{DynamicResource TrackColor}" CornerRadius="3" Padding="2,0">
                                                    <TextBlock Text="{Binding DeviceData.FmiVerificationSource}" FontSize="8" Foreground="{DynamicResource TextDimColor}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DeviceData.ActivationLock, Converter={StaticResource ActivationLockConverter}, FallbackValue='Onbekend'}"
                                                       Foreground="{Binding DeviceData.ActivationLock, Converter={StaticResource ActivationLockBrushConverter}}"
                                                       FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="pill success" Padding="12,6" CornerRadius="10">
                                        <TextBlock Text="{Binding SelectedGradeDisplay}" 
                                                   FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Hardware Checklist Summary Grid -->
                        <Border Grid.Row="1" Classes="card" Padding="12,8">
                            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto">
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Classes="dim" Text="Batterijconditie" FontSize="10"/>
                                    <TextBlock Text="{Binding DeviceData.BatteryHealth, Converter={StaticResource BatteryConverter}}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Classes="dim" Text="Factuurmethode" FontSize="10"/>
                                    <TextBlock Text="{Binding SelectedInvoiceMethodDisplay}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock Classes="dim" Text="SIM Lock" FontSize="10"/>
                                    <TextBlock Text="{DynamicResource Summary_SimLockFree}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SuccessColor}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="1">
                                    <TextBlock Classes="dim" Text="Hardware Tests (PWA)" FontSize="10"/>
                                    <TextBlock Text="{Binding InteractiveTestSummary}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SuccessColor}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Middle Row: Inspection Report (Defects & Non-OEM Only) -->
                    <Border Grid.Row="1" Classes="card" Padding="12,10" Margin="0,0,0,10">
                        <Grid RowDefinitions="Auto,Auto,*,Auto,*">
                            <!-- Table Title Bar -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <TextBlock Classes="cardTitle" Text="INSPECTIERAPPORT (AFWIJKINGEN &amp; DEFECTEN)" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Enkel niet-originele onderdelen en mislukte of overgeslagen tests" Classes="dim" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Component Defects Section -->
                            <TextBlock Grid.Row="1" Text="ONDERDELEN AUDIT (NIET-OEM / VERVANGEN)" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextDimColor}" Margin="0,4,0,4"/>
                            
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="130">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding DefectiveComponents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#fee2e2" CornerRadius="4" Padding="8,5" Margin="0,0,0,3"
                                                        BorderBrush="#fca5a5" BorderThickness="1">
                                                    <Grid ColumnDefinitions="200,*,*,90">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#991b1b" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SerialOriginal}" FontSize="11" Foreground="#7f1d1d" VerticalAlignment="Center" Classes="dim"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SerialRead}" FontSize="11" Foreground="#991b1b" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="3" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#dc2626">
                                                            <TextBlock Text="{Binding Status, Converter={StaticResource ComponentStatusConverter}}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border IsVisible="{Binding !DefectiveComponents.Count}" Background="#dcfce7" CornerRadius="4" Padding="8,6" BorderBrush="#86efac" BorderThickness="1">
                                        <TextBlock Text="[OK] Alle onderdelen zijn origineel (OEM)" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Interactive Tests Section -->
                            <TextBlock Grid.Row="3" Text="INTERACTIEVE HARDWARETESTS" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextDimColor}" Margin="0,8,0,4"/>
                            
                            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="130">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding FailedInteractiveTests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#fee2e2" CornerRadius="4" Padding="8,5" Margin="0,0,0,3"
                                                        BorderBrush="#fca5a5" BorderThickness="1">
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#991b1b" VerticalAlignment="Center"/>
                                                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="3" Padding="6,2" Background="#dc2626">
                                                            <TextBlock Text="MISLUKT" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <!-- Why, not just that. The phone sends the note with the row; showing
                                                             only the name and the badge left the operator to guess. -->
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                   Text="{Binding Notes}" FontSize="10" Foreground="#7f1d1d"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding SkippedInteractiveTests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#fef3c7" CornerRadius="4" Padding="8,5" Margin="0,0,0,3"
                                                        BorderBrush="#fcd34d" BorderThickness="1">
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#92400e" VerticalAlignment="Center"/>
                                                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="3" Padding="6,2" Background="#d97706">
                                                            <TextBlock Text="OVERGESLAGEN" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <!-- Why it did not run: the browser refused, the phone never sent a
                                                             fix, or the browser has no location API at all. -->
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                   Text="{Binding Notes}" FontSize="10" Foreground="#78350f"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border IsVisible="{Binding NoInteractiveTestProblems}" Background="#dcfce7" CornerRadius="4" Padding="8,6" BorderBrush="#86efac" BorderThickness="1">
                                        <TextBlock Text="[OK] Alle interactieve tests zijn geslaagd" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Bottom Row: Fixed Anchored Action Buttons (ALWAYS VISIBLE WITHOUT SCROLLING!) -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Button Grid.Column="0" Classes="kioskSecondary" Command="{Binding RetestCommand}" 
                                Content="{DynamicResource Summary_BtnRetest}" Padding="16,10" HorizontalContentAlignment="Center"/>
                        
                        <Button Grid.Column="1" Classes="kioskPrint" Command="{Binding OpenLabelCommand}" 
                                Content="{DynamicResource Summary_BtnPrint}" Margin="12,0" Padding="20,12" FontSize="14" FontWeight="Bold"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        
                        <Button Grid.Column="2" Classes="kioskSecondary" Command="{Binding BackToIdleCommand}" 
                                Content="{DynamicResource Summary_BtnNext}" Padding="16,10" HorizontalContentAlignment="Center"/>
                    </Grid>
                </Grid>
            </Panel>
        </Grid>

        <!-- ==================== SETTINGS SLIDE-IN DRAWER OVERLAY ==================== -->
        <Panel IsVisible="{Binding IsSettingsDrawerOpen}" ZIndex="50">
            <!-- Semi-transparent backdrop -->
            <Button Background="{DynamicResource OverlayColor}" Command="{Binding ToggleSettingsCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0"/>

            <!-- Drawer Container -->
            <Border Width="420" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource CardBorderColor}" 
                    BorderThickness="1,0,0,0" BoxShadow="-8 0 32 0 #55000000" Padding="24">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Instellingen" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="iconBtn" Command="{Binding ToggleSettingsCommand}">
                                <TextBlock Text="Sluiten" FontWeight="SemiBold" Foreground="{DynamicResource TextDimColor}"/>
                            </Button>
                        </Grid>

                        <Separator/>

                        <!-- Daily Operator Needs (Default Simple View) -->
                        <TextBlock Text="{DynamicResource Settings_DailyOptions}" Classes="cardTitle"/>

                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource Settings_Language}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" Width="130"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource Settings_Theme}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Width="130"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource Settings_Quality}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding DefaultQuality}" Width="130"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource Settings_Payment}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding DefaultPaymentMethod}" Width="130"/>
                            </Grid>

                            <CheckBox Content="{DynamicResource Settings_AutoDetect}" IsChecked="{Binding AutoDetectOnPlug}"/>
                            <CheckBox Content="{DynamicResource Settings_AutoStartWebTest}" IsChecked="{Binding AutoStartWebTest}"/>
                            <CheckBox Content="{DynamicResource Settings_RequirePwaTest}" IsChecked="{Binding RequirePwaTest}"/>
                            <CheckBox Content="{DynamicResource Settings_AutoFinishAfterTest}" IsChecked="{Binding AutoFinishAfterTest}"/>
                            <CheckBox Content="{DynamicResource Settings_ShowSummary}" IsChecked="{Binding ShowSummaryScreenAfterTesting}"/>
                            
                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <TextBlock Text="{DynamicResource Settings_ImeiApiKey}" FontSize="12" Foreground="{DynamicResource TextDimColor}"/>
                                <TextBox Text="{Binding ImeiApiKey}" Watermark="SickW / IMEIPro API Key..." PasswordChar="*"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,8,0,8"/>

                        <!-- How the phone reaches this pc: two options that decide the address it
                             is given. They get a heading of their own because they decide whether
                             the camera, the microphone and the motion sensors can be reached at
                             all, and loose at the end of the advanced list they read as debug
                             toggles instead of as the choice between a cable and the internet. -->
                        <TextBlock Text="{DynamicResource Settings_Connection}" Classes="cardTitle" Margin="0,4,0,0"/>

                        <StackPanel Spacing="10">
                            <CheckBox IsChecked="{Binding UseSecureOrigin}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{DynamicResource Settings_SecureOrigin}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource Settings_SecureOriginDesc}" Classes="dim"
                                               FontSize="11" TextWrapping="Wrap" MaxWidth="340"/>
                                </StackPanel>
                            </CheckBox>

                            <CheckBox IsChecked="{Binding UsePublicTunnel}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{DynamicResource Settings_PublicTunnel}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource Settings_PublicTunnelDesc}" Classes="dim"
                                               FontSize="11" TextWrapping="Wrap" MaxWidth="340"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <!--
                            Licensing lives in the panel the title bar pill opens,
                            so this is only a pointer: the tier as it stands, and
                            one button over to where a key gets typed in. Keeping
                            the key box here as well meant two copies of the same
                            form that could disagree after an activation.
                        -->
                        <Border Classes="card" Padding="16" Margin="0,8,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{DynamicResource Settings_LicensingCardTitle}" Classes="cardTitle"/>

                                <TextBlock Text="{Binding Licensing.LicensingStatusText, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="14"/>

                                <Button Classes="cta" Command="{Binding ManageLicenseCommand}"
                                        Content="{DynamicResource Settings_ManageLicense}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,8,0,8"/>

                        <!-- Advanced Section Toggle -->
                        <Button Classes="kioskSecondary" Command="{Binding OpenTroubleshootModalCommand}"
                                Content="{DynamicResource Btn_Troubleshoot}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                        <Button Classes="kioskSecondary" Command="{Binding OpenLogsModalCommand}"
                                Content="{DynamicResource Btn_Logs}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                        <Separator Margin="0,8,0,8"/>

                        <!-- Advanced Automation (Clean divided list, no accordions) -->
                        <TextBlock Text="{DynamicResource Settings_Advanced}" Classes="cardTitle" Margin="0,4,0,0"/>

                        <StackPanel Spacing="10">
                            <CheckBox Content="{DynamicResource Settings_AutoActivate}" IsChecked="{Binding AutoActivate}"/>
                            <CheckBox Content="{DynamicResource Settings_RunDiagnostics}" IsChecked="{Binding RunDiagnostics}"/>
                            <CheckBox Content="{DynamicResource Settings_Enable85Checker}" IsChecked="{Binding Enable85PercentChecker}"/>
                            <CheckBox Content="{DynamicResource Settings_OpenEditor}" IsChecked="{Binding OpenEditorBeforePrint}"/>
                            <CheckBox Content="Debug Modus &amp; Netwerk Tracing" IsChecked="{Binding IsDebugMode}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Panel>

        <!-- ==================== SYSTEM LOGS MODAL OVERLAY ==================== -->
        <Panel IsVisible="{Binding IsLogsModalOpen}" ZIndex="60">
            <Rectangle Fill="{DynamicResource OverlayColor}"/>
            <Border Classes="card" Width="850" Height="580" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 24 64 0 #77000000" Padding="20">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <TextBlock Text="Systeemlogboeken &amp; Tool Output" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="iconBtn" Command="{Binding CloseLogsModalCommand}">
                            <TextBlock Text="Sluiten" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                        </Button>
                    </Grid>

                    <!-- Filter Controls -->
                    <Border Grid.Row="1" Background="{DynamicResource CardDeepColor}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,12,*,12,Auto,8,Auto">
                            <CheckBox Grid.Column="0" Content="Debug" IsChecked="{Binding LogsViewModel.ShowDebug}" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="1" Content="Info" IsChecked="{Binding LogsViewModel.ShowInfo}" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="2" Content="Warning" IsChecked="{Binding LogsViewModel.ShowWarning}" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="3" Content="Error" IsChecked="{Binding LogsViewModel.ShowError}"/>
                            <TextBox Grid.Column="5" Text="{Binding LogsViewModel.SearchQuery}" Watermark="Zoeken in logs..."/>
                            <Button Grid.Column="7" Content="Wissen" Command="{Binding LogsViewModel.ClearLogsCommand}"/>
                            <Button Grid.Column="9" Content="Kopiëren" Command="{Binding LogsViewModel.CopyLogsCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Logs List -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LogsViewModel.Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardDeepColor}" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="80,65,85,*">
                                            <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" FontFamily="Consolas,Courier New" FontSize="11" Foreground="{DynamicResource TextDimColor}"/>
                                            <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Background="{Binding LevelColor}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Level}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDimColor}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas,Courier New"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Panel>

        <!-- ==================== TROUBLESHOOT MODAL OVERLAY ==================== -->
        <Panel IsVisible="{Binding IsTroubleshootModalOpen}" ZIndex="60">
            <Rectangle Fill="{DynamicResource OverlayColor}"/>
            <Border Classes="card" Width="850" Height="580" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 24 64 0 #77000000" Padding="20">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <TextBlock Text="USB &amp; Driver Diagnose" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="iconBtn" Command="{Binding CloseTroubleshootModalCommand}">
                            <TextBlock Text="Sluiten" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Classes="card" Background="{DynamicResource CardDeepColor}" Padding="12" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto,8,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding TroubleshootViewModel.OverallStatus}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="cta" Content="Los Alles Op" Command="{Binding TroubleshootViewModel.FixAllCommand}"/>
                            <Button Grid.Column="3" Content="Opnieuw Scannen" Command="{Binding TroubleshootViewModel.RunDiagnosticsCommand}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TroubleshootViewModel.Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Background="{DynamicResource CardDeepColor}" Padding="12" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Category}" Classes="dim" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="{DynamicResource WarnColor}" TextWrapping="Wrap" IsVisible="{Binding Resolution, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Classes="pill" 
                                                    Classes.success="{Binding IsPass}"
                                                    Classes.danger="{Binding IsFail}"
                                                    Classes.warn="{Binding IsWarning}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="pillText" Text="{Binding Severity}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Panel>

        <!-- ==================== Quality & Payment Dialog Popups ==================== -->
        <Panel IsVisible="{Binding IsQualityPopupVisible}" ZIndex="70">
            <Rectangle Fill="{DynamicResource OverlayColor}"/>
            <Border Classes="card" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 24 60 0 #66000000" Padding="28">
                <StackPanel Spacing="14">
                    <TextBlock Text="Kies de kwaliteit" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Button Classes="cta" Height="48" Content="A - Zo goed als nieuw" Command="{Binding SetQualityCommand}" CommandParameter="A" Background="{DynamicResource SuccessColor}"/>
                    <Button Classes="cta" Height="48" Content="B - Licht gebruik" Command="{Binding SetQualityCommand}" CommandParameter="B" Background="{DynamicResource WarnColor}"/>
                    <Button Classes="cta" Height="48" Content="C - Duidelijke sporen" Command="{Binding SetQualityCommand}" CommandParameter="C" Background="{DynamicResource DangerColor}"/>
                </StackPanel>
            </Border>
        </Panel>

        <Panel IsVisible="{Binding IsPaymentPopupVisible}" ZIndex="70">
            <Rectangle Fill="{DynamicResource OverlayColor}"/>
            <Border Classes="card" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 24 60 0 #66000000" Padding="28">
                <StackPanel Spacing="14">
                    <TextBlock Text="Factuurmethode" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Button Classes="cta" Height="48" Content="Marge (0% BTW)" Command="{Binding SetPaymentMethodCommand}" CommandParameter="Marge" Background="{DynamicResource AccentColor}"/>
                    <Button Classes="cta" Height="48" Content="BTW (21%)" Command="{Binding SetPaymentMethodCommand}" CommandParameter="BTW" Background="{DynamicResource TrackColor}"/>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ==================== First-run introduction (top of everything) ==================== -->
        <views:IntroView IsVisible="{Binding IsIntroVisible}" ZIndex="100"/>

        <!--
            License panel, opened from the status pill in the title bar or from
            settings. It is the one place that answers "what am I on and how do I
            change that": the tier in words, the scans left on the free tier, the
            key box when there is no key yet, and the pricing page one click away.
            Sits below the settings drawer so the two cannot pile up, and below
            the introduction screen, which covers the whole window anyway.
        -->
        <Panel IsVisible="{Binding IsLicensePanelOpen}" ZIndex="45">
            <Button Background="Transparent" BorderThickness="0"
                    Command="{Binding ToggleLicensePanelCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Content=""/>

            <Border Classes="card" Width="340" Padding="20"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,70,24,0"
                    BoxShadow="0 12 32 0 #66000000">
                <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Licensing_PanelTitle}"
                                   Classes="cardTitle" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="iconBtn"
                                Command="{Binding ToggleLicensePanelCommand}"
                                ToolTip.Tip="{DynamicResource Licensing_PanelClose}"
                                Content="&#x2715;" FontSize="12"
                                Foreground="{DynamicResource TextDimColor}"
                                Padding="6"/>
                    </Grid>

                    <!-- The tier, said in full. -->
                    <TextBlock Text="{Binding Licensing.LicensingStatusText}"
                               FontWeight="SemiBold" FontSize="15"/>

                    <!-- Scans left, as words and as a bar, only while on the free tier. -->
                    <StackPanel Spacing="6" IsVisible="{Binding Licensing.IsFreeTier}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource Licensing_PanelScansLeft}"
                                       Classes="dim" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Licensing.TierSummary}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="10"
                                     Value="{Binding Licensing.UsedScans, Mode=OneWay}"
                                     Height="6"/>
                    </StackPanel>

                    <Separator/>

                    <!-- Key box: only there is something to type into. -->
                    <StackPanel Spacing="8" IsVisible="{Binding Licensing.IsFreeTier}">
                        <TextBox Text="{Binding Licensing.LicenseKeyInput}"
                                 Watermark="{DynamicResource Settings_LicenseKeyWatermark}"
                                 PasswordChar="*"/>
                        <Button Classes="cta"
                                Command="{Binding Licensing.ValidateCommand}"
                                IsEnabled="{Binding !Licensing.IsActivating}"
                                Content="{DynamicResource Settings_ValidateActivate}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <TextBlock Text="{Binding Licensing.StatusMessage}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarnColor}"/>
                    </StackPanel>

                    <Button Classes="kioskSecondary"
                            Command="{Binding Licensing.OpenPricingCommand}"
                            Content="{DynamicResource Intro_SeePricing}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
