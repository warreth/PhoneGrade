<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhoneGrade.UI.ViewModels"
        xmlns:views="using:PhoneGrade.UI.Views"
        x:Class="PhoneGrade.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PhoneGrade Kiosk"
        Width="1050" Height="740"
        MinWidth="850" MinHeight="620"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/avalonia-logo.ico">

    <Panel>
        <Grid RowDefinitions="64,*">
            <!--
                ==================== FIXED HEADER BAR ====================

                Three columns: what the window is, what it is working on, and what
                can be opened. The outer two are Auto and only as wide as their
                content, so the middle one is the column that gives way - it clips
                and ellipsizes instead of pushing the buttons off the right edge,
                which is what the old 280px / 200px columns did at the minimum
                window width.
            -->
            <Border Grid.Row="0" Classes="topBar" Height="64">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <!-- Left: brand and whether a phone is plugged in -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                        <!-- Unified PG SVG Logo -->
                        <Viewbox Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center">
                            <Canvas Width="100" Height="100">
                                <Rectangle Fill="#2563eb" Width="100" Height="100" RadiusX="16" RadiusY="16"/>
                                <TextBlock Text="PG" FontSize="54" Foreground="#ffffff" FontFamily="system-ui, -apple-system" FontWeight="Bold" Canvas.Left="19" Canvas.Top="14"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Classes="brand" Text="PhoneGrade"/>

                        <!--
                            Two labels, one pill: the wording lives in the string
                            dictionaries so a language switch follows, and the
                            converter that used to print the words itself had no
                            way of knowing the language had changed.
                        -->
                        <Border Classes="pill"
                                Classes.success="{Binding SelectedDevice.Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Classes.neutral="{Binding SelectedDevice.Key, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                            <Panel>
                                <TextBlock Classes="pillText" Text="{DynamicResource Header_Connected}"
                                           IsVisible="{Binding SelectedDevice.Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Classes="pillText" Text="{DynamicResource Header_NoDevice}"
                                           IsVisible="{Binding SelectedDevice.Key, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                            </Panel>
                        </Border>
                    </StackPanel>

                    <!-- Center: what is being worked on, clipped so it can never
                         push the buttons on the right out of the window -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            ClipToBounds="True" Margin="16,0" MaxWidth="460">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasDevice}">
                            <SelectableTextBlock Text="{Binding DeviceData, Converter={StaticResource ModelDisplayConverter}}"
                                                 FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                 MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                            <Border Width="1" Height="13" Background="{DynamicResource CardBorderColor}" VerticalAlignment="Center"/>
                            <SelectableTextBlock Text="{Binding DeviceData.Identifier}" Classes="dim" FontSize="12"
                                                 VerticalAlignment="Center" MaxWidth="130" TextTrimming="CharacterEllipsis"/>
                            <Border Width="1" Height="13" Background="{DynamicResource CardBorderColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Status}" Classes="dim" FontSize="12" VerticalAlignment="Center"
                                       MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: license status and settings. Refreshing the device
                         list is no longer a button up here: it sits on the screen
                         where a phone is waited for, and the list also refreshes
                         on plug and every few seconds by itself. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" VerticalAlignment="Center">
                        <!--
                            The whole licensing story in one place: tier, scans left
                            on it, and a click into the panel that activates a key
                            or opens the pricing page. Amber once the run is close
                            to ending, red when it has ended.
                        -->
                        <Button Classes="statusPill"
                                Classes.success="{Binding Licensing.IsPro}"
                                Classes.warn="{Binding Licensing.IsAlmostOut}"
                                Classes.danger="{Binding Licensing.IsLimitReached}"
                                Classes.neutral="{Binding Licensing.IsFreeSteady}"
                                Command="{Binding ToggleLicensePanelCommand}"
                                IsVisible="{Binding Licensing, Converter={x:Static ObjectConverters.IsNotNull}}"
                                ToolTip.Tip="{DynamicResource Licensing_PanelHint}">
                            <TextBlock Classes="pillText" Text="{Binding Licensing.TierSummary}"/>
                        </Button>

                        <Button Classes="headerBtn" Classes.on="{Binding IsSettingsDrawerOpen}"
                                Command="{Binding ToggleSettingsCommand}"
                                ToolTip.Tip="{DynamicResource Header_SettingsTooltip}"
                                Width="36" Height="36" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Path Classes="glyph" Fill="{DynamicResource TextDimColor}"
                                  Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94l-0.36-2.54c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.44,0.17-0.47,0.41l-0.36,2.54c-0.59,0.24-1.13,0.56-1.62,0.94l-2.39-0.96c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87c-0.12,0.21-0.08,0.47,0.12,0.61l2.03,1.58c-0.05,0.3-0.09,0.63-0.09,0.94s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN DYNAMIC CONTENT AREA ==================== -->
            <!--
                The banner takes the first row and the states share the second one,
                so a trial warning pushes the work down instead of lying on top of
                it: as siblings in a Panel the two overlap and the banner covered
                the first lines of whatever state was showing.
            -->
            <Grid Grid.Row="1" Background="{DynamicResource AppBgColor}" RowDefinitions="Auto,*">

                <!-- Trial limit warning banner (appears above idle/active states) -->
                <Border Grid.Row="0" Classes="card" IsVisible="{Binding IsTrialLimitReached}"
                        BorderBrush="{DynamicResource WarnColor}" BorderThickness="2"
                        Padding="16" Margin="32,16,32,0">
                    <StackPanel Spacing="12">
                        <TextBlock TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{DynamicResource WarnColor}" FontWeight="SemiBold"
                                   Text="{DynamicResource TrialLimit_Reached}"/>
                    </StackPanel>
                </Border>

                <!-- ==================== STATE 1: IDLE ==================== -->
                <Grid x:Name="IdleState" Grid.Row="1" IsVisible="{Binding IsIdleState}" RowDefinitions="*,Auto,*" Margin="32">
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" MaxWidth="500">
                        <Border Width="88" Height="88" CornerRadius="44" Background="{DynamicResource CardColor}"
                                BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="2"
                                HorizontalAlignment="Center">
                            <TextBlock Text="USB" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}"/>
                        </Border>

                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Idle_Title}" FontSize="24" FontWeight="Bold" 
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Idle_Lead}"
                                       Classes="dim" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                        </StackPanel>

                        <!-- Device dropdown selector if multiple connected -->
                        <Border Classes="card" IsVisible="{Binding Devices.Count}" Padding="16" Margin="0,8,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{DynamicResource Idle_DetectedDevices}" FontWeight="SemiBold" FontSize="12"/>
                                <!-- The selection is only ever written into the view model, never read out of a
                                     cleared control: see DeviceSelectionChanged. -->
                                <ComboBox ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice, Mode=OneWay}"
                                          SelectionChanged="DeviceSelectionChanged"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Value}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Classes="cta" Command="{Binding StartCommand}" Content="{DynamicResource Btn_StartInspection}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>


                        <!--
                            The USB debugging how-to is not here any more. As an
                            inline card it pushed the rest of the idle screen down
                            until it overflowed, and it was on screen whenever the
                            view model happened to look idle, which is how an iPad
                            ended up with a guide for Android. It is an overlay
                            below, opened by one flag from the adb probe.
                        -->

                        <!--
                            One scan button, not two. The legacy poll that used to sit
                            beside this one did the same job through a different door
                            and with none of what follows it: no status line, no adb
                            gate, no going back to idle when the cable is empty.
                        -->
                        <Button Classes="kioskSecondary" Command="{Binding RefreshDevicesCommand}" Content="{DynamicResource Btn_ScanManually}" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                        <!--
                            The diagnostics used to be reachable only through
                            settings, the last place an operator looks when the
                            screen in front of them is the one that will not
                            find their phone.
                        -->
                        <Button Classes="kioskSecondary" Command="{Binding OpenTroubleshootModalCommand}"
                                Content="{DynamicResource Btn_Troubleshoot}"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ==================== STATE 2: ACTIVE (Reading Specs & Testing) ==================== -->
                <ScrollViewer x:Name="ActiveState" Grid.Row="1" IsVisible="{Binding IsActiveState}" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="*,300" Margin="16,12" RowDefinitions="Auto,*">
                        <!-- Top: Progress bar -->
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="card" Padding="12,8" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <!-- The message can be a full instruction, so it is allowed a second
                                         line rather than cut in the middle of the sentence. -->
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="kioskSecondary" Command="{Binding RetestCommand}" Content="{DynamicResource Btn_Rescan}" Margin="12,0,0,0" Padding="10,6"/>
                            </Grid>
                        </Border>

                        <!-- Left Column: Device Specs & Component Audit -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="10" Margin="0,0,12,0">
                            <!-- Specs Card -->
                            <Border Classes="card" Padding="10,8">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="cardTitle" Text="{DynamicResource Active_SpecsTitle}" FontSize="11"/>
                                    <!-- Two rows: what the phone is, and how it did. Storage is
                                         here because it is one of the things that decides a
                                         grade; memory is not, and the third row it used to
                                         occupy is gone rather than left empty. -->
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="1" Margin="0,0,6,8">
                                            <TextBlock Classes="dim" Text="{DynamicResource Spec_Model}" FontSize="10"/>
                                            <SelectableTextBlock Text="{Binding DeviceData, Converter={StaticResource ModelDisplayConverter}}" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1" Margin="0,0,6,8">
                                            <TextBlock Classes="dim" Text="{DynamicResource Spec_Serial}" FontSize="10"/>
                                            <SelectableTextBlock Text="{Binding DeviceData.Identifier}" FontWeight="SemiBold" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="1" Margin="0,0,0,8">
                                            <TextBlock Classes="dim" Text="{DynamicResource Spec_Storage}" FontSize="10"/>
                                            <SelectableTextBlock Text="{Binding DeviceData.Storage}" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="1" Margin="0,0,6,0">
                                            <TextBlock Classes="dim" Text="{DynamicResource Spec_Color}" FontSize="10"/>
                                            <SelectableTextBlock Text="{Binding DeviceData.Color, Converter={StaticResource ColorConverter}}" FontWeight="SemiBold" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1" Margin="0,0,6,0">
                                            <TextBlock Classes="dim" Text="{DynamicResource Spec_Battery}" FontSize="10"/>
                                            <SelectableTextBlock Text="{Binding DeviceData.BatteryHealth, Converter={StaticResource BatteryConverter}}" FontWeight="SemiBold" FontSize="12"/>
                                            <SelectableTextBlock Text="{Binding DeviceData.BatteryLevel, Converter={StaticResource BatteryLevelConverter}}" Classes="dim" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="1">
                                            <TextBlock Classes="dim" Text="{DynamicResource Spec_Grade}" FontSize="10"/>
                                            <SelectableTextBlock Text="{Binding SelectedGradeDisplay}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentColor}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Security & Locks Card -->
                            <Border Classes="card" Padding="10,8">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="cardTitle" Text="{DynamicResource Active_SecurityTitle}" FontSize="11"/>
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto" Margin="0,2,0,0">
                                        <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,6,0">
                                            <TextBlock Classes="dim" Text="{DynamicResource Spec_Imei}" FontSize="10"/>
                                            <SelectableTextBlock Text="{Binding DeviceData.Identifier}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="1" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Classes="dim" Text="{DynamicResource Spec_FindMy}" FontSize="10"/>
                                                <Border Background="{DynamicResource TrackColor}" CornerRadius="3" Padding="3,1">
                                                    <SelectableTextBlock Text="{Binding DeviceData.FmiVerificationSource}" FontSize="8" Foreground="{DynamicResource TextDimColor}"/>
                                                </Border>
                                            </StackPanel>
                                            <SelectableTextBlock Text="{Binding DeviceData.ActivationLock, Converter={StaticResource ActivationLockConverter}}" 
                                                       Foreground="{Binding DeviceData.ActivationLock, Converter={StaticResource ActivationLockBrushConverter}}"
                                                       FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="1">
                                            <TextBlock Classes="dim" Text="{DynamicResource Spec_Blacklist}" FontSize="10"/>
                                            <SelectableTextBlock Text="{DynamicResource Spec_NotChecked}" Classes="dim" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Component Audit List -->
                            <Border Classes="card" Padding="10,8">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="cardTitle" Text="{DynamicResource Active_OemTitle}" FontSize="11"/>
                                    <ItemsControl ItemsSource="{Binding ComponentChecks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardDeepColor}" CornerRadius="6" Padding="8,4" Margin="0,0,0,4"
                                                        BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1">
                                                    <!--
                                                        The badge is as wide as its word rather than a fixed 90 and
                                                        each cell keeps its own gutter: at the minimum window width the
                                                        three cells had no space between them and the header, the value
                                                        and the next header ran into one another. The two value columns
                                                        carry their own short labels and are in the same order as the
                                                        report, so the eye does not have to learn the table twice.
                                                    -->
                                                    <Grid ColumnDefinitions="210,*,*,Auto">
                                                        <SelectableTextBlock Grid.Column="0" Margin="0,0,10,0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Grid.Column="1" Margin="0,0,10,0" Spacing="1">
                                                            <TextBlock Classes="dim" Text="{DynamicResource Active_ColFactory}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                            <SelectableTextBlock Text="{Binding SerialOriginal}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="0,0,10,0" Spacing="1">
                                                            <TextBlock Classes="dim" Text="{DynamicResource Active_ColRead}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                            <SelectableTextBlock Text="{Binding SerialRead}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="3" CornerRadius="3" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Background="{Binding Status, Converter={x:Static vm:ComponentStatusToBrushConverter.Instance}}">
                                                            <TextBlock Text="{Binding Status, Converter={StaticResource ComponentStatusConverter}}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Integrated PWA Hardware Test Card -->
                        <Border Grid.Row="1" Grid.Column="1" Classes="card" VerticalAlignment="Top" Padding="10,8">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="cardTitle" Text="{DynamicResource Active_InteractiveTitle}" FontSize="11"/>
                                
                                <TextBlock Text="{DynamicResource Active_InteractiveLead}" 
                                           Classes="dim" FontSize="11" TextWrapping="Wrap" LineHeight="15"/>

                                <!-- QR Container -->
                                <Border Background="White" CornerRadius="8" Padding="8" Width="150" Height="150" HorizontalAlignment="Center">
                                    <Image Source="{Binding QrCodeBitmap}" Stretch="Uniform"/>
                                </Border>

                                <SelectableTextBlock Text="{Binding WebRunnerUrl}" Foreground="{DynamicResource AccentColor}" 
                                                     FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center"/>

                                <Border Classes="pill neutral" HorizontalAlignment="Center" Padding="6,3">
                                    <TextBlock Classes="pillText" Text="{Binding InteractiveSessionStatus}" FontSize="10"/>
                                </Border>

                                <TextBlock Text="{Binding InteractiveTestSummary}" Foreground="{DynamicResource SuccessColor}" 
                                           FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>

                                <Button Classes="cta" Command="{Binding FinishInspectionCommand}" Content="{DynamicResource Btn_Finish}" 
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0" Padding="0,8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ==================== STATE 3: SUMMARY (Results & Print) ==================== -->
                <!--
                    Three rows that never move: what was found, the report, and the
                    actions. Only the report scrolls, so the print button is on
                    screen at the minimum window height. Every colour on a row comes
                    from the theme - the rows used to carry their own light red and
                    light green, which in the dark theme read as two glowing blocks.
                -->
                <Grid x:Name="SummaryState" Grid.Row="1" IsVisible="{Binding IsSummaryState}" RowDefinitions="Auto,*,Auto">
                    <!-- What was found -->
                    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="24,20,24,12" MaxWidth="960"
                          HorizontalAlignment="Stretch">
                        <Border Classes="settingCard" Padding="16,12" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Summary_Title}" Classes="cardTitle" FontSize="11"/>
                                    <SelectableTextBlock Text="{Binding DeviceData, Converter={StaticResource ModelDisplayConverter}}" FontSize="18" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{DynamicResource Summary_Imei}" Classes="dim" FontSize="11"/>
                                            <SelectableTextBlock Text="{Binding DeviceData.Identifier}" Classes="dim" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{DynamicResource Summary_Storage}" Classes="dim" FontSize="11"/>
                                            <SelectableTextBlock Text="{Binding DeviceData.Storage}" Classes="dim" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{DynamicResource Summary_Memory}" Classes="dim" FontSize="11"/>
                                            <SelectableTextBlock Text="{Binding DeviceData.Memory, Converter={StaticResource MemoryConverter}}" Classes="dim" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{DynamicResource Summary_Color}" Classes="dim" FontSize="11"/>
                                            <SelectableTextBlock Text="{Binding DeviceData.Color, Converter={StaticResource ColorConverter}}" Classes="dim" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Big Quality Grade Pill & FMI Badge -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="pill" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource CardBorderColor}" Padding="8,4">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{DynamicResource Summary_Fmi}" FontSize="9" Classes="dim"/>
                                                <Border Background="{DynamicResource TrackColor}" CornerRadius="3" Padding="2,0">
                                                    <SelectableTextBlock Text="{Binding DeviceData.FmiVerificationSource}" FontSize="8" Foreground="{DynamicResource TextDimColor}"/>
                                                </Border>
                                            </StackPanel>
                                            <SelectableTextBlock Text="{Binding DeviceData.ActivationLock, Converter={StaticResource ActivationLockConverter}, FallbackValue='Onbekend'}"
                                                       Foreground="{Binding DeviceData.ActivationLock, Converter={StaticResource ActivationLockBrushConverter}}"
                                                       FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="pill success" Padding="12,6" CornerRadius="10">
                                        <TextBlock Text="{Binding SelectedGradeDisplay}"
                                                   FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Hardware checklist at a glance -->
                        <Border Grid.Row="1" Classes="settingCard" Padding="16,10">
                            <Grid ColumnDefinitions="*,*,*,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Classes="fieldLabel" Text="{DynamicResource Summary_BatteryHealth}"/>
                                    <SelectableTextBlock Text="{Binding DeviceData.BatteryHealth, Converter={StaticResource BatteryConverter}}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="fieldLabel" Text="{DynamicResource Summary_InvoiceMethod}"/>
                                    <SelectableTextBlock Text="{Binding SelectedInvoiceMethodDisplay}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Classes="fieldLabel" Text="{DynamicResource Summary_SimLock}"/>
                                    <SelectableTextBlock Text="{DynamicResource Summary_SimLockFree}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SuccessColor}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="2">
                                    <TextBlock Classes="fieldLabel" Text="{DynamicResource Summary_HardwareTests}"/>
                                    <SelectableTextBlock Text="{Binding InteractiveTestSummary}" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource SuccessColor}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- The report: deviations only, and the only thing that scrolls.
                         It is top aligned because the row it sits in is sized to
                         what is left over: a short report used to stretch to the
                         footer and present a card with nothing in its lower half. -->
                    <Border Grid.Row="1" Classes="card" Margin="24,0" Padding="16,12" VerticalAlignment="Top">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Classes="cardTitle" Text="{DynamicResource Summary_ReportTitle}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Summary_ReportNote}" Classes="dim" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="4">

                                    <TextBlock Text="{DynamicResource Summary_AuditSection}" Classes="fieldLabel" Margin="0,4,0,6"/>
                                    <ItemsControl ItemsSource="{Binding DefectiveComponents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="reportRow bad">
                                                    <Grid ColumnDefinitions="170,*,*,Auto">
                                                        <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Grid.Column="1" Spacing="1" Margin="12,0">
                                                            <TextBlock Classes="fieldLabel" Text="{DynamicResource Summary_ColFactory}" FontSize="9"/>
                                                            <SelectableTextBlock Text="{Binding SerialOriginal}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="1" Margin="12,0">
                                                            <TextBlock Classes="fieldLabel" Text="{DynamicResource Summary_ColRead}" FontSize="9"/>
                                                            <SelectableTextBlock Text="{Binding SerialRead}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="3" Classes="chip bad">
                                                            <TextBlock Text="{Binding Status, Converter={StaticResource ComponentStatusConverter}}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Classes="reportRow ok" IsVisible="{Binding !DefectiveComponents.Count}">
                                        <TextBlock Classes="emptyNote" Text="{DynamicResource Summary_AllOemOriginal}"/>
                                    </Border>

                                    <TextBlock Text="{DynamicResource Summary_TestsSection}" Classes="fieldLabel" Margin="0,12,0,6"/>
                                    <ItemsControl ItemsSource="{Binding FailedInteractiveTests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="reportRow bad">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                        <Border Grid.Row="0" Grid.Column="1" Classes="chip bad">
                                                            <TextBlock Text="{DynamicResource Report_Failed}"/>
                                                        </Border>
                                                        <!-- The way out of the report, one row at a time. The command is
                                                             taken from the list that owns this template, because inside a
                                                             row the data context is the row itself. -->
                                                        <Button Grid.Row="0" Grid.Column="2" Classes="dismissTest"
                                                                Content="&#x2715;"
                                                                ToolTip.Tip="{DynamicResource Report_DismissTest}"
                                                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.DismissInteractiveTestCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <!-- Why, not just that. The phone sends the note with the row; showing
                                                             only the name and the badge left the operator to guess. -->
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                                   Text="{Binding Notes}" FontSize="11"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding SkippedInteractiveTests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="reportRow warn">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                        <Border Grid.Row="0" Grid.Column="1" Classes="chip warn">
                                                            <TextBlock Text="{DynamicResource Report_Skipped}"/>
                                                        </Border>
                                                        <Button Grid.Row="0" Grid.Column="2" Classes="dismissTest"
                                                                Content="&#x2715;"
                                                                ToolTip.Tip="{DynamicResource Report_DismissTest}"
                                                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.DismissInteractiveTestCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <!-- Why it did not run: the browser refused, the phone never sent a
                                                             fix, or the browser has no location API at all. -->
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                                   Text="{Binding Notes}" FontSize="11"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- What the report is leaving out, stated as a figure. A report that
                                         quietly drops rows is worse than one that says it dropped them,
                                         and the undo is what keeps the decision from being final. -->
                                    <Border x:Name="DismissedLine" Classes="reportRow" IsVisible="{Binding HasDismissedInteractiveTests}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding DismissedInteractiveTestCount}"
                                                       FontWeight="Bold" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDimColor}"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Report_Dismissed}"
                                                       FontSize="11" Margin="6,0,0,0" TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDimColor}"/>
                                            <Button Grid.Column="2" Classes="iconBtn" FontSize="11"
                                                    Padding="8,3" Margin="8,0,0,0"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Content="{DynamicResource Report_Restore}"
                                                    Command="{Binding RestoreDismissedTestsCommand}"/>
                                        </Grid>
                                    </Border>

                                    <Border Classes="reportRow ok" IsVisible="{Binding NoInteractiveTestProblems}">
                                        <TextBlock Classes="emptyNote" Text="{DynamicResource Summary_AllTestsPassed}"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Actions: a bar, not three buttons floating on the background -->
                    <Border Grid.Row="2" Classes="actionBar">
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" MaxWidth="960" HorizontalAlignment="Stretch">
                            <Button Grid.Column="0" Classes="kioskSecondary" Command="{Binding RetestCommand}"
                                    Content="{DynamicResource Summary_BtnRetest}" Padding="16,10" HorizontalContentAlignment="Center"/>

                            <Button Grid.Column="1" Classes="kioskPrint" Command="{Binding OpenLabelCommand}"
                                    Content="{DynamicResource Summary_BtnPrint}" Margin="12,0" Padding="20,12" FontSize="14" FontWeight="Bold"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                            <Button Grid.Column="2" Classes="kioskSecondary" Command="{Binding BackToIdleCommand}"
                                    Content="{DynamicResource Summary_BtnNext}" Padding="16,10" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        <!--
            ==================== USB DEBUGGING HOW-TO ====================
            The same shape as the settings page below it: its own top bar over
            the content area and nothing to scroll, so the whole how-to is on
            screen at the size the kiosk opens at.

            One flag opens it. A phone arriving over USB that adb cannot talk
            to yet, and adb reporting a phone it does not trust, both set
            ShowAdbWarning; a phone adb can talk to again, a phone being
            unplugged, and the operator dismissing it take it away again.
            Nothing else decides, which is what stops an iPad from bringing it
            up - an iPad never gets past the vendor check and never sets the
            flag at all.

            It sits below the settings page in Z order on purpose: an operator
            who opens Connection settings to fix something should not have the
            answer covered up while they read it.
        -->
        <Panel x:Name="AdbGuideOverlay" Grid.Row="1"
               IsVisible="{Binding ShowAdbWarning}" ZIndex="35"
               Background="{DynamicResource AppBgColor}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Classes="topBar" Padding="24,16">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="pageTitle" Text="{DynamicResource AdbTutorial_Title}"/>
                        <TextBlock Classes="settingDesc" Text="{DynamicResource AdbTutorial_Lead}"/>
                    </StackPanel>
                </Border>

                <views:AdbTutorialView Grid.Row="1"
                                       DataContext="{Binding AdbTutorialViewModel}"
                                       Margin="24,20"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Button Classes="cta" Command="{Binding RetryAdbDetectionCommand}"
                            Content="{DynamicResource AdbTutorial_RetryButton}"/>
                    <Button Classes="kioskSecondary" Command="{Binding DismissAdbGuideCommand}"
                            Content="{DynamicResource AdbTutorial_Close}"/>
                </StackPanel>
            </Grid>
        </Panel>

        <!--
            ==================== SETTINGS PAGE ====================
            A page, not a drawer: the topics are on the left, the chosen topic is
            on the right, and the header stays where it always is so the gear that
            opened this is the gear that closes it again. The old drawer was one
            long list of everything, which meant the daily options and the debug
            toggles sat in the same scroll and nothing could be found by place.
        -->
        <Panel x:Name="SettingsPanel" Grid.Row="1"
               IsVisible="{Binding IsSettingsDrawerOpen}" ZIndex="40"
               Background="{DynamicResource AppBgColor}">
            <Grid RowDefinitions="Auto,*">
                <Border Classes="topBar" Padding="24,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="pageTitle" Text="{DynamicResource Settings_Title}"/>
                            <TextBlock Classes="settingDesc" Text="{DynamicResource Settings_Lead}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="headerBtn" VerticalAlignment="Center"
                                Command="{Binding ToggleSettingsCommand}"
                                ToolTip.Tip="{DynamicResource Settings_CloseTooltip}"
                                Content="{DynamicResource Settings_Close}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="220,*" Margin="24,20,24,24">
                    <!-- The topics. One is lit; the rest are one click away. -->
                    <Border Grid.Column="0" Classes="settingCard" Padding="8" VerticalAlignment="Top">
                        <StackPanel Spacing="2">
                            <Button Classes="navItem"
                                    Classes.current="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=General}"
                                    Command="{Binding SelectSettingsSectionCommand}" CommandParameter="General"
                                    Content="{DynamicResource Settings_SecGeneral}"/>
                            <Button Classes="navItem"
                                    Classes.current="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=Workflow}"
                                    Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Workflow"
                                    Content="{DynamicResource Settings_SecWorkflow}"/>
                            <Button Classes="navItem"
                                    Classes.current="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=Connection}"
                                    Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Connection"
                                    Content="{DynamicResource Settings_SecConnection}"/>
                            <Button Classes="navItem"
                                    Classes.current="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=License}"
                                    Command="{Binding SelectSettingsSectionCommand}" CommandParameter="License"
                                    Content="{DynamicResource Settings_SecLicense}"/>
                            <Button Classes="navItem"
                                    Classes.current="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=Support}"
                                    Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Support"
                                    Content="{DynamicResource Settings_SecSupport}"/>
                            <Button Classes="navItem"
                                    Classes.current="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=Advanced}"
                                    Command="{Binding SelectSettingsSectionCommand}" CommandParameter="Advanced"
                                    Content="{DynamicResource Settings_SecAdvanced}"/>
                            <Button Classes="navItem"
                                    Classes.current="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=ImeiApi}"
                                    Command="{Binding SelectSettingsSectionCommand}" CommandParameter="ImeiApi"
                                    Content="{DynamicResource Settings_SecImeiApi}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" Margin="20,0,0,0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

                            <!-- ============ General: the language and the look ============ -->
                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=General}">
                                <TextBlock Classes="sectionTitle" Text="{DynamicResource Settings_SecGeneral}"/>

                                <Border Classes="settingCard">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Settings_Language}" FontWeight="SemiBold"/>
                                            <TextBlock Classes="settingDesc" Text="{DynamicResource Settings_LanguageDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                                                  ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}"/>
                                    </Grid>
                                </Border>

                                <Border Classes="settingCard">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Settings_Theme}" FontWeight="SemiBold"/>
                                            <TextBlock Classes="settingDesc" Text="{DynamicResource Settings_ThemeDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                                                  ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ============ IMEI API Configuration: BYOK imei.info ============ -->
                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=ImeiApi}">
                                <TextBlock Classes="sectionTitle" Text="{DynamicResource Settings_SecImeiApi}"/>

                                <!-- Why a key is wanted at all, before anything asks for one -->
                                <Border Classes="settingCard">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{DynamicResource Settings_ImeiInfoWhyTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Classes="settingDesc" TextWrapping="Wrap"
                                                   Text="{DynamicResource Settings_ImeiInfoWhy}"/>
                                        <TextBlock Classes="settingDesc" TextWrapping="Wrap"
                                                   Text="{DynamicResource Settings_ImeiInfoWhyCredits}"/>
                                        <Button Classes="kioskSecondary" Content="{DynamicResource Settings_ImeiInfoOpenDashboard}"
                                                Command="{Binding OpenImeiDashboardCommand}"
                                                HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Setup Guide -->
                                <Border Classes="settingCard">
                                    <StackPanel Spacing="12">
                                        <Border Classes="stepPlan">
                                            <StackPanel>
                                                <TextBlock Classes="stepPlanTitle"
                                                           Text="{DynamicResource Settings_ImeiInfoGuide}"/>

                                                <Border Classes="stepItem">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Border Classes="stepRail"/>
                                                        <Border Classes="stepBadge">
                                                            <TextBlock Text="1"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Classes="stepBody"
                                                                   Text="{DynamicResource Settings_ImeiInfoGuideStep1}"/>
                                                    </Grid>
                                                </Border>

                                                <Border Classes="stepItem">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Border Classes="stepRail"/>
                                                        <Border Classes="stepBadge">
                                                            <TextBlock Text="2"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Classes="stepBody"
                                                                   Text="{DynamicResource Settings_ImeiInfoGuideStep2}"/>
                                                    </Grid>
                                                </Border>

                                                <Border Classes="stepItem">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Border Classes="stepRail"/>
                                                        <Border Classes="stepBadge">
                                                            <TextBlock Text="3"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Classes="stepBody"
                                                                   Text="{DynamicResource Settings_ImeiInfoGuideStep3}"/>
                                                    </Grid>
                                                </Border>

                                                <Border Classes="stepItem">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Border Classes="stepRail"/>
                                                        <Border Classes="stepBadge">
                                                            <TextBlock Text="4"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Classes="stepBody"
                                                                   Text="{DynamicResource Settings_ImeiInfoGuideStep4}"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- API Key Input -->
                                <Border Classes="settingCard">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{DynamicResource Settings_ImeiInfoApiKey}" FontWeight="SemiBold"/>
                                        <TextBlock Classes="settingDesc" Text="{DynamicResource Settings_ImeiInfoApiKeyDesc}"/>
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBox Grid.Column="0" Text="{Binding ImeiInfoApiKey}" PasswordChar="*"
                                                     Watermark="{DynamicResource Settings_ImeiInfoApiKeyWatermark}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Button Classes="cta" Content="{DynamicResource Settings_ImeiInfoSaveKey}"
                                                        Command="{Binding SaveImeiInfoApiKeyCommand}"
                                                        HorizontalAlignment="Left" Padding="16,8"/>
                                                <Button Classes="kioskSecondary" Content="{DynamicResource Settings_ImeiInfoTestKey}"
                                                        Command="{Binding TestImeiInfoApiKeyCommand}"
                                                        HorizontalAlignment="Left" Padding="16,8"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding ImeiInfoApiKeyStatus}" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding ImeiInfoApiKeyStatusColor}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Checks Selection -->
                                <Border Classes="settingCard">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{DynamicResource Settings_ImeiInfoChecks}" FontWeight="SemiBold"/>
                                        <TextBlock Classes="settingDesc" Text="{DynamicResource Settings_ImeiInfoChecksDesc}"/>
                                        
                                        <!-- Apple Carrier Lock & FMI -->
                                        <Border Background="{DynamicResource CardDeepColor}" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding ImeiCheckAppleCarrierLockFmi}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                                                    <TextBlock Text="{DynamicResource Settings_ImeiCheck_AppleCarrierLockFmi}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{DynamicResource Settings_ImeiCheck_AppleCarrierLockFmiDesc}" Classes="settingDesc" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Settings_ImeiCheck_AppleCarrierLockFmiPrice}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Blacklist Simple -->
                                        <Border Background="{DynamicResource CardDeepColor}" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding ImeiCheckBlacklistSimple}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                                                    <TextBlock Text="{DynamicResource Settings_ImeiCheck_BlacklistSimple}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{DynamicResource Settings_ImeiCheck_BlacklistSimpleDesc}" Classes="settingDesc" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Settings_ImeiCheck_BlacklistSimplePrice}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Blacklist Premium -->
                                        <Border Background="{DynamicResource CardDeepColor}" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding ImeiCheckBlacklistPremium}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                                                    <TextBlock Text="{DynamicResource Settings_ImeiCheck_BlacklistPremium}" FontWeight="SemiBold" ToolTip.Tip="{DynamicResource Settings_ImeiCheck_BlacklistPremiumDesc}"/>
                                                    <TextBlock Text="{DynamicResource Settings_ImeiCheck_BlacklistPremiumDesc}" Classes="settingDesc" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Settings_ImeiCheck_BlacklistPremiumPrice}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Samsung Info & Knox -->
                                        <Border Background="{DynamicResource CardDeepColor}" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding ImeiCheckSamsungInfoKnox}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                                                    <TextBlock Text="{DynamicResource Settings_ImeiCheck_SamsungInfoKnox}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{DynamicResource Settings_ImeiCheck_SamsungInfoKnoxDesc}" Classes="settingDesc" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Settings_ImeiCheck_SamsungInfoKnoxPrice}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Cost Calculator -->
                                <Border Classes="settingCard">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{DynamicResource Settings_ImeiInfoCostCalculator}" FontWeight="SemiBold"/>
                                        <TextBlock Classes="settingDesc" Text="{DynamicResource Settings_ImeiInfoCostCalculatorDesc}"/>
                                        
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource Settings_ImeiInfoAppleDevices}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBox Text="{Binding EstimatedAppleDevices}" Watermark="{DynamicResource Settings_ImeiInfoWatermarkDefault}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{DynamicResource Settings_ImeiInfoAndroidDevices}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBox Text="{Binding EstimatedAndroidDevices}" Watermark="{DynamicResource Settings_ImeiInfoWatermarkDefault}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                            
                                            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource CardDeepColor}" CornerRadius="6" Padding="16" Margin="0,8,0,0">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding EstimatedMonthlyCostDisplay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                                                    <TextBlock Text="{Binding EstimatedPerDeviceDisplay}" FontSize="12" Foreground="{DynamicResource TextDimColor}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=Workflow}">
                                <TextBlock Classes="sectionTitle" Text="{DynamicResource Settings_SecWorkflow}"/>

                                <Border Classes="settingCard">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Settings_Quality}" FontWeight="SemiBold"/>
                                            <TextBlock Classes="settingDesc" Text="{DynamicResource Settings_QualityDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center"
                                                  ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding DefaultQuality}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource QualityOptionLabelConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Classes="settingCard">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Settings_Payment}" FontWeight="SemiBold"/>
                                            <TextBlock Classes="settingDesc" Text="{DynamicResource Settings_PaymentDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center"
                                                  ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding DefaultPaymentMethod}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource PaymentOptionLabelConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{DynamicResource Settings_AutoDetect}" IsChecked="{Binding AutoDetectOnPlug}"/>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_AutoDetectDesc}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{DynamicResource Settings_UsbEventMonitoring}" IsChecked="{Binding EnableUsbEventMonitoring}"/>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_UsbEventMonitoringDesc}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{DynamicResource Settings_AutoStartWebTest}" IsChecked="{Binding AutoStartWebTest}"/>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_AutoStartWebTestDesc}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{DynamicResource Settings_RequirePwaTest}" IsChecked="{Binding RequirePwaTest}"/>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_RequirePwaTestDesc}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{DynamicResource Settings_AutoFinishAfterTest}" IsChecked="{Binding AutoFinishAfterTest}"/>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_AutoFinishAfterTestDesc}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{DynamicResource Settings_ShowSummary}" IsChecked="{Binding ShowSummaryScreenAfterTesting}"/>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_ShowSummaryDesc}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--
                                Connection: how the phone reaches this pc. The two
                                options are together under their own heading because
                                they decide whether the camera, the microphone and
                                the motion sensors can be reached at all, and loose
                                at the end of a list they read as debug toggles
                                instead of as the choice between a cable and the
                                internet.
                            -->
                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=Connection}">
                                <TextBlock Classes="sectionTitle" Text="{DynamicResource Settings_Connection}"/>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox IsChecked="{Binding UseSecureOrigin}">
                                            <TextBlock Text="{DynamicResource Settings_SecureOrigin}" FontWeight="SemiBold"/>
                                        </CheckBox>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_SecureOriginDesc}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox IsChecked="{Binding UsePublicTunnel}">
                                            <TextBlock Text="{DynamicResource Settings_PublicTunnel}" FontWeight="SemiBold"/>
                                        </CheckBox>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_PublicTunnelDesc}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--
                                Licensing lives in the panel the title bar pill
                                opens, so this is only a pointer: the tier as it
                                stands, and one button over to where a key gets
                                typed in. A second key box here meant two copies of
                                the same form that could disagree after an
                                activation.
                            -->
                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=License}">
                                <TextBlock Classes="sectionTitle" Text="{DynamicResource Settings_SecLicense}"/>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{DynamicResource Settings_LicensingCardTitle}" Classes="cardTitle"/>
                                        <TextBlock Text="{Binding Licensing.LicensingStatusText, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="14"/>
                                        <Button Classes="cta" Command="{Binding ManageLicenseCommand}"
                                                Content="{DynamicResource Settings_ManageLicense}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============ Support: the two windows that answer "why" ============ -->
                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=Support}">
                                <TextBlock Classes="sectionTitle" Text="{DynamicResource Settings_SecSupport}"/>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{DynamicResource Settings_TroubleshootCardTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Classes="settingDesc" Text="{DynamicResource Settings_TroubleshootCardDesc}"/>
                                        <Button Classes="kioskSecondary" Command="{Binding OpenTroubleshootModalCommand}"
                                                Content="{DynamicResource Btn_Troubleshoot}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{DynamicResource Settings_LogsCardTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Classes="settingDesc" Text="{DynamicResource Settings_LogsCardDesc}"/>
                                        <Button Classes="kioskSecondary" Command="{Binding OpenLogsModalCommand}"
                                                Content="{DynamicResource Btn_Logs}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============ Advanced: things that change how the tool behaves ============ -->
                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SelectedSettingsSection, Converter={StaticResource SectionMatch}, ConverterParameter=Advanced}">
                                <TextBlock Classes="sectionTitle" Text="{DynamicResource Settings_Advanced}"/>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{DynamicResource Settings_AutoActivate}" IsChecked="{Binding AutoActivate}"/>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_AutoActivateDesc}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{DynamicResource Settings_RunDiagnostics}" IsChecked="{Binding RunDiagnostics}"/>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_RunDiagnosticsDesc}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{DynamicResource Settings_Enable85Checker}" IsChecked="{Binding Enable85PercentChecker}"/>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_Enable85CheckerDesc}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{DynamicResource Settings_OpenEditor}" IsChecked="{Binding OpenEditorBeforePrint}"/>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_OpenEditorDesc}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settingCard">
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{DynamicResource Settings_DebugMode}" IsChecked="{Binding IsDebugMode}"/>
                                        <TextBlock Classes="settingDesc" Margin="26,0,0,0" Text="{DynamicResource Settings_DebugModeDesc}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Panel>
        </Grid>

        <!-- ==================== SYSTEM LOGS MODAL OVERLAY ==================== -->
        <Panel IsVisible="{Binding IsLogsModalOpen}" ZIndex="60">
            <Rectangle Fill="{DynamicResource OverlayColor}"/>
            <Border Classes="card" Width="850" Height="580" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 24 64 0 #77000000" Padding="20">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Logs_Title}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="iconBtn" Command="{Binding CloseLogsModalCommand}">
                            <TextBlock Text="{DynamicResource Btn_Close}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                        </Button>
                    </Grid>

                    <!-- Filter Controls -->
                    <Border Grid.Row="1" Background="{DynamicResource CardDeepColor}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,12,*,12,Auto,8,Auto">
                            <CheckBox Grid.Column="0" Content="{DynamicResource Logs_FilterDebug}" IsChecked="{Binding LogsViewModel.ShowDebug}" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="1" Content="{DynamicResource Logs_FilterInfo}" IsChecked="{Binding LogsViewModel.ShowInfo}" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="2" Content="{DynamicResource Logs_FilterWarning}" IsChecked="{Binding LogsViewModel.ShowWarning}" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="3" Content="{DynamicResource Logs_FilterError}" IsChecked="{Binding LogsViewModel.ShowError}"/>
                            <TextBox Grid.Column="5" Text="{Binding LogsViewModel.SearchQuery}" Watermark="{DynamicResource Logs_SearchPlaceholder}"/>
                            <Button Grid.Column="7" Content="{DynamicResource Btn_Clear}" Command="{Binding LogsViewModel.ClearLogsCommand}"/>
                            <Button Grid.Column="9" Content="{DynamicResource Btn_Copy}" Command="{Binding LogsViewModel.CopyLogsCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Logs List -->
                    <!--
                        A ListBox, not a ScrollViewer around an ItemsControl: the
                        panel behind a ListBox virtualizes, so only the rows that
                        fit on screen exist as elements and the rest stay as data.
                        The ItemsControl realized every row of the buffer at
                        once and re-measured all of them on each new entry.
                    -->
                    <ListBox Grid.Row="2" Classes="logList"
                             ItemsSource="{Binding LogsViewModel.Logs}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogEventViewModel">
                                <Border Background="{DynamicResource CardDeepColor}" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="80,65,85,*">
                                        <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" FontFamily="Consolas,Courier New" FontSize="11" Foreground="{DynamicResource TextDimColor}"/>
                                        <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Background="{Binding LevelColor}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding LevelText}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Margin="0,0,8,0" Text="{Binding SourceText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDimColor}" TextTrimming="CharacterEllipsis"/>
                                        <!-- Six lines at most: one logged payload must not turn its row into a wall of text. -->
                                        <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" MaxLines="6" FontFamily="Consolas,Courier New"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Panel>

        <!-- ==================== TROUBLESHOOT MODAL OVERLAY ==================== -->
        <Panel IsVisible="{Binding IsTroubleshootModalOpen}" ZIndex="60">
            <Rectangle Fill="{DynamicResource OverlayColor}"/>
            <Border Classes="card" Width="850" Height="580" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 24 64 0 #77000000" Padding="20">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Troubleshoot_Title}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="iconBtn" Command="{Binding CloseTroubleshootModalCommand}">
                            <TextBlock Text="{DynamicResource Btn_Close}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                        </Button>
                    </Grid>

                    <!--
                        The sentence and the buttons that answer it are stacked
                        rather than set side by side. In the row of
                        *,Auto,8,Auto this used to be, the sentence was cut
                        off exactly where the buttons start, so the one line
                        telling an operator what to do never got to its end.
                    -->
                    <Border Grid.Row="1" Classes="card" Background="{DynamicResource CardDeepColor}" Padding="12" Margin="0,0,0,10">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding TroubleshootViewModel.OverallStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/>

                            <!-- What it is doing while it works, which used to
                                 be written into properties nothing read. -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        IsVisible="{Binding TroubleshootViewModel.InstallStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Classes="dim" FontSize="12"
                                           Text="{Binding TroubleshootViewModel.InstallStatusText}"/>
                                <ProgressBar IsVisible="{Binding TroubleshootViewModel.IsBusy}"
                                            IsIndeterminate="{Binding TroubleshootViewModel.IsRunning}"
                                            Value="{Binding TroubleshootViewModel.InstallProgress}"
                                            Maximum="100" Width="160" Height="4" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="kioskSecondary" Content="{DynamicResource Btn_FixAll}"
                                        Command="{Binding TroubleshootViewModel.FixAllCommand}"
                                        IsVisible="{Binding TroubleshootViewModel.HasFixableIssues}"/>
                                <Button Classes="cta" Content="{DynamicResource Btn_RunDiagnostics}"
                                        Command="{Binding TroubleshootViewModel.RunDiagnosticsCommand}"
                                        IsVisible="{Binding TroubleshootViewModel.AwaitingFirstScan}"/>
                                <Button Classes="cta" Content="{DynamicResource Btn_Rescan}"
                                        Command="{Binding TroubleshootViewModel.RunDiagnosticsCommand}"
                                        IsVisible="{Binding TroubleshootViewModel.HasResults}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <!-- Before the first scan this is a promise of what it
                             will look for, not an empty list. -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="460" Spacing="8"
                                    IsVisible="{Binding TroubleshootViewModel.AwaitingFirstScan}">
                            <TextBlock Classes="dim" Text="{DynamicResource Troubleshoot_Desc}"
                                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                        </StackPanel>

                        <ScrollViewer IsVisible="{Binding TroubleshootViewModel.HasResults}"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TroubleshootViewModel.Checks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="card" Background="{DynamicResource CardDeepColor}" Padding="12" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Category}" Classes="dim" FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="{DynamicResource WarnColor}" TextWrapping="Wrap" IsVisible="{Binding Resolution, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="pill" 
                                                        Classes.success="{Binding IsPass}"
                                                        Classes.danger="{Binding IsFail}"
                                                        Classes.warn="{Binding IsWarning}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Classes="pillText" Text="{Binding Severity}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Panel>

        <!-- ==================== Quality & Payment Dialog Popups ==================== -->
        <!--
            Two questions at the end of an inspection, and only when no default is
            set. Each option is a row with the grade letter in its own colour
            rather than a whole button painted green, amber or red, which made the
            three look like a warning, a warning and an error.
        -->
        <Panel IsVisible="{Binding IsQualityPopupVisible}" ZIndex="70">
            <Rectangle Fill="{DynamicResource OverlayColor}"/>
            <Border Classes="card" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 24 60 0 #66000000" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource QualityPopup_Title}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{DynamicResource QualityPopup_Lead}" Classes="settingDesc"/>

                    <Button Classes="kioskSecondary" Height="52" HorizontalContentAlignment="Stretch"
                            Command="{Binding SetQualityCommand}" CommandParameter="A">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="chip ok" HorizontalAlignment="Left">
                                <TextBlock Text="A"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Quality_A}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Button>

                    <Button Classes="kioskSecondary" Height="52" HorizontalContentAlignment="Stretch"
                            Command="{Binding SetQualityCommand}" CommandParameter="B">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="chip warn" HorizontalAlignment="Left">
                                <TextBlock Text="B"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Quality_B}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Button>

                    <Button Classes="kioskSecondary" Height="52" HorizontalContentAlignment="Stretch"
                            Command="{Binding SetQualityCommand}" CommandParameter="C">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="chip bad" HorizontalAlignment="Left">
                                <TextBlock Text="C"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Quality_C}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Panel>

        <Panel IsVisible="{Binding IsPaymentPopupVisible}" ZIndex="70">
            <Rectangle Fill="{DynamicResource OverlayColor}"/>
            <Border Classes="card" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 24 60 0 #66000000" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource PaymentPopup_Title}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{DynamicResource PaymentPopup_Lead}" Classes="settingDesc"/>

                    <Button Classes="kioskSecondary" Height="52" HorizontalContentAlignment="Stretch"
                            Command="{Binding SetPaymentMethodCommand}" CommandParameter="Marge">
                        <TextBlock Text="{DynamicResource Payment_Marge}" VerticalAlignment="Center"/>
                    </Button>

                    <Button Classes="kioskSecondary" Height="52" HorizontalContentAlignment="Stretch"
                            Command="{Binding SetPaymentMethodCommand}" CommandParameter="BTW">
                        <TextBlock Text="{DynamicResource Payment_BTW}" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ==================== First-run introduction (top of everything) ==================== -->
        <views:IntroView IsVisible="{Binding IsIntroVisible}" ZIndex="100"/>

        <!--
            License panel, opened from the status pill in the title bar or from
            settings. It is the one place that answers "what am I on and how do I
            change that": the tier in words, the scans left on the free tier, the
            key box when there is no key yet, and the pricing page one click away.
            Sits below the settings drawer so the two cannot pile up, and below
            the introduction screen, which covers the whole window anyway.
        -->
        <Panel IsVisible="{Binding IsLicensePanelOpen}" ZIndex="45">
            <Button Background="Transparent" BorderThickness="0"
                    Command="{Binding ToggleLicensePanelCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Content=""/>

            <Border Classes="card" Width="340" Padding="20"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,70,24,0"
                    BoxShadow="0 12 32 0 #66000000">
                <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Licensing_PanelTitle}"
                                   Classes="cardTitle" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="iconBtn"
                                Command="{Binding ToggleLicensePanelCommand}"
                                ToolTip.Tip="{DynamicResource Licensing_PanelClose}"
                                Content="&#x2715;" FontSize="12"
                                Foreground="{DynamicResource TextDimColor}"
                                Padding="6"/>
                    </Grid>

                    <!-- The tier, said in full. -->
                    <TextBlock Text="{Binding Licensing.LicensingStatusText}"
                               FontWeight="SemiBold" FontSize="15"/>

                    <!-- Scans left, as words and as a bar, only while on the free tier. -->
                    <StackPanel Spacing="6" IsVisible="{Binding Licensing.IsFreeTier}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource Licensing_PanelScansLeft}"
                                       Classes="dim" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Licensing.TierSummary}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="10"
                                     Value="{Binding Licensing.UsedScans, Mode=OneWay}"
                                     Height="6"/>
                    </StackPanel>

                    <Separator/>

                    <!-- Key box: only there is something to type into. -->
                    <StackPanel Spacing="8" IsVisible="{Binding Licensing.IsFreeTier}">
                        <TextBox Text="{Binding Licensing.LicenseKeyInput}"
                                 Watermark="{DynamicResource Settings_LicenseKeyWatermark}"
                                 PasswordChar="*"/>
                        <Button Classes="cta"
                                Command="{Binding Licensing.ValidateCommand}"
                                IsEnabled="{Binding !Licensing.IsActivating}"
                                Content="{DynamicResource Settings_ValidateActivate}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <TextBlock Text="{Binding Licensing.StatusMessage}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarnColor}"/>
                    </StackPanel>

                    <Button Classes="kioskSecondary"
                            Command="{Binding Licensing.OpenPricingCommand}"
                            Content="{DynamicResource Intro_SeePricing}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
