<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhoneGrade.UI.ViewModels"
        x:Class="PhoneGrade.UI.Views.DataEditorWindow"
        x:DataType="vm:DataEditorViewModel"
        Title="Gegevens bewerken"
        Width="680" Height="820"
        MinWidth="540" MinHeight="600"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Native chrome (close/min/max + resize work everywhere incl. Wayland). -->
    <!-- Scroll wheel fix: single flat ScrollViewer, no nested scroll containers. -->

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Border Classes="card" Margin="20" Padding="26">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4" Margin="0,0,0,6">
                    <TextBlock Text="Toestelgegevens" Classes="SectionHeader" FontSize="20"/>
                    <TextBlock Classes="dim" Text="Controleer en pas aan - dit gaat zo op het label" FontSize="12"/>
                </StackPanel>

                <!-- Field blocks reuse one implicit style: label above, input below -->
                <StackPanel Spacing="7">
                    <TextBlock Classes="TableHeader" Text="Identifier (IMEI / serienummer)"/>
                    <TextBox Text="{Binding DeviceData.Identifier}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="TableHeader" Text="Model"/>
                    <TextBox Text="{Binding DeviceData.Model}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="TableHeader" Text="Kleur"/>
                    <TextBox Text="{Binding DeviceData.Color}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="TableHeader" Text="Opslag"/>
                    <TextBox Text="{Binding DeviceData.Storage}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="TableHeader" Text="Batterij"/>
                    <TextBox Text="{Binding DeviceData.BatteryHealth}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="TableHeader" Text="Kwaliteit"/>
                    <TextBox Text="{Binding DeviceData.Quality, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Classes="TableHeader" Text="Betaalmethode"/>
                    <TextBox Text="{Binding DeviceData.PayMethod, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Extended Hardware & Battery Info -->
                <Separator Margin="0,6"/>
                <TextBlock Text="Hardware &amp; Batterij Metrics" Classes="SectionHeader"/>
                
                <Grid ColumnDefinitions="*,12,*,12,*" Margin="0,2">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Classes="dim" Text="Laadcycli" FontSize="11"/>
                        <TextBlock Text="{Binding DeviceData.BatteryCycleCount}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Classes="dim" Text="Design mAh" FontSize="11"/>
                        <TextBlock Text="{Binding DeviceData.BatteryDesignCapacity}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="3">
                        <TextBlock Classes="dim" Text="Huidig mAh" FontSize="11"/>
                        <TextBlock Text="{Binding DeviceData.BatteryCurrentCapacity}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- OEM Component Verification Checks -->
                <Separator Margin="0,6"/>
                <TextBlock Text="OEM Component Audit" FontSize="15" FontWeight="SemiBold"/>
                
                <ItemsControl ItemsSource="{Binding DeviceData.ComponentChecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardDeepColor}"
                                    CornerRadius="8" Padding="10" Margin="0,0,0,6"
                                    BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1">
                                <Grid ColumnDefinitions="200,*,*,90">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Classes="dim" Text="Gelezen" FontSize="10"/>
                                        <TextBlock Text="{Binding SerialRead}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="1">
                                        <TextBlock Classes="dim" Text="Origineel" FontSize="10"/>
                                        <TextBlock Text="{Binding SerialOriginal}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="3" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={x:Static vm:ComponentStatusToBrushConverter.Instance}}">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Classes="cta" Content="Opslaan &amp; label openen"
                        Command="{Binding SaveAndOpenLabelCommand}"
                        HorizontalAlignment="Stretch" Margin="0,10,0,0" Height="46"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
