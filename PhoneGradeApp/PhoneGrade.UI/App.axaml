<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:PhoneGrade.UI.Converters"
             x:Class="PhoneGrade.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhoneGrade.UI/Resources/Strings.nl.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:BatteryHealthConverter x:Key="BatteryConverter"/>
            <converters:BatteryLevelConverter x:Key="BatteryLevelConverter"/>
            <converters:ColorConverter x:Key="ColorConverter"/>
            <converters:MemoryConverter x:Key="MemoryConverter"/>
            <converters:QualityConverter x:Key="QualityConverter"/>
            <converters:ActivationLockConverter x:Key="ActivationLockConverter"/>
            <converters:ActivationLockBrushConverter x:Key="ActivationLockBrushConverter"/>
            <converters:PayMethodConverter x:Key="PayMethodConverter"/>
            <converters:ModelDisplayConverter x:Key="ModelDisplayConverter"/>
            <converters:ComponentStatusConverter x:Key="ComponentStatusConverter"/>
            <converters:DeviceConnectionTextConverter x:Key="DeviceConnectionTextConverter"/>
            <converters:EqualsParameterConverter x:Key="SectionMatch"/>
            <converters:QualityOptionLabelConverter x:Key="QualityOptionLabelConverter"/>
            <converters:PaymentOptionLabelConverter x:Key="PaymentOptionLabelConverter"/>
            <converters:LocalizationConverter x:Key="LocalizationConverter"/>
            
            <!-- Severity brushes for the diagnostics dot (converter keys) -->
            <SolidColorBrush x:Key="SeverityOkBrush" Color="{DynamicResource SuccessColor}"/>
            <SolidColorBrush x:Key="SeverityWarningBrush" Color="{DynamicResource WarnColor}"/>
            <SolidColorBrush x:Key="SeverityErrorBrush" Color="{DynamicResource DangerColor}"/>
            <SolidColorBrush x:Key="ComponentUnknownBrush" Color="{DynamicResource CardBorderColor}"/>

            <!-- Tinted fills for rows and cards that carry news, so no view has
                 to spell out its own colour and every theme gets a readable one. -->
            <SolidColorBrush x:Key="AccentTintBrush" Color="{DynamicResource AccentTint}"/>
            <SolidColorBrush x:Key="SuccessTintBrush" Color="{DynamicResource SuccessTint}"/>
            <SolidColorBrush x:Key="WarnTintBrush" Color="{DynamicResource WarnTint}"/>
            <SolidColorBrush x:Key="DangerTintBrush" Color="{DynamicResource DangerTint}"/>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AppBgColor">#141417</Color>
                    <Color x:Key="CardColor">#1E1E24</Color>
                    <Color x:Key="CardDeepColor">#26262E</Color>
                    <Color x:Key="CardBorderColor">#2E2E38</Color>
                    <Color x:Key="InputBgColor">#2A2A33</Color>
                    <Color x:Key="TrackColor">#33333D</Color>
                    <Color x:Key="TextColor">#F2F2F5</Color>
                    <Color x:Key="TextDimColor">#9B9BA6</Color>
                    <Color x:Key="AccentColor">#4F8CFF</Color>
                    <Color x:Key="AccentHoverColor">#6B9FFF</Color>
                    <Color x:Key="SuccessColor">#2FBF71</Color>
                    <Color x:Key="WarnColor">#F5A623</Color>
                    <Color x:Key="DangerColor">#F0564A</Color>
                    <Color x:Key="OverlayColor">#99101014</Color>
                    <!-- Fills behind a row that carries news: barely there, so a
                         list of them stays readable instead of glowing. -->
                    <Color x:Key="AccentTint">#224F8CFF</Color>
                    <Color x:Key="SuccessTint">#262FBF71</Color>
                    <Color x:Key="WarnTint">#26F5A623</Color>
                    <Color x:Key="DangerTint">#26F0564A</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AppBgColor">#EEF0F4</Color>
                    <Color x:Key="CardColor">#FFFFFF</Color>
                    <Color x:Key="CardDeepColor">#F5F6FA</Color>
                    <Color x:Key="CardBorderColor">#E2E4EA</Color>
                    <Color x:Key="InputBgColor">#E9EBF1</Color>
                    <Color x:Key="TrackColor">#D8DAE2</Color>
                    <Color x:Key="TextColor">#17181C</Color>
                    <Color x:Key="TextDimColor">#5E6068</Color>
                    <Color x:Key="AccentColor">#2E6BE6</Color>
                    <Color x:Key="AccentHoverColor">#4A83F0</Color>
                    <Color x:Key="SuccessColor">#1FA35A</Color>
                    <Color x:Key="WarnColor">#C77E00</Color>
                    <Color x:Key="DangerColor">#DC3528</Color>
                    <Color x:Key="OverlayColor">#9910141A</Color>
                    <Color x:Key="AccentTint">#E4EEFF</Color>
                    <Color x:Key="SuccessTint">#E4F6EC</Color>
                    <Color x:Key="WarnTint">#FDF1DC</Color>
                    <Color x:Key="DangerTint">#FCE9E7</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- ============ Design system: one source of truth for every control ============ -->

        <!-- Surfaces & text -->
        <Style Selector="Window, UserControl">
            <Setter Property="Background" Value="{DynamicResource AppBgColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
        </Style>
        <!--
            A read-out the operator can select is a SelectableTextBlock, and a
            type selector matches only the type it names unless it is written
            as :is, so TextBlock.dim above does not reach it. Without this line
            the selectable values would come out at full brightness beside the
            dim label they belong to. The plain TextBlock rule needs no twin
            because Foreground is inherited from the window and reaches every
            descendant either way.
        -->
        <Style Selector="SelectableTextBlock.dim">
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
        </Style>

        <!--
            Cards: the one container style, used by every screen.

            The padding is 16 and the radius 12 rather than the 20 and 14 it used
            to be. Both were sized for a screen that had one card in it; at the
            minimum window width the old numbers ate the margin the card needed
            from the window edge, which is why the reading screen and the summary
            screen both overrode the padding per card rather than agreeing on one.
        -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Border.card /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextColor}"/>
        </Style>

        <!--
            Section headers inside cards.

            One size, because the reading screen used 11, the summary screen 11
            in one card and 12 in the next, and the export panel took 13 from
            here. A heading that changes size between two cards on the same screen
            reads as those cards belonging to different applications.
        -->
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
        </Style>

        <!--
            A read-out: the value under its label, wherever it appears.

            The screens used four separate markup shapes for this one pair of
            lines, and a tenth, twelve, thirteen and eighteen point font across
            them. These two classes are that pair, so a value is the same size and
            weight wherever the operator reads it, and the reading screen and the
            summary screen stop disagreeing about what a serial number looks like.
        -->
        <Style Selector="TextBlock.valueText">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="SelectableTextBlock.valueText">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- A value that leads its row: the model name, the grade, a headline figure. -->
        <Style Selector="TextBlock.valueLead">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="SelectableTextBlock.valueLead">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- The second line under a value, where a read-out has one. -->
        <Style Selector="TextBlock.valueHint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
        </Style>
        <Style Selector="SelectableTextBlock.valueHint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
        </Style>

        <!--
            One field cell: a label above a value, in a grid of them.

            Every screen that shows numbers under names had grown its own cell, so
            the same fact sat at ten points in one card and twelve in another two
            cards away. A cell is this class now, and the four columns on the
            summary screen and the six on the reading screen are the same object.
        -->
        <Style Selector="StackPanel.fieldCell">
            <Setter Property="Spacing" Value="2"/>
        </Style>
        <Style Selector="TextBlock.fieldCaption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="Border.fieldCellDivider">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!--
            The component audit row, as one shape.

            This is the single worst drift in the app: the same four facts about a
            part were drawn three ways, in the reading screen, the summary report
            and the data editor, with the name column at 170, 210 and 160 pixels
            and the captions at nine or ten points. One row template now, so a
            part looks the same wherever it appears and the columns line up.
        -->
        <Style Selector="Border.auditRow">
            <Setter Property="Background" Value="{DynamicResource CardDeepColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="TextBlock.auditHead">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
        </Style>
        <Style Selector="TextBlock.auditCaption">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
        </Style>
        <Style Selector="SelectableTextBlock.auditValue">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.auditName">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="SelectableTextBlock.auditName">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
            Primary / secondary buttons.

            The Fluent theme ships its Button ControlTheme with
            HorizontalAlignment=Left and VerticalAlignment=Center, so a button
            only fills the cell it sits in when a style or the element itself
            asks for it. That is why Button.cta stretches here and why every
            button that should fill its column says so.
        -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource InputBgColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource TrackColor}"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource CardBorderColor}"/>
        </Style>
        <Style Selector="Button.cta">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,13"/>
        </Style>
        <Style Selector="Button.cta:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverColor}"/>
        </Style>

        <!-- Status pills / Badges -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.pill.success">
            <Setter Property="Background" Value="#202FBF71"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}"/>
        </Style>
        <Style Selector="Border.pill.danger">
            <Setter Property="Background" Value="#20F0564A"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerColor}"/>
        </Style>
        <Style Selector="Border.pill.warn">
            <Setter Property="Background" Value="#20F5A623"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarnColor}"/>
        </Style>
        <Style Selector="Border.pill.neutral">
            <Setter Property="Background" Value="{DynamicResource TrackColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
        </Style>
        <Style Selector="TextBlock.pillText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.pill.success &gt; TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
        </Style>
        <Style Selector="Border.pill.danger &gt; TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
        </Style>
        <Style Selector="Border.pill.warn &gt; TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarnColor}"/>
        </Style>
        <Style Selector="Border.pill.neutral &gt; TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
        </Style>

        <!--
            The same pill as a button, for the license status in the title bar:
            it reads as a pill and answers a click. Button wins its own padding
            and corner radius from here rather than from the plain Button rule
            above, so the shape stays identical to Border.pill.
        -->
        <Style Selector="Button.statusPill">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource TrackColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
        </Style>
        <Style Selector="Button.statusPill.success">
            <Setter Property="Background" Value="#202FBF71"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
        </Style>
        <Style Selector="Button.statusPill.danger">
            <Setter Property="Background" Value="#20F0564A"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
        </Style>
        <Style Selector="Button.statusPill.warn">
            <Setter Property="Background" Value="#20F5A623"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarnColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource WarnColor}"/>
        </Style>
        <Style Selector="Button.statusPill:pointerover">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <!-- Kiosk Massive Buttons -->
        <Style Selector="Button.kioskPrint">
            <Setter Property="Background" Value="{DynamicResource SuccessColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="32,18"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.kioskPrint:pointerover">
            <Setter Property="Background" Value="#38D480"/>
        </Style>
        <Style Selector="Button.kioskPrint:pressed">
            <Setter Property="Background" Value="#239757"/>
        </Style>

        <Style Selector="Button.kioskSecondary">
            <Setter Property="Background" Value="{DynamicResource InputBgColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Icon button (Gear, Close, Refresh) -->
        <Style Selector="Button.iconBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.iconBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource TrackColor}"/>
        </Style>

        <!--
            The cross beside a failed or skipped row, which takes it out of the
            inspection report. Kept quiet at rest so a list of failures does not
            read as a row of crosses, and named in the tooltip, because on its
            own a cross could as well mean "expand" as "remove".
        -->
        <Style Selector="Button.dismissTest">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dismissTest:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Inputs -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBgColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="ComboBox:item">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>

        <!-- Progress -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Background" Value="{DynamicResource TrackColor}"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <!-- Separator -->
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource CardBorderColor}"/>
        </Style>

        <!--
            How-to steps: a numbered badge next to a line an operator can act on.

            The badge is a round accent dot rather than a "1." in the text, so a
            glance down the card gives the order without reading the sentences.
        -->
        <Style Selector="Border.stepBadge">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style Selector="Border.stepBadge > TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The left margin is the badge column, so every line of text on any
             screen starts at the same distance from its number. -->
        <Style Selector="TextBlock.stepBody">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <!-- The one line of a how-to that people skip and then cannot work out -->
        <Style Selector="TextBlock.stepCaveat">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource WarnColor}"/>
        </Style>
        <!-- Its backing plate. The view used to spell out its own translucent
             amber here, which is the same drift the card above it was measured
             against: a colour no other screen knows about. -->
        <Style Selector="Border.stepCaveatBox">
            <Setter Property="Background" Value="{DynamicResource WarnTintBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!--
            A plan: a title, then numbered rows an operator follows from top to
            bottom. The USB debugging how-to and the IMEI key setup are one
            shape and used to be drawn two ways, badges in one and the words
            "Step 1:" spelled out in the other. Both take these four classes
            now, so the next screen with steps to give gets them instead of a
            design of its own.

            The frame is only a hairline, because it has to read as a block on
            the card behind it in one screen and on a settings card in the
            other, and a fill would match one of them.

            The rail is the line the numbers stand on: one hairline down the
            badge column with the badge sitting on it, so the eye is carried
            from one step to the next. It is pulled through the row's padding by
            a negative margin, which is why that margin has to stay the mirror
            of the padding on stepItem.
        -->
        <Style Selector="Border.stepPlan">
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style Selector="TextBlock.stepPlanTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="Border.stepItem">
            <Setter Property="Padding" Value="0,6"/>
        </Style>
        <Style Selector="Border.stepRail">
            <Setter Property="Width" Value="2"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,-6,0,-6"/>
        </Style>

        <!-- Data validation errors must never disappear -->
        <Style Selector="DataValidationErrors &gt; TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
        </Style>

        <!-- ============ Application header ============ -->
        <Style Selector="Border.topBar">
            <Setter Property="Background" Value="{DynamicResource CardColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>
        <Style Selector="TextBlock.brand">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
            A header action. It reads as a piece of text, answers as a button, and
            is padded so that a longer label cannot stretch the column it sits in.
        -->
        <Style Selector="Button.headerBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.headerBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource TrackColor}"/>
        </Style>
        <!-- The header button that is currently open stays lit, so the state of
             the page behind it is readable from the bar itself. -->
        <Style Selector="Button.headerBtn.on">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
        </Style>
        <Style Selector="Button.headerBtn.on Path.glyph">
            <Setter Property="Fill" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="Path.glyph">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Settings: sections and the rows inside them ============ -->
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
        </Style>
        <!--
            The name of a setting, on the left of its row. Full brightness because it
            is what the operator is looking for, and the sentence under it is dim
            because it is what they read afterwards.

            Every settings row used to spell this role out as a raw
            FontWeight="SemiBold" with no size, so it sat at the inherited thirteen
            while the sentence under it sat at twelve, and sixteen of them all
            carried a slightly different idea of what a row heading looks like.
        -->
        <Style Selector="TextBlock.settingTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.settingDesc">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
        <Style Selector="Button.navItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.navItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource TrackColor}"/>
        </Style>
        <Style Selector="Button.navItem.current">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="Button.navItem.current:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
        </Style>
        <Style Selector="Border.settingCard">
            <Setter Property="Background" Value="{DynamicResource CardDeepColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <!--
            A group of switches that answer one question.

            Each switch used to be a card of its own, so a section of nine settings
            was a column of nine boxes with nine thin gaps between them, which reads
            as nine separate decisions rather than as the two or three questions
            they actually are. A group is one card, its own heading above the
            switches it holds, and the switches inside it are lines rather than
            boxes.
        -->
        <Style Selector="Border.settingGroup">
            <Setter Property="Background" Value="{DynamicResource CardDeepColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style Selector="TextBlock.groupTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!--
            A switch and the sentence under it, as one unit.

            The sentence is indented by the width of the box plus its gap. That
            margin was written out at 26 pixels on every row, and one row had it at
            a different value, which put one description a few pixels out of line
            with the eleven above it.
        -->
        <Style Selector="CheckBox.settingSwitch">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="TextBlock.switchNote">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimColor}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="26,2,0,0"/>
        </Style>
        <Style Selector="TextBlock.switchNote.last">
            <Setter Property="Margin" Value="26,2,0,0"/>
        </Style>
        <Style Selector="Border.actionBar">
            <Setter Property="Background" Value="{DynamicResource CardColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="20,14"/>
        </Style>

        <!-- ============ Report rows: a tint, never a solid block of colour ============ -->
        <Style Selector="Border.reportRow">
            <Setter Property="Background" Value="{DynamicResource CardDeepColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Border.reportRow.bad">
            <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerColor}"/>
        </Style>
        <Style Selector="Border.reportRow.warn">
            <Setter Property="Background" Value="{DynamicResource WarnTintBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarnColor}"/>
        </Style>
        <Style Selector="Border.reportRow.ok">
            <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}"/>
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.chip &gt; TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Border.chip.bad">
            <Setter Property="Background" Value="{DynamicResource DangerColor}"/>
        </Style>
        <Style Selector="Border.chip.ok">
            <Setter Property="Background" Value="{DynamicResource SuccessColor}"/>
        </Style>
        <Style Selector="Border.chip.warn">
            <Setter Property="Background" Value="{DynamicResource WarnColor}"/>
        </Style>
        <!--
            The export panel.

            Three pieces that no other screen needed: a sheet of paper the label is
            drawn on, a row that can be ticked, and a stock picker.

            The sheet is white in both themes on purpose. It is a photograph of a
            label, and a label does not come out dark because the operator has a
            dark theme; a preview that changed colour with the theme would be
            showing the theme, not the label.
        -->
        <Style Selector="Border.labelSheet">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#C8CCD4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- A label on a dark screen needs an edge to be found by. Without the
                 hairline the white sheet floats in the middle of the card. -->
            <Setter Property="BoxShadow" Value="0 4 14 0 #40000000"/>
        </Style>
        <Style Selector="TextBlock.labelSheetText">
            <Setter Property="Foreground" Value="#101014"/>
        </Style>
        <Style Selector="TextBlock.labelSheetBarcode">
            <Setter Property="Foreground" Value="#5A5E68"/>
        </Style>

        <!--
            The preview column on the export panel. Named so the code behind the
            panel can find it and measure it: only a laid out panel knows how much
            room the label sheet has, and that is what decides whether the sheet is
            drawn at its real size or scaled down to fit.
        -->
        <Style Selector="Border.previewColumn">
            <Setter Property="MaxWidth" Value="324"/>
        </Style>

        <!--
            A format in the checklist: a tickbox, a name, and what it is for. A
            ToggleButton rather than a Border so the row is its own hit target and
            the tick is the row's state rather than a copy of it.
        -->
        <Style Selector="ToggleButton.formatRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.formatRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource TrackColor}"/>
        </Style>
        <!-- Lit only while the format is ticked, so the list of what will be
             written is legible before anything is pressed. -->
        <Style Selector="ToggleButton.formatRow.on">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="ToggleButton.formatRow.on:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
        </Style>
        <!-- The theme's own toggle chrome would draw a box and a bullet in the
             corner of every row; the tickbox inside the template is the state. -->
        <Style Selector="ToggleButton.formatRow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextColor}"/>
        </Style>

        <Style Selector="TextBlock.emptyNote">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ============ Logbook viewer: rows that paint themselves, containers that do not ============ -->
        <!--
            The log list is a ListBox so that its panel virtualizes, but it is a
            viewer: there is nothing to point at, pick or press. The ListBox and
            its ListBoxItem containers arrive with theme chrome of their own -
            a filled background, a border, 12,9 padding per row, a hover fill, a
            pressed fill and a selection fill - all of which would sit behind or
            beside the row card the template already draws. These rules take that
            chrome off; the row template keeps its own card background, spacing
            and colours, exactly as it had inside the ItemsControl it replaced.
            Note on selection: Avalonia's SelectionMode is a flags enum whose
            zero value is Single, so there is no SelectionMode="None" to ask for;
            the tint rules below are what keep a click or a hover invisible.
        -->
        <Style Selector="ListBox.logList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.logList ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <!-- The three states in the item theme that paint the presenter behind the row. -->
        <Style Selector="ListBox.logList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.logList ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.logList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Application.Styles>
</Application>
